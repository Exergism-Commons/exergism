    <relatedTo rdf:resource="https://id.exergism.org/exergism#vida"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <field_cambio_biologico xml:lang="es">Adaptacion, evolucion, nacimiento, muerte y reorganizacion de los seres vivos.</field_cambio_biologico>
    <field_cambio_espiritual xml:lang="es">Apertura de nuevas capas de comprension, conciencia y orientacion hacia la verdad.</field_cambio_espiritual>
    <field_cambio_fisico xml:lang="es">Transformacion de estados materiales y energeticos segun las reglas del universo.</field_cambio_fisico>
    <field_cambio_historico xml:lang="es">Transformacion de instituciones, valores, relaciones de poder y formas de organizacion social.</field_cambio_historico>
    <field_cambio_politico xml:lang="es">Alteracion de las estructuras de poder, dominacion y acceso a la libertad dentro de una sociedad.</field_cambio_politico>
