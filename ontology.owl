  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#motivo_del_escape_del_demiurgo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Motivo del escape del demiurgo</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#exergia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia_relacion_con_el_demiurgo_y_la_liberacion_motivo_del_escape_del_demiurgo_tesis_central"/>
    <hasThesis rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia_relacion_con_el_demiurgo_y_la_liberacion_motivo_del_escape_del_demiurgo_tesis_central"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#relacion_con_el_demiurgo_y_la_liberacion"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#exergia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#demiurgo"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#verdad_absoluta"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#autonomia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#vida"/>
    <field_criterio xml:lang="es">Una fuga real del demiurgo no consiste solo en destruir su orden, sino en impedir que la potencia liberada vuelva a ser capturada por una nueva forma del ciclo.</field_criterio>
    <field_definicion xml:lang="es">Escapar del demiurgo significa recuperar la exergia capturada por estructuras de dominacion para reorientarla hacia la verdad absoluta, la autonomia y la liberacion colectiva.</field_definicion>
    <field_dimension_colectiva xml:lang="es">Reconstruir instituciones, relaciones y formas de vida que no consuman la exergia social en repeticion, captura y servidumbre.</field_dimension_colectiva>
    <field_dimension_individual xml:lang="es">Recuperar autonomia, conciencia y capacidad de no servir al miedo, al apego y a la dominacion.</field_dimension_individual>
    <hasDefinition xml:lang="es">Escapar del demiurgo significa recuperar la exergia capturada por estructuras de dominacion para reorientarla hacia la verdad absoluta, la autonomia y la liberacion colectiva.</hasDefinition>
    <hasName xml:lang="es">Motivo del escape del demiurgo</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.relacion_con_el_demiurgo_y_la_liberacion.motivo_del_escape_del_demiurgo</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">motivo_del_escape_del_demiurgo</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#muerte">
