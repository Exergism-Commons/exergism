  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#relacion_con_los_sistemas_politicos_existentes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Relacion con los sistemas politicos existentes</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#filosofia_politica_relacion_con_los_sistemas_politicos_existentes_motivos_de_hostilidad_collection"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#filosofia_politica_relacion_con_los_sistemas_politicos_existentes_tesis_central"/>
    <hasThesis rdf:resource="https://id.exergism.org/exergism#filosofia_politica_relacion_con_los_sistemas_politicos_existentes_tesis_central"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <field_definicion xml:lang="es">El exergismo tiende a entrar en conflicto con la mayor parte de los sistemas politicos realmente existentes, no solo por desacuerdo moral abstracto, sino porque cuestiona las bases estructurales de su reproduccion.</field_definicion>
    <field_matiz xml:lang="es">La hostilidad depende del grado real en que reproduce captura, dominacion y opacidad.</field_matiz>
    <hasDefinition xml:lang="es">El exergismo tiende a entrar en conflicto con la mayor parte de los sistemas politicos realmente existentes, no solo por desacuerdo moral abstracto, sino porque cuestiona las bases estructurales de su reproduccion.</hasDefinition>
    <hasName xml:lang="es">Relacion con los sistemas politicos existentes</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.relacion_con_los_sistemas_politicos_existentes</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relacion_con_los_sistemas_politicos_existentes</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#relacion_con_otras_inteligencias">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Relacion con otras inteligencias</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#soteriologia_o_teoria_de_la_liberacion"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#liberacion"/>
