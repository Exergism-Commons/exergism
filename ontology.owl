  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#gnosticismo_antropologico">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Gnosticismo antropologico</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#antropologia_filosofica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#ser_humano"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#antropologia_filosofica"/>
    <develops rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <develops rdf:resource="https://id.exergism.org/exergism#ser_humano"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#antropologia_filosofica_gnosticismo_antropologico_demiurgo"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#antropologia_filosofica_gnosticismo_antropologico_carcel_del_mundo"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#antropologia_filosofica_gnosticismo_antropologico_demiurgo"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#antropologia_filosofica_gnosticismo_antropologico_carcel_del_mundo"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#ser_humano"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#ser_humano"/>
    <field_nota_de_alcance xml:lang="es">El demiurgo y la carcel del mundo se desarrollan primariamente a partir del caso humano, porque es el unico accesible con suficiente profundidad historica, psicologica y politica. Sin embargo, el sistema deja abierta la posibilidad de que estructuras analogas emerjan en otras conciencias complejas o colectividades no humanas si estas desarrollan formas comparables de poder, captura y clausura.</field_nota_de_alcance>
    <hasName xml:lang="es">Gnosticismo antropologico</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antropologia_filosofica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antropologia_filosofica.gnosticismo_antropologico</hasSourcePath>
