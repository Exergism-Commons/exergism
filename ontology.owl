  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#sistema_filosofico">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Domain"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#System"/>
