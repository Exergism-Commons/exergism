    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <field_definicion xml:lang="es">La oracion no es peticion a un dios personal que interviene arbitrariamente, sino ejercicio de concentracion, orientacion interior, recuerdo de la verdad y reordenacion de la conciencia.</field_definicion>
    <field_estado_de_desarrollo xml:lang="es">ampliado</field_estado_de_desarrollo>
    <hasDefinition xml:lang="es">La oracion no es peticion a un dios personal que interviene arbitrariamente, sino ejercicio de concentracion, orientacion interior, recuerdo de la verdad y reordenacion de la conciencia.</hasDefinition>
    <hasName xml:lang="es">Oracion</hasName>
