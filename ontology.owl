  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#rol_de_la_sociedad">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Rol de la sociedad</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#soteriologia_o_teoria_de_la_liberacion"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#liberacion"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#soteriologia_o_teoria_de_la_liberacion"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#liberacion"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#liberacion"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#exergia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#ser_humano"/>
    <field_definicion xml:lang="es">Una sociedad puede trascender si profundiza en conocimiento verdadero de la naturaleza humana y de sus estructuras, aumenta su exergia colectiva y reduce las formas de captura que impiden una orientacion historica compartida hacia la verdad.</field_definicion>
    <field_horizonte_ampliado xml:lang="es">En su forma mas desarrollada, una sociedad liberada puede convertirse en parte del proceso de constitucion de una humanidad cosmica.</field_horizonte_ampliado>
    <hasDefinition xml:lang="es">Una sociedad puede trascender si profundiza en conocimiento verdadero de la naturaleza humana y de sus estructuras, aumenta su exergia colectiva y reduce las formas de captura que impiden una orientacion historica compartida hacia la verdad.</hasDefinition>
    <hasName xml:lang="es">Rol de la sociedad</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soteriologia_o_teoria_de_la_liberacion.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soteriologia_o_teoria_de_la_liberacion.rol_de_la_sociedad</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rol_de_la_sociedad</jsonKey>
  </owl:NamedIndividual>

