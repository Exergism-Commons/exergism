    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales[14]</hasSourcePath>
    <hasText xml:lang="es">No todo cambio es exergico; solo lo es aquel que aumenta margen real de reorganizacion y liberacion.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales</jsonKey>
    <orderIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</orderIndex>
  </owl:NamedIndividual>

