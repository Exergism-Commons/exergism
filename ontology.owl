  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#servidumbre">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Servidumbre</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#opresion"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <develops rdf:resource="https://id.exergism.org/exergism#opresion"/>
    <develops rdf:resource="https://id.exergism.org/exergism#autonomia"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#filosofia_politica_opresion_mecanismos_servidumbre_formas_collection"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#filosofia_politica_opresion_mecanismos_servidumbre_efectos_collection"/>
    <hasSubtype rdf:resource="https://id.exergism.org/exergism#mechanism"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#filosofia_politica_opresion_mecanismos"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#opresion"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#materia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#vida"/>
    <field_criterio_de_juicio xml:lang="es">Debe juzgarse por el grado en que clausura la capacidad efectiva de una conciencia o un colectivo para decidir y reorganizar su vida sin tutela dominante.</field_criterio_de_juicio>
    <field_definicion xml:lang="es">Mecanismo de opresion por el cual una persona o colectivo queda atrapado en relaciones de dependencia material, institucional, afectiva o simbolica que restringen gravemente su capacidad de autogobierno.</field_definicion>
    <field_estado_ontologico xml:lang="es">mecanismo estructural de subordinacion dentro del dominio humano</field_estado_ontologico>
    <field_funcion_opresiva xml:lang="es">Convertir la dependencia en condicion estable de obediencia y reproducir asimetrias de poder duraderas.</field_funcion_opresiva>
    <field_relacion_con_la_opresion xml:lang="es">La servidumbre cristaliza la opresion en relaciones duraderas de dependencia que hacen costosa o casi imposible la autonomia real.</field_relacion_con_la_opresion>
    <hasDefinition xml:lang="es">Mecanismo de opresion por el cual una persona o colectivo queda atrapado en relaciones de dependencia material, institucional, afectiva o simbolica que restringen gravemente su capacidad de autogobierno.</hasDefinition>
    <hasName xml:lang="es">Servidumbre</hasName>
    <hasOntologicalStatus xml:lang="es">mecanismo estructural de subordinacion dentro del dominio humano</hasOntologicalStatus>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.opresion.mecanismos.servidumbre</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">servidumbre</jsonKey>
  </owl:NamedIndividual>

