  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#horizonte_metafisico">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Horizonte metafisico</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#ontologia"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#vida"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#ontologia"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#vida"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#vida"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#materia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#universo"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <field_alcance xml:lang="es">Esta hipotesis no afirma que el universo conocido sea ya un ser vivo en sentido fuerte, sino que la vida podria ser uno de los procesos mediante los cuales el universo avanza hacia formas mas amplias de integracion de materia, conciencia, memoria y organizacion.</field_alcance>
    <field_estado_teorico xml:lang="es">hipotesis metafisica abierta</field_estado_teorico>
    <field_hipotesis_del_supraser_universal xml:lang="es">Si la vida es una configuracion emergente de la materia capaz de producir niveles crecientes de integracion, composicion y complejidad, entonces puede plantearse la hipotesis de que su despliegue no tenga como limite necesario el nivel planetario o transplanetal, sino una posible convergencia hacia el universo mismo como composicion ultima de supraser.</field_hipotesis_del_supraser_universal>
    <field_relacion_con_la_conciencia xml:lang="es">Si la conciencia es una forma parcial por la que el universo se observa a si mismo, la vida compleja podria ser tambien una via parcial por la que el universo se organiza progresivamente en niveles superiores de unidad emergente.</field_relacion_con_la_conciencia>
    <hasName xml:lang="es">Horizonte metafisico</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia.estructura_de_lo_real.niveles_emergentes.vida.horizonte_metafisico</hasSourcePath>
    <hasTheoreticalStatus xml:lang="es">hipotesis metafisica abierta</hasTheoreticalStatus>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">horizonte_metafisico</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#humanidad_cosmica">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Humanidad cosmica</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#soteriologia_o_teoria_de_la_liberacion"/>
