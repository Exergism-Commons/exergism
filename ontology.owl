    <hasPart rdf:resource="https://id.exergism.org/exergism#metodo_filosofico_relacion_con_la_ciencia_funcion_collection"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#metodo_filosofico"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#metodo_filosofico"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#realidad"/>
    <field_definicion xml:lang="es">La ciencia es fuente privilegiada de conocimiento parcial sobre los mecanismos observables del mundo. El metodo filosofico debe integrarla siempre que sea pertinente, sin reducir toda la realidad a cientificismo ni negar evidencia empirica por fidelidad doctrinal.</field_definicion>
    <hasDefinition xml:lang="es">La ciencia es fuente privilegiada de conocimiento parcial sobre los mecanismos observables del mundo. El metodo filosofico debe integrarla siempre que sea pertinente, sin reducir toda la realidad a cientificismo ni negar evidencia empirica por fidelidad doctrinal.</hasDefinition>
    <hasName xml:lang="es">Relacion con la ciencia</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metodo_filosofico.json</hasSourceFile>
