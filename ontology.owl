    <field_definicion xml:lang="es">Clarificacion conceptual, distincion de niveles, definicion de terminos y eliminacion de contradicciones innecesarias.</field_definicion>
    <hasDefinition xml:lang="es">Clarificacion conceptual, distincion de niveles, definicion de terminos y eliminacion de contradicciones innecesarias.</hasDefinition>
    <hasName xml:lang="es">Analitica</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metodo_filosofico.json</hasSourceFile>
