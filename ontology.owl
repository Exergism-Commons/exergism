  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#relacion_con_el_bien_y_el_mal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Relacion con el bien y el mal</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#poder"/>
