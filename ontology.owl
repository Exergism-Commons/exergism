    <relatedTo rdf:resource="https://id.exergism.org/exergism#psicologia_moral"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <field_definicion xml:lang="es">Proceso psiquico, moral y social por el cual otro ser, sujeto o conciencia deja de ser tratado como centro de experiencia y valor propio, y pasa a ser usado como medio, recurso, obstaculo o soporte funcional para fines ajenos.</field_definicion>
    <field_funcion_opresiva xml:lang="es">Facilita daño, explotacion, manipulacion y reproduccion del ciclo al debilitar el reconocimiento reciproco y convertir al otro en objeto gestionable.</field_funcion_opresiva>
    <hasDefinition xml:lang="es">Proceso psiquico, moral y social por el cual otro ser, sujeto o conciencia deja de ser tratado como centro de experiencia y valor propio, y pasa a ser usado como medio, recurso, obstaculo o soporte funcional para fines ajenos.</hasDefinition>
    <hasName xml:lang="es">Instrumentalizacion</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">psicologia_moral.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">psicologia_moral.instrumentalizacion</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">instrumentalizacion</jsonKey>
  </owl:NamedIndividual>

