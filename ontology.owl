  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#fuentes_del_conocimiento">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Fuentes del conocimiento</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#epistemologia"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#epistemologia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#epistemologia"/>
    <develops rdf:resource="https://id.exergism.org/exergism#vida"/>
    <develops rdf:resource="https://id.exergism.org/exergism#universo"/>
    <develops rdf:resource="https://id.exergism.org/exergism#verdad_absoluta"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#epistemologia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#epistemologia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#realidad"/>
    <field_analisis_social xml:lang="es">presente</field_analisis_social>
    <field_ciencia xml:lang="es">Fuente privilegiada de conocimiento parcial sobre los mecanismos observables del universo. No agota la verdad absoluta, pero permite reducir error y ampliar comprension objetiva del mundo fisico, biologico y social.</field_ciencia>
    <field_creacion xml:lang="es">presente</field_creacion>
    <field_experiencia_interior xml:lang="es">presente</field_experiencia_interior>
    <field_meditacion xml:lang="es">presente</field_meditacion>
    <field_revelacion xml:lang="es">Fuente posible de intuiciones o simbolos orientados a la verdad, pero no valida por si sola sin examen critico, coherencia y contraste con experiencia y realidad.</field_revelacion>
    <field_tradicion xml:lang="es">Deposito historico de conocimiento, simbolos y practicas que puede conservar aperturas valiosas o reproducir formas del ciclo segun como se interprete.</field_tradicion>
    <hasName xml:lang="es">Fuentes del conocimiento</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">epistemologia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">epistemologia.fuentes_del_conocimiento</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fuentes_del_conocimiento</jsonKey>
  </owl:NamedIndividual>

