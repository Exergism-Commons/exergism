  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#ego">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Ego</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#antropologia_filosofica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#procesos_secundarios_conscientes"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#antropologia_filosofica"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#procesos_secundarios_conscientes"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#procesos_secundarios_conscientes"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <field_defensa xml:lang="es">El ego funciona frecuentemente como mecanismo de defensa frente a la ignorancia, la inseguridad, el miedo y la amenaza a la propia identidad.</field_defensa>
    <field_definicion xml:lang="es">Estructura de autoidentificacion que organiza la experiencia individual y permite orientacion practica, pero que puede absolutizarse y convertirse en foco de apego, miedo y dominacion.</field_definicion>
    <field_riesgo xml:lang="es">Cuando se rigidiza, el ego refuerza la separacion, la defensa del poder y la reproduccion del ciclo.</field_riesgo>
    <hasDefinition xml:lang="es">Estructura de autoidentificacion que organiza la experiencia individual y permite orientacion practica, pero que puede absolutizarse y convertirse en foco de apego, miedo y dominacion.</hasDefinition>
    <hasName xml:lang="es">Ego</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antropologia_filosofica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antropologia_filosofica.procesos_secundarios_conscientes.ego</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ego</jsonKey>
  </owl:NamedIndividual>

