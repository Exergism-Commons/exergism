  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#guia_intercivilizatoria">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Guia intercivilizatoria</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#teoria_de_la_historia"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#escatologia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#teoria_de_la_historia"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#escatologia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#escatologia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#exergia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#autonomia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#verdad_absoluta"/>
    <field_criterio_de_legitimidad xml:lang="es">Ninguna civilizacion puede presentarse como poseedora total de la verdad absoluta. Toda ayuda o guia debe ofrecerse como cooperacion parcial y revisable.</field_criterio_de_legitimidad>
    <field_definicion xml:lang="es">Solo seria legitimo intentar orientar a otras civilizaciones si ello fuera compatible con su autonomia, si no implicara subordinacion y si pudiera aumentar verdad, libertad y exergia sin captura.</field_definicion>
    <hasDefinition xml:lang="es">Solo seria legitimo intentar orientar a otras civilizaciones si ello fuera compatible con su autonomia, si no implicara subordinacion y si pudiera aumentar verdad, libertad y exergia sin captura.</hasDefinition>
    <hasName xml:lang="es">Guia intercivilizatoria</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_historia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_historia.escatologia.guia_intercivilizatoria</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">guia_intercivilizatoria</jsonKey>
  </owl:NamedIndividual>

