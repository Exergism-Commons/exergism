    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#soteriologia_o_teoria_de_la_liberacion"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#ser_humano"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#exergia"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#soteriologia_o_teoria_de_la_liberacion_humanidad_cosmica_condiciones_de_posibilidad_collection"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#liberacion"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#liberacion"/>
    <field_definicion xml:lang="es">Etapa superior de la liberacion historica en la que la humanidad, habiendo alcanzado suficiente cohesion exergica y reduccion de divisiones ficticias, puede orientarse a la exploracion del cosmos, al encuentro con otras inteligencias y a la ampliacion de su horizonte de verdad.</field_definicion>
    <hasDefinition xml:lang="es">Etapa superior de la liberacion historica en la que la humanidad, habiendo alcanzado suficiente cohesion exergica y reduccion de divisiones ficticias, puede orientarse a la exploracion del cosmos, al encuentro con otras inteligencias y a la ampliacion de su horizonte de verdad.</hasDefinition>
    <hasName xml:lang="es">Humanidad cosmica</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soteriologia_o_teoria_de_la_liberacion.json</hasSourceFile>
