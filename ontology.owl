    <relatedTo rdf:resource="https://id.exergism.org/exergism#realidad"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#espiritu"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#espiritu_humano"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#verdad_absoluta"/>
    <field_descripcion_general xml:lang="es">Sistema filosofico que entiende la realidad como un sistema emergente y el mundo humano como una estructura de verdad parcial, alienacion, poder y posibilidad de trascendencia. La verdad absoluta es inalcanzable, pero orienta el espiritu humano. El mal y el bien no son absolutos cosmicos, pero si categorias objetivas dentro del dominio humano.</field_descripcion_general>
    <field_estado_de_desarrollo xml:lang="es">parcial</field_estado_de_desarrollo>
    <field_nombre_completo xml:lang="es">Metafisica emergentista de la liberacion</field_nombre_completo>
    <field_nombre_doctrinal xml:lang="es">Exergismo</field_nombre_doctrinal>
    <hasDescription xml:lang="es">Sistema filosofico que entiende la realidad como un sistema emergente y el mundo humano como una estructura de verdad parcial, alienacion, poder y posibilidad de trascendencia. La verdad absoluta es inalcanzable, pero orienta el espiritu humano. El mal y el bien no son absolutos cosmicos, pero si categorias objetivas dentro del dominio humano.</hasDescription>
    <hasName xml:lang="es">Sistema filosofico</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sistema_filosofico.json</hasSourceFile>
