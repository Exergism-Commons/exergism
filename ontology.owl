    <field_definicion xml:lang="es">Proceso por el cual una conciencia organiza perceptivamente un hecho, le atribuye sentido, identifica agentes, evalua daño, juzga intenciones y decide si corresponde castigo, comprension, contencion, reparacion o transformacion.</field_definicion>
    <hasDefinition xml:lang="es">Proceso por el cual una conciencia organiza perceptivamente un hecho, le atribuye sentido, identifica agentes, evalua daño, juzga intenciones y decide si corresponde castigo, comprension, contencion, reparacion o transformacion.</hasDefinition>
    <hasName xml:lang="es">Interpretacion moral</hasName>
