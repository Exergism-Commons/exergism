    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#exergia"/>
    <field_criterio_de_juicio xml:lang="es">La exergia no debe medirse solo por intensidad o violencia, sino por capacidad real de abrir transformaciones sostenibles, conscientes y no capturadas por el ciclo.</field_criterio_de_juicio>
    <hasName xml:lang="es">Criterios y riesgos</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.json</hasSourceFile>
