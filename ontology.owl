    <partOf rdf:resource="https://id.exergism.org/exergism#espiritu"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <field_espiritu_civilizatorio xml:lang="es">Forma historica amplia en la que una civilizacion desarrolla acumulacion reflexiva, orientacion epistemica y capacidad de reorganizacion de gran escala.</field_espiritu_civilizatorio>
    <field_espiritu_colectivo xml:lang="es">Forma en la que varias conciencias generan memoria, conocimiento, simbolos y direccion compartida.</field_espiritu_colectivo>
    <field_espiritu_individual xml:lang="es">Forma limitada en la que una conciencia singular acumula orientacion, experiencia y apertura hacia la verdad.</field_espiritu_individual>
    <field_espiritus_no_humanos_posibles xml:lang="es">Posibles formas de espiritu en conciencias no humanas o extraterrestres si estas desarrollan memoria historica, simbolizacion, acumulacion de conocimiento y orientacion hacia capas de realidad.</field_espiritus_no_humanos_posibles>
    <hasName xml:lang="es">Formas posibles</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia.estructura_de_lo_real.niveles_emergentes.espiritu.formas_posibles</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">formas_posibles</jsonKey>
  </owl:NamedIndividual>

