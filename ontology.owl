  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#dinamica_de_toma_de_decisiones">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Dinamica de toma de decisiones</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#institucion_no_demiurgica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#filosofia_politica_instituciones_institucion_no_demiurgica_dinamica_de_toma_de_decisiones_fases_collection"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#institucion_no_demiurgica"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#institucion_no_demiurgica"/>
    <field_criterio xml:lang="es">La institucion no debe decidir primero y justificar despues, sino revisar primero, abrir despues, refinar despues y decidir solo tras haber recorrido un proceso suficientemente publico y contrastado.</field_criterio>
    <field_definicion xml:lang="es">El centro de una institucion liberadora no debe ser la imposicion vertical de lineas ya cerradas, sino el procesamiento colectivo, iterativo y criticable de propuestas.</field_definicion>
    <field_objetivo xml:lang="es">Alcanzar resultados suficientemente heterogeneos, criticados y refinados como para que la decision final exprese inteligencia colectiva mas que captura de una minoria directiva.</field_objetivo>
    <hasDefinition xml:lang="es">El centro de una institucion liberadora no debe ser la imposicion vertical de lineas ya cerradas, sino el procesamiento colectivo, iterativo y criticable de propuestas.</hasDefinition>
    <hasName xml:lang="es">Dinamica de toma de decisiones</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.instituciones.institucion_no_demiurgica.dinamica_de_toma_de_decisiones</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dinamica_de_toma_de_decisiones</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#dinamica_interna">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Dinamica interna</rdfs:label>
