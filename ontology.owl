    <relatedTo rdf:resource="https://id.exergism.org/exergism#exergia"/>
    <field_funcion_de_la_exergia xml:lang="es">Detectar y ampliar margenes efectivos de ruptura, reorganizacion y apertura historica dentro de contextos tragicos o inestables.</field_funcion_de_la_exergia>
    <field_riesgo xml:lang="es">Acelerar procesos destructivos sin producir exergia social o consciente solo multiplica sufrimiento y facilita nuevas dominaciones.</field_riesgo>
