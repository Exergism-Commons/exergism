    <partOf rdf:resource="https://id.exergism.org/exergism#liberacion"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#liberacion"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#verdad_absoluta"/>
    <field_definicion xml:lang="es">Movimiento de apertura progresiva hacia la verdad absoluta sabiendo que nunca se llega del todo.</field_definicion>
    <hasDefinition xml:lang="es">Movimiento de apertura progresiva hacia la verdad absoluta sabiendo que nunca se llega del todo.</hasDefinition>
    <hasName xml:lang="es">Trascendencia</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soteriologia_o_teoria_de_la_liberacion.json</hasSourceFile>
