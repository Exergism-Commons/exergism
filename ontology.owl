  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#criterios_y_riesgos_de_la_exergia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Section"/>
    <rdfs:label xml:lang="es">Criterios y riesgos</rdfs:label>
