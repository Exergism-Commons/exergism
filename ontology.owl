    <hasConcept rdf:resource="https://id.exergism.org/exergism#advertencia_sobre_las_emociones"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#epistemologia_discernimiento_de_orientacion_hacia_la_verdad_relacion_con_la_verdad_absoluta"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#busqueda_de_la_verdad"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#filtros_de_discernimiento"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#advertencia_sobre_las_emociones"/>
