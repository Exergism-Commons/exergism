  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#potencia_capturada">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Potencia capturada</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#lectura_negativa_del_exergismo"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia_lectura_negativa_del_exergismo_potencia_capturada_distincion_clave"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia_lectura_negativa_del_exergismo_potencia_capturada_formas_collection"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#lectura_negativa_del_exergismo"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#lectura_negativa_del_exergismo"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#exergia"/>
    <field_criterio xml:lang="es">Cuanto mayor es la potencia capturada por una estructura, menor es la exergia real disponible para una reorganizacion liberadora.</field_criterio>
    <field_definicion xml:lang="es">Parte de la potencia transformadora potencial de sujetos, colectividades, instituciones o epocas que deja de estar disponible para la liberacion porque es absorbida, desviada, degradada o reconvertida por el ciclo demiurgico.</field_definicion>
    <field_funcion_en_la_lectura_negativa xml:lang="es">La lectura negativa del exergismo no busca aumentar exergia liberadora, sino maximizar potencia capturada y convertirla en capacidad estable de reproduccion del orden opresivo.</field_funcion_en_la_lectura_negativa>
    <hasDefinition xml:lang="es">Parte de la potencia transformadora potencial de sujetos, colectividades, instituciones o epocas que deja de estar disponible para la liberacion porque es absorbida, desviada, degradada o reconvertida por el ciclo demiurgico.</hasDefinition>
    <hasName xml:lang="es">Potencia capturada</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.lectura_negativa_del_exergismo.potencia_capturada</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">potencia_capturada</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#potestas">
