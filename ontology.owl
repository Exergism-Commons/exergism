    <partOf rdf:resource="https://id.exergism.org/exergism#etica"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#etica"/>
    <field_clasificacion_basica xml:lang="es">mal necesario y tragico</field_clasificacion_basica>
    <field_definicion xml:lang="es">Hay situaciones en las que puede infligirse un daño grave para impedir una captura o una dominacion mayor, pero ese daño no queda moralmente purificado por su necesidad.</field_definicion>
    <hasDefinition xml:lang="es">Hay situaciones en las que puede infligirse un daño grave para impedir una captura o una dominacion mayor, pero ese daño no queda moralmente purificado por su necesidad.</hasDefinition>
    <hasName xml:lang="es">Daño tragico y residuo moral</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">etica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">etica.dano_tragico_y_residuo_moral</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dano_tragico_y_residuo_moral</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#defensa_y_resistencia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Defensa y resistencia</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#modelo_de_sociedad_liberada"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#filosofia_politica_modelo_de_sociedad_liberada_rasgos_estructurales_defensa_y_resistencia_principios_collection"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#filosofia_politica_modelo_de_sociedad_liberada_rasgos_estructurales"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#modelo_de_sociedad_liberada"/>
    <field_definicion xml:lang="es">La sociedad liberada debe estar preparada para defenderse frente a intentos de recaptura, infiltracion, sabotaje o agresion, pero sin autonomizar la logica militar.</field_definicion>
    <hasDefinition xml:lang="es">La sociedad liberada debe estar preparada para defenderse frente a intentos de recaptura, infiltracion, sabotaje o agresion, pero sin autonomizar la logica militar.</hasDefinition>
    <hasName xml:lang="es">Defensa y resistencia</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
