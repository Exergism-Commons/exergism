    <relatedTo rdf:resource="https://id.exergism.org/exergism#autonomia"/>
    <field_crisis_sin_salida xml:lang="es">Puede haber mucho cambio visible pero poca exergia social si la ruptura solo produce caos, agotamiento y nueva captura.</field_crisis_sin_salida>
    <field_ruptura_fecunda xml:lang="es">Puede haber cambio con alta exergia cuando una desestabilizacion abre conocimiento, autonomia material, redistribucion del poder y nuevas trayectorias historicas.</field_ruptura_fecunda>
    <hasName xml:lang="es">Ejemplos</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.integraciones_sistemicas.integracion_con_el_cambio.ejemplos</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ejemplos</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#teoria_de_la_exergia_integraciones_sistemicas_integracion_con_el_escape_del_demiurgo_distincion_clave">
