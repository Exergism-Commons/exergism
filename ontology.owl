  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#plano_cosmologico">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Plano cosmologico</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#teoria_de_la_historia"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#ruptura_final"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#teoria_de_la_historia"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#exergia"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#ruptura_final"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#ruptura_final"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#materia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#universo"/>
    <field_caracter xml:lang="es">natural y practicamente inevitable dentro del universo conocido</field_caracter>
    <field_definicion xml:lang="es">Nuestro universo material, del cual somos parte, tendra un final natural ligado a su propia dinamica fisica. Si la tendencia entropica domina a escala total, la historia cosmologica desembocara en una fase de agotamiento estructural, disipacion extrema y muerte termica.</field_definicion>
    <field_relacion_con_la_exergia xml:lang="es">La muerte termica representa el horizonte limite de destruccion de exergia: el punto en que la capacidad de producir transformacion util tiende a extinguirse a escala cosmica.</field_relacion_con_la_exergia>
    <hasDefinition xml:lang="es">Nuestro universo material, del cual somos parte, tendra un final natural ligado a su propia dinamica fisica. Si la tendencia entropica domina a escala total, la historia cosmologica desembocara en una fase de agotamiento estructural, disipacion extrema y muerte termica.</hasDefinition>
    <hasName xml:lang="es">Plano cosmologico</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_historia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_historia.escatologia.ruptura_final.plano_cosmologico</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">plano_cosmologico</jsonKey>
  </owl:NamedIndividual>

