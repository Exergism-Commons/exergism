    <relatedTo rdf:resource="https://id.exergism.org/exergism#materia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#autonomia"/>
    <field_definicion xml:lang="es">Creacion de condiciones materiales minimas para que individuos y colectivos puedan actuar sin quedar completamente sometidos a dependencia extrema, miedo economico o tutela permanente.</field_definicion>
    <field_funcion_transformadora xml:lang="es">Dar base real a la autonomia politica y simbolica.</field_funcion_transformadora>
    <field_riesgo xml:lang="es">Puede degenerar en administracion paternalista si no va acompañada de autogobierno y distribucion de conocimiento.</field_riesgo>
    <hasDefinition xml:lang="es">Creacion de condiciones materiales minimas para que individuos y colectivos puedan actuar sin quedar completamente sometidos a dependencia extrema, miedo economico o tutela permanente.</hasDefinition>
    <hasName xml:lang="es">Autonomia material compartida</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.cambio_social.mecanismos.autonomia_material_compartida</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">autonomia_material_compartida</jsonKey>
  </owl:NamedIndividual>

