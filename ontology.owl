  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#orden">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Orden</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#ontologia"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#realidad_manifestada"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#ontologia"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#realidad_manifestada"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#realidad_manifestada"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#materia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#entropia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#universo"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#libertad"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#realidad"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#vida"/>
    <field_definicion xml:lang="es">Forma temporal de estabilizacion relativa por la cual una configuracion material, vital, simbolica o social mantiene estructura, coherencia y capacidad de persistir durante un intervalo limitado.</field_definicion>
    <field_estado_ontologico xml:lang="es">configuracion local y transitoria de estabilidad dentro de una realidad abierta al cambio</field_estado_ontologico>
    <field_limite xml:lang="es">El orden no es malo en si mismo, pero se vuelve opresivo cuando se absolutiza, se rigidiza y cancela la apertura necesaria para la transformacion.</field_limite>
    <field_relacion_con_la_entropia xml:lang="es">El orden solo existe como estabilizacion parcial y temporal dentro de un universo entropico que tiende a degradar las configuraciones complejas.</field_relacion_con_la_entropia>
    <field_relacion_con_la_libertad xml:lang="es">El orden fija parcialmente la apertura de la realidad para producir forma, permanencia y coordinacion, pero no debe absolutizarse hasta cancelar la libertad de transformacion.</field_relacion_con_la_libertad>
    <field_relacion_con_la_vida xml:lang="es">La vida constituye una forma localizada de orden capaz de sostener organizacion interna mientras transforma continuamente su entorno.</field_relacion_con_la_vida>
    <hasDefinition xml:lang="es">Forma temporal de estabilizacion relativa por la cual una configuracion material, vital, simbolica o social mantiene estructura, coherencia y capacidad de persistir durante un intervalo limitado.</hasDefinition>
    <hasName xml:lang="es">Orden</hasName>
    <hasOntologicalStatus xml:lang="es">configuracion local y transitoria de estabilidad dentro de una realidad abierta al cambio</hasOntologicalStatus>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia.estructura_de_lo_real.realidad_manifestada.orden</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">orden</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#organizacion_politica">
