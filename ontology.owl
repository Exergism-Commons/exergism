    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antimonopolio_y_desconcentracion</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#antropologia_filosofica_gnosticismo_antropologico_carcel_del_mundo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Carcel del mundo</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#antropologia_filosofica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#gnosticismo_antropologico"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#antropologia_filosofica"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#gnosticismo_antropologico"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#gnosticismo_antropologico"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#ser_humano"/>
    <field_definicion xml:lang="es">Condicion de encierro humano en ciclos de ignorancia, apego, dominacion, sufrimiento y repeticion.</field_definicion>
    <field_mecanismo xml:lang="es">Se perpetua cuando el conocimiento del mundo se usa para dominar en lugar de trascender.</field_mecanismo>
    <field_naturaleza xml:lang="es">humana, historica, social y espiritual</field_naturaleza>
    <hasDefinition xml:lang="es">Condicion de encierro humano en ciclos de ignorancia, apego, dominacion, sufrimiento y repeticion.</hasDefinition>
    <hasName xml:lang="es">Carcel del mundo</hasName>
