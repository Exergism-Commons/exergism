    <relatedTo rdf:resource="https://id.exergism.org/exergism#demiurgo"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#verdad_absoluta"/>
    <field_definicion xml:lang="es">El demiurgo captura, concentra o esteriliza la exergia humana cuando convierte potencia de transformacion en servidumbre, repeticion, dominacion o disipacion improductiva.</field_definicion>
    <field_efecto xml:lang="es">Reduce la capacidad real de una persona o una sociedad para orientarse hacia la verdad absoluta y para reorganizarse fuera del ciclo.</field_efecto>
    <hasDefinition xml:lang="es">El demiurgo captura, concentra o esteriliza la exergia humana cuando convierte potencia de transformacion en servidumbre, repeticion, dominacion o disipacion improductiva.</hasDefinition>
    <hasName xml:lang="es">Relacion con el demiurgo</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.relacion_con_el_demiurgo_y_la_liberacion.relacion_con_el_demiurgo</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relacion_con_el_demiurgo</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#relacion_con_la_autodefensa">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Relacion con la autodefensa</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#etica_de_transicion"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#etica_de_transicion"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#etica_de_transicion"/>
    <field_definicion xml:lang="es">En contextos de transicion, la violencia solo puede tolerarse como proteccion de personas, comunidades, aperturas historicas o condiciones de liberacion frente a captura, agresion o amenaza inminente suficientemente fundada.</field_definicion>
    <field_inevitabilismo_defensivo xml:lang="es">Las acciones anticipatorias solo pueden justificarse bajo criterios estrictos de inevitabilidad defensiva, evaluados de forma plural, trazable y multicriterio.</field_inevitabilismo_defensivo>
    <field_principio xml:lang="es">La defensa es etica y exergicamente superior a la agresion expansiva.</field_principio>
    <hasDefinition xml:lang="es">En contextos de transicion, la violencia solo puede tolerarse como proteccion de personas, comunidades, aperturas historicas o condiciones de liberacion frente a captura, agresion o amenaza inminente suficientemente fundada.</hasDefinition>
    <hasName xml:lang="es">Relacion con la autodefensa</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.etica_de_transicion.relacion_con_la_autodefensa</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relacion_con_la_autodefensa</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#relacion_con_la_ciencia">
