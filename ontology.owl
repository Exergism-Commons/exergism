    <hasThesis rdf:resource="https://id.exergism.org/exergism#epistemologia_discernimiento_de_orientacion_hacia_la_verdad_tesis_central"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#epistemologia"/>
