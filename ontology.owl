  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#mal_metafisico_y_mal_religioso">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Mal metafisico y mal religioso</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#teologia_o_metafisica_religiosa"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#teologia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#teologia_o_metafisica_religiosa"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#teologia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#teologia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#ser_humano"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#verdad_absoluta"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#exergia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#demiurgo"/>
    <field_definicion xml:lang="es">El mal no es una fuerza cosmica absoluta equiparable a la verdad absoluta. En el dominio religioso humano aparece como captura, falseamiento, idolatria del poder, sacralizacion de la dominacion y desviacion de la exergia hacia el ciclo.</field_definicion>
    <field_forma_religiosa_del_demiurgo xml:lang="es">Toda religion que absolutiza obediencia, miedo, pureza identitaria o dominio institucional puede convertirse en forma religiosa del demiurgo.</field_forma_religiosa_del_demiurgo>
    <hasDefinition xml:lang="es">El mal no es una fuerza cosmica absoluta equiparable a la verdad absoluta. En el dominio religioso humano aparece como captura, falseamiento, idolatria del poder, sacralizacion de la dominacion y desviacion de la exergia hacia el ciclo.</hasDefinition>
    <hasName xml:lang="es">Mal metafisico y mal religioso</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teologia_o_metafisica_religiosa.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teologia_o_metafisica_religiosa.mal_metafisico_y_mal_religioso</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mal_metafisico_y_mal_religioso</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#manifestacion_y_revelacion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
