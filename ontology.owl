    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relacion_con_la_ciencia</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#relacion_con_la_espiritualidad">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Relacion con la espiritualidad</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#metodo_filosofico"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#metodo_filosofico"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#metodo_filosofico"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#metodo_filosofico"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#metodo_filosofico"/>
    <field_definicion xml:lang="es">La experiencia espiritual puede abrir intuiciones valiosas, pero debe someterse a examen critico, a contraste con sus efectos y a discernimiento respecto a captura, autoengaño y fantasia compensatoria.</field_definicion>
    <hasDefinition xml:lang="es">La experiencia espiritual puede abrir intuiciones valiosas, pero debe someterse a examen critico, a contraste con sus efectos y a discernimiento respecto a captura, autoengaño y fantasia compensatoria.</hasDefinition>
    <hasName xml:lang="es">Relacion con la espiritualidad</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metodo_filosofico.json</hasSourceFile>
