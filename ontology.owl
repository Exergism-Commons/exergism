  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#definicion_general_exergia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Section"/>
    <rdfs:label xml:lang="es">Definicion general</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#exergia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#universo"/>
    <field_definicion_filosofica xml:lang="es">Capacidad efectiva de una estructura, una conciencia, una institucion o una sociedad para producir transformacion real antes de quedar absorbida por el equilibrio, la disipacion, la rigidez o la captura.</field_definicion_filosofica>
    <field_definicion_fisica xml:lang="es">Cantidad maxima de trabajo util que un sistema puede entregar al alcanzar el equilibrio con su entorno.</field_definicion_fisica>
    <field_funcion_en_el_sistema xml:lang="es">Concepto sintetico que une verdad, libertad, cambio, potencia transformadora y margen real de liberacion dentro de un universo entropico.</field_funcion_en_el_sistema>
    <hasName xml:lang="es">Definicion general</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.definicion_general</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">definicion_general</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#familia_lexica_de_la_exergia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Section"/>
    <rdfs:label xml:lang="es">Familia lexica</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#exergia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#exergia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#verdad_absoluta"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#autonomia"/>
    <field_adjetivo xml:lang="es">exergico</field_adjetivo>
    <field_definicion_de_lo_exergico xml:lang="es">Aquello que conserva, libera, concentra o dirige potencia transformadora util hacia verdad, autonomia y ruptura del ciclo.</field_definicion_de_lo_exergico>
    <field_definicion_del_exergismo xml:lang="es">Corriente filosofica y politica que interpreta la liberacion como aumento, proteccion y orientacion de la exergia humana, social e historica frente a su captura demiurgica y en direccion a la verdad absoluta.</field_definicion_del_exergismo>
    <field_definicion_del_exergista xml:lang="es">Quien orienta su pensamiento o su accion a aumentar la capacidad real de transformacion liberadora y a impedir su captura por estructuras opresivas.</field_definicion_del_exergista>
    <field_doctrina xml:lang="es">exergismo</field_doctrina>
    <field_sujeto xml:lang="es">exergista</field_sujeto>
    <field_termino_principal xml:lang="es">Exergia</field_termino_principal>
    <hasName xml:lang="es">Familia lexica</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.familia_lexica</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">familia_lexica</jsonKey>
  </owl:NamedIndividual>

