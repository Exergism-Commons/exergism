  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#relacion_con_la_etica">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Relacion con la etica</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#psicologia_moral"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#psicologia_moral"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#psicologia_moral"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#psicologia_moral"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#psicologia_moral"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#ser_humano"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#bien"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#mal"/>
    <field_definicion xml:lang="es">La psicologia moral no determina por si sola que es el bien o el mal, pero explica como los sujetos perciben, deforman, racionalizan o encarnan en la practica esas categorias dentro del dominio humano.</field_definicion>
    <field_relacion_con_el_bien xml:lang="es">Ayuda a explicar por que algunas conciencias se orientan hacia apertura, reparacion, verdad y ruptura del ciclo.</field_relacion_con_el_bien>
    <field_relacion_con_el_mal xml:lang="es">Ayuda a explicar por que otras conciencias cooperan con clausura, dominacion, engaño, instrumentalizacion y perpetuacion del ciclo.</field_relacion_con_el_mal>
    <hasDefinition xml:lang="es">La psicologia moral no determina por si sola que es el bien o el mal, pero explica como los sujetos perciben, deforman, racionalizan o encarnan en la practica esas categorias dentro del dominio humano.</hasDefinition>
    <hasName xml:lang="es">Relacion con la etica</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">psicologia_moral.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">psicologia_moral.relacion_con_la_etica</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relacion_con_la_etica</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#relacion_con_la_exergia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Relacion con la exergia</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#metodo_filosofico"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#metodo_filosofico"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#metodo_filosofico"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#metodo_filosofico"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#metodo_filosofico"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#exergia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#autonomia"/>
    <field_definicion xml:lang="es">La exergia introduce un criterio de eficacia filosofica real: no basta con formular conceptos bellos; hay que evaluar si aumentan la capacidad de verdad, autonomia, reorganizacion y ruptura del ciclo.</field_definicion>
    <hasDefinition xml:lang="es">La exergia introduce un criterio de eficacia filosofica real: no basta con formular conceptos bellos; hay que evaluar si aumentan la capacidad de verdad, autonomia, reorganizacion y ruptura del ciclo.</hasDefinition>
    <hasName xml:lang="es">Relacion con la exergia</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metodo_filosofico.json</hasSourceFile>
