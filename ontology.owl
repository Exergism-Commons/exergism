    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#autonomia"/>
    <field_fuga_aparente xml:lang="es">Destruir una forma de orden sin recuperar exergia real ni orientar la potencia liberada.</field_fuga_aparente>
    <field_fuga_real xml:lang="es">Romper el ciclo y aumentar la capacidad efectiva de una conciencia o una sociedad para vivir con mas verdad, autonomia y apertura.</field_fuga_real>
    <hasName xml:lang="es">Distincion clave</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.integraciones_sistemicas.integracion_con_el_escape_del_demiurgo.distincion_clave</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">distincion_clave</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#teoria_de_la_exergia_integraciones_sistemicas_integracion_con_el_escape_del_demiurgo_etapas">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Section"/>
    <rdfs:label xml:lang="es">Etapas</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#integracion_con_el_escape_del_demiurgo"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#demiurgo"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#exergia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#autonomia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#vida"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#verdad_absoluta"/>
    <field_diagnostico xml:lang="es">Reconocer como el demiurgo captura exergia mediante miedo, deseo, dominacion y rigidez.</field_diagnostico>
    <field_proteccion xml:lang="es">Evitar que la potencia liberada vuelva a ser absorbida por nuevas formas de dominacion.</field_proteccion>
    <field_reapropiacion xml:lang="es">Recuperar autonomia, conocimiento, organizacion y margen real de accion.</field_reapropiacion>
    <field_reorientacion xml:lang="es">Dirigir la exergia liberada hacia verdad absoluta, justicia, conciencia y construccion de vida no capturada.</field_reorientacion>
    <field_ruptura xml:lang="es">Debilitar estructuras que esterilizan o secuestran potencia transformadora.</field_ruptura>
    <hasName xml:lang="es">Etapas</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.integraciones_sistemicas.integracion_con_el_escape_del_demiurgo.etapas</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">etapas</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#teoria_de_la_exergia_lectura_negativa_del_exergismo_potencia_capturada_distincion_clave">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Section"/>
    <rdfs:label xml:lang="es">Distincion clave</rdfs:label>
