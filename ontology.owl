    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">institucion_no_demiurgica</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#instituciones">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Instituciones</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#grados_de_demiurgicidad"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#institucion_no_demiurgica"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#grados_de_demiurgicidad"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#institucion_no_demiurgica"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#filosofia_politica_instituciones_mecanismos_de_deriva_demiurgica_collection"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#vida"/>
    <field_ambivalencia xml:lang="es">Ninguna institucion es liberadora por el solo hecho de existir. Toda institucion puede servir tanto a la coordinacion justa como a la captura, segun como distribuya poder, conocimiento, revision y acceso a la decision.</field_ambivalencia>
    <field_definicion xml:lang="es">Estructuras relativamente estables creadas para coordinar conocimiento, poder, conflicto, decision y vida colectiva a lo largo del tiempo.</field_definicion>
    <field_estado_ontologico xml:lang="es">formas organizadas y persistentes del mundo humano en las que se sedimentan normas, funciones, incentivos, jerarquias, memorias y mecanismos de reproduccion social</field_estado_ontologico>
    <field_funcion_general xml:lang="es">Hacer posible coordinacion duradera, administracion de recursos, resolucion de conflictos, produccion de continuidad y organizacion de la accion colectiva.</field_funcion_general>
    <field_riesgo xml:lang="es">Las instituciones tienden a rigidizarse, autonomizarse y reproducir el ciclo demiurgico, porque la estabilidad organizativa favorece acumulacion de poder, rutinizacion, opacidad, defensa corporativa y separacion entre quienes deciden y quienes padecen las decisiones.</field_riesgo>
    <hasDefinition xml:lang="es">Estructuras relativamente estables creadas para coordinar conocimiento, poder, conflicto, decision y vida colectiva a lo largo del tiempo.</hasDefinition>
    <hasName xml:lang="es">Instituciones</hasName>
    <hasOntologicalStatus xml:lang="es">formas organizadas y persistentes del mundo humano en las que se sedimentan normas, funciones, incentivos, jerarquias, memorias y mecanismos de reproduccion social</hasOntologicalStatus>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.instituciones</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">instituciones</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#instrumentalizacion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Instrumentalizacion</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#psicologia_moral"/>
