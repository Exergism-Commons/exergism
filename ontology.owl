    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#justicia"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#modelo_de_sociedad_liberada"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#filosofia_politica_modelo_de_sociedad_liberada_rasgos_estructurales"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#modelo_de_sociedad_liberada"/>
    <field_definicion xml:lang="es">La justicia debe orientarse prioritariamente a proteccion, reparacion, rehabilitacion e integracion, sin renunciar a separar de forma prolongada a quienes persistan en impulsar captura o violencia sistematica.</field_definicion>
    <field_relacion_con_el_modelo xml:lang="es">La calidad de una sociedad liberada se mide en gran parte por su capacidad de defenderse sin convertirse en aparato de crueldad.</field_relacion_con_el_modelo>
    <hasDefinition xml:lang="es">La justicia debe orientarse prioritariamente a proteccion, reparacion, rehabilitacion e integracion, sin renunciar a separar de forma prolongada a quienes persistan en impulsar captura o violencia sistematica.</hasDefinition>
    <hasName xml:lang="es">Justicia</hasName>
