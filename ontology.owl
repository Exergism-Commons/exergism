    <hasText xml:lang="es">Una sociedad puede trascender mediante conocimiento verdadero de la naturaleza y de si misma.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales</jsonKey>
