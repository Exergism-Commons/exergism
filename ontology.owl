  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#tratamiento_del_conflicto">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Tratamiento del conflicto</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#justicia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#justicia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#justicia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#autonomia"/>
    <field_definicion xml:lang="es">El conflicto no debe entenderse como ocasion normal de aniquilacion del adversario, sino como problema a resolver de manera que minimice dano irreversible, preserve autonomia comun y reduzca la reproduccion del ciclo.</field_definicion>
    <field_preferencia xml:lang="es">La resolucion no destructiva es preferible siempre que no deje abierta la recaptura ni exponga a terceros a dano grave.</field_preferencia>
    <hasDefinition xml:lang="es">El conflicto no debe entenderse como ocasion normal de aniquilacion del adversario, sino como problema a resolver de manera que minimice dano irreversible, preserve autonomia comun y reduzca la reproduccion del ciclo.</hasDefinition>
    <hasName xml:lang="es">Tratamiento del conflicto</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.justicia.tratamiento_del_conflicto</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tratamiento_del_conflicto</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#trazabilidad_integral">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Trazabilidad integral</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#institucion_no_demiurgica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#filosofia_politica_instituciones_institucion_no_demiurgica_arquitectura_basica"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#institucion_no_demiurgica"/>
    <field_definicion xml:lang="es">Toda accion institucional relevante debe dejar rastro verificable, de modo que cualquier miembro pueda reconstruir como se genero, modifico, reviso, aprobó o rechazo una propuesta o decision.</field_definicion>
    <field_funcion xml:lang="es">Evitar arbitrariedad, corrupcion procedimental, manipulacion de procesos y borrado de responsabilidad estructural.</field_funcion>
    <hasDefinition xml:lang="es">Toda accion institucional relevante debe dejar rastro verificable, de modo que cualquier miembro pueda reconstruir como se genero, modifico, reviso, aprobó o rechazo una propuesta o decision.</hasDefinition>
    <hasName xml:lang="es">Trazabilidad integral</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.instituciones.institucion_no_demiurgica.arquitectura_basica.trazabilidad_integral</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trazabilidad_integral</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#universalidad">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Universalidad</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#modelo_de_sociedad_liberada"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#filosofia_politica_modelo_de_sociedad_liberada_universalidad_principios_collection"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#modelo_de_sociedad_liberada"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#modelo_de_sociedad_liberada"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#vida"/>
    <field_definicion xml:lang="es">La sociedad liberada debe reconocer a todos sus miembros como participantes plenos del orden comun y no como capas sacrificables, periferias permanentes o sujetos de segunda categoria.</field_definicion>
    <field_funcion xml:lang="es">Impedir que la liberacion se limite a una elite moral, tecnica o economica, y garantizar que los beneficios estructurales de la vida comun se distribuyan universalmente.</field_funcion>
    <field_limite xml:lang="es">La universalidad no implica uniformidad absoluta ni negacion de diferencias de funcion, capacidad, merito o responsabilidad, pero si excluye que esas diferencias cristalicen en privilegios estructurales permanentes o en desposesion basica.</field_limite>
    <hasDefinition xml:lang="es">La sociedad liberada debe reconocer a todos sus miembros como participantes plenos del orden comun y no como capas sacrificables, periferias permanentes o sujetos de segunda categoria.</hasDefinition>
    <hasName xml:lang="es">Universalidad</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.modelo_de_sociedad_liberada.universalidad</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">universalidad</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#universo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Universo</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#ontologia"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#realidad_manifestada"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#ontologia"/>
    <develops rdf:resource="https://id.exergism.org/exergism#entropia"/>
    <develops rdf:resource="https://id.exergism.org/exergism#vida"/>
    <develops rdf:resource="https://id.exergism.org/exergism#realidad"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#materia"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#realidad_manifestada"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#realidad_manifestada"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#materia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#vida"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#ser_humano"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#verdad_absoluta"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#libertad"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#realidad"/>
    <field_condicion_cosmologica xml:lang="es">Las estructuras organizadas del universo, incluida la vida, no son estados permanentes sino configuraciones locales y transitorias dentro de una realidad fisica mucho mas amplia.</field_condicion_cosmologica>
    <field_definicion xml:lang="es">Medio envolvente total del que emergen la materia, la vida, la conciencia, las estructuras humanas y todos los procesos fisicos conocidos. No es un objeto externo separado de nosotros, sino el campo mismo en el que existimos y del que somos manifestaciones parciales.</field_definicion>
    <field_hipotesis_metafisica_abierta xml:lang="es">Si el universo es solo un medio envolvente entre otros y todos los niveles de realidad remiten a un origen ultimo, entonces la conciencia podria ser una forma parcial de autorrevelacion de la totalidad.</field_hipotesis_metafisica_abierta>
    <field_naturaleza xml:lang="es">abierta, dinamica, cambiante y estructurable temporalmente</field_naturaleza>
    <field_relacion_con_el_espiritu_humano xml:lang="es">El espiritu humano es una expresion historico-colectiva de la capacidad del universo para producir formas de conciencia que acumulen experiencia, conocimiento y apertura hacia la verdad.</field_relacion_con_el_espiritu_humano>
    <field_relacion_con_el_ser_humano xml:lang="es">El ser humano es una configuracion material y consciente del universo que ha desarrollado reflexividad, lenguaje, memoria historica y capacidad de orientarse hacia la verdad.</field_relacion_con_el_ser_humano>
    <field_relacion_con_la_conciencia xml:lang="es">Los seres conscientes son manifestaciones del universo que permiten que este se observe parcialmente a si mismo a traves de estructuras materiales capaces de integrar informacion y generar experiencia.</field_relacion_con_la_conciencia>
    <field_relacion_con_la_entropia xml:lang="es">El universo conocido presenta una dinamica entrópica por la cual las formas complejas y ordenadas son temporales y existen dentro de una tendencia mas amplia al cambio, a la dispersion y a la apertura de estados posibles.</field_relacion_con_la_entropia>
    <field_relacion_con_la_libertad xml:lang="es">El universo no es una estructura totalmente cerrada, sino un campo de despliegue de posibilidades en el que pueden emerger nuevos estados, formas y procesos.</field_relacion_con_la_libertad>
    <field_relacion_con_la_materia xml:lang="es">La materia es una de las expresiones fundamentales del universo, surgida de sus reglas fisicas y de sus componentes mas esenciales.</field_relacion_con_la_materia>
    <field_relacion_con_la_verdad_absoluta xml:lang="es">El universo conocido puede ser una capa, manifestacion o medio parcial de la verdad absoluta, sin agotarla necesariamente.</field_relacion_con_la_verdad_absoluta>
    <field_relacion_con_la_vida xml:lang="es">La vida es una organizacion temporal y localizada de la materia capaz de mantener orden interno durante un tiempo a costa de transformar su entorno y aumentar la entropia exterior.</field_relacion_con_la_vida>
    <hasDefinition xml:lang="es">Medio envolvente total del que emergen la materia, la vida, la conciencia, las estructuras humanas y todos los procesos fisicos conocidos. No es un objeto externo separado de nosotros, sino el campo mismo en el que existimos y del que somos manifestaciones parciales.</hasDefinition>
    <hasName xml:lang="es">Universo</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia.estructura_de_lo_real.realidad_manifestada.universo</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">universo</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#uso_de_la_tecnologia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Uso de la tecnologia</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#institucion_no_demiurgica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#filosofia_politica_instituciones_institucion_no_demiurgica_uso_de_la_tecnologia_usos_legitimos_collection"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#institucion_no_demiurgica"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#institucion_no_demiurgica"/>
    <field_definicion xml:lang="es">La tecnologia debe emplearse para ampliar participacion, trazabilidad, auditabilidad, memoria institucional, proteccion del anonimato y capacidad de revision colectiva, no para concentrar control tecnico en una nueva elite.</field_definicion>
    <field_riesgo xml:lang="es">Toda tecnologia institucional puede convertirse en nueva forma de captura tecnica si su arquitectura, mantenimiento o interpretacion quedan monopolizados por pocos actores.</field_riesgo>
    <hasDefinition xml:lang="es">La tecnologia debe emplearse para ampliar participacion, trazabilidad, auditabilidad, memoria institucional, proteccion del anonimato y capacidad de revision colectiva, no para concentrar control tecnico en una nueva elite.</hasDefinition>
    <hasName xml:lang="es">Uso de la tecnologia</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.instituciones.institucion_no_demiurgica.uso_de_la_tecnologia</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uso_de_la_tecnologia</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#usos_liberadores">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Usos liberadores</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#infiltracion"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#filosofia_politica_infiltracion_usos_liberadores_formas_collection"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#infiltracion"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#infiltracion"/>
    <field_definicion xml:lang="es">La infiltracion solo puede considerarse relativamente liberadora cuando se orienta a debilitar estructuras claramente opresivas, abrir conocimiento bloqueado, impedir capturas violentas o facilitar una desactivacion defensiva del dano sin sustituir una prision por otra.</field_definicion>
    <field_limite xml:lang="es">No se vuelve legitima por el simple hecho de dirigirse contra un adversario opresivo. Debe seguir sometida a criterio de verdad, proporcionalidad, minimizacion del dano y no reproduccion del ciclo.</field_limite>
    <hasDefinition xml:lang="es">La infiltracion solo puede considerarse relativamente liberadora cuando se orienta a debilitar estructuras claramente opresivas, abrir conocimiento bloqueado, impedir capturas violentas o facilitar una desactivacion defensiva del dano sin sustituir una prision por otra.</hasDefinition>
    <hasName xml:lang="es">Usos liberadores</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.infiltracion.usos_liberadores</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">usos_liberadores</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#usos_opresivos">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Usos opresivos</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#infiltracion"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <develops rdf:resource="https://id.exergism.org/exergism#demiurgo"/>
    <develops rdf:resource="https://id.exergism.org/exergism#opresion"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#filosofia_politica_infiltracion_usos_opresivos_formas_collection"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#infiltracion"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#infiltracion"/>
    <field_definicion xml:lang="es">La infiltracion adopta forma opresiva cuando se emplea para capturar estructuras autonomas, neutralizar resistencia, sembrar desconfianza, reforzar dominacion o reconducir procesos liberadores hacia nuevas formas de control.</field_definicion>
    <field_relacion_con_el_demiurgo xml:lang="es">La infiltracion es una de las tecnicas mas refinadas del ciclo demiurgico porque permite dominar sin aparecer inmediatamente como fuerza externa de conquista.</field_relacion_con_el_demiurgo>
    <field_relacion_con_la_opresion xml:lang="es">Puede reforzar miedo, servidumbre, deseo inducido, desesperacion inducida y repeticion al introducirlos en la estructura desde dentro en forma de cultura, procedimiento o conflicto.</field_relacion_con_la_opresion>
    <hasDefinition xml:lang="es">La infiltracion adopta forma opresiva cuando se emplea para capturar estructuras autonomas, neutralizar resistencia, sembrar desconfianza, reforzar dominacion o reconducir procesos liberadores hacia nuevas formas de control.</hasDefinition>
    <hasName xml:lang="es">Usos opresivos</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.infiltracion.usos_opresivos</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">usos_opresivos</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#verdad_absoluta">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Verdad absoluta</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#ontologia"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#fundamento_ultimo"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#ontologia"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#metodo_filosofico"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#ontologia_estructura_de_lo_real_fundamento_ultimo_verdad_absoluta_propiedades_collection"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#fundamento_ultimo"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#fundamento_ultimo"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#realidad"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#universo"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#ser_humano"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#tiempo"/>
    <field_caracter_ontologico xml:lang="es">No constituye una entidad personal ni antropomorfica. Si contiene algo analogo a la conciencia o a la voluntad, ello no puede entenderse en sentido humano, psicologico, secuencial ni individual, sino como una forma radicalmente superior en la que toda perspectiva parcial estaria contenida sin quedar sometida al tiempo, a la fragmentacion ni a la experiencia sucesiva propias de las conciencias finitas.</field_caracter_ontologico>
    <field_definicion xml:lang="es">La totalidad de lo real, incluyendo todos los mecanismos del universo y lo que hay detras y mas alla.</field_definicion>
    <field_equivalencia_analogica xml:lang="es">Puede pensarse de forma analogica como una especie de 'monada absoluta': una totalidad impersonal, no reducible a ninguna perspectiva particular, supratemporal y de complejidad infinita, que contiene sin agotarse todos los niveles, procesos y formas de lo real.</field_equivalencia_analogica>
    <field_hipotesis_metafisica_abierta xml:lang="es">Si la verdad absoluta coincide con el origen ultimo de todos los medios envolventes de lo real, entonces toda conciencia podria ser una manifestacion parcial de esa totalidad.</field_hipotesis_metafisica_abierta>
    <field_hipotesis_metafisica_abierta_2 xml:lang="es">Si toda conciencia finita es una manifestacion parcial de la verdad absoluta, entonces cualquier forma de conciencia atribuible analogicamente a esta no consistiria en una experiencia secuencial como la humana, sino en una simultaneidad no fragmentada de todas las perspectivas parciales contenidas en ella.</field_hipotesis_metafisica_abierta_2>
    <field_precaucion_conceptual xml:lang="es">Esta equivalencia no implica identidad con la nocion clasica de monada, sino un uso analogico para señalar unidad, totalidad y profundidad ontologica sin introducir personalizacion ni multiplicidad discreta.</field_precaucion_conceptual>
    <field_precaucion_conceptual_2 xml:lang="es">Terminos como conciencia, experiencia o voluntad solo pueden aplicarse a la verdad absoluta de forma analogica y extremadamente limitada, porque pertenecen al modo finito, temporal, perspectival y fragmentario en que los seres particulares acceden a lo real.</field_precaucion_conceptual_2>
    <field_relacion_con_el_humano xml:lang="es">Atrae y orienta al ser humano hacia la trascendencia, aunque nunca pueda ser poseida completamente.</field_relacion_con_el_humano>
    <field_relacion_con_el_tiempo xml:lang="es">La verdad absoluta no esta contenida por el tiempo propio del universo conocido. El tiempo pertenece a la realidad manifestada, cambiante y finita, mientras que la verdad absoluta excede todo marco temporal particular y no puede entenderse como sometida a sucesion, antes o despues en sentido cosmico.</field_relacion_con_el_tiempo>
    <hasDefinition xml:lang="es">La totalidad de lo real, incluyendo todos los mecanismos del universo y lo que hay detras y mas alla.</hasDefinition>
    <hasName xml:lang="es">Verdad absoluta</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia.estructura_de_lo_real.fundamento_ultimo.verdad_absoluta</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">verdad_absoluta</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#verdad_y_comunicacion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Verdad y comunicacion</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#etica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#etica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#etica"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#etica_verdad_y_comunicacion_criterios_collection"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#etica_verdad_y_comunicacion_tesis_central"/>
    <hasThesis rdf:resource="https://id.exergism.org/exergism#etica_verdad_y_comunicacion_tesis_central"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#etica"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#etica"/>
    <field_definicion xml:lang="es">La verdad no deja de ser verdad por producir dolor, pero su comunicacion debe evaluarse tambien por su forma humana, su oportunidad y su capacidad de no destruir innecesariamente al receptor.</field_definicion>
    <hasDefinition xml:lang="es">La verdad no deja de ser verdad por producir dolor, pero su comunicacion debe evaluarse tambien por su forma humana, su oportunidad y su capacidad de no destruir innecesariamente al receptor.</hasDefinition>
    <hasName xml:lang="es">Verdad y comunicacion</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">etica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">etica.verdad_y_comunicacion</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">verdad_y_comunicacion</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#verguenza">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Vergüenza</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#psicologia_moral"/>
