    <field_deseo_demiurgico xml:lang="es">Busqueda de placer, dominio, permanencia y control.</field_deseo_demiurgico>
    <field_deseo_liberador xml:lang="es">Impulso orientado hacia conocimiento, creacion, apertura, autonomia y superacion de la servidumbre al placer inmediato y al dominio.</field_deseo_liberador>
    <hasName xml:lang="es">Tipos</hasName>
