    <relatedTo rdf:resource="https://id.exergism.org/exergism#vida"/>
    <field_definicion xml:lang="es">Respuestas primarias e instintivas ante acciones, situaciones o sujetos percibidos como afirmadores o amenazantes para la vida, la cooperacion, la integridad o la apertura.</field_definicion>
    <field_limite xml:lang="es">Las reacciones basicas pueden señalar un nucleo moral inicial, pero no bastan por si solas para producir juicio verdadero, justicia ni ruptura del ciclo.</field_limite>
    <field_negativas xml:lang="es">Respuesta instintiva a acciones percibidas como dañinas, opresivas, degradantes o amenazantes.</field_negativas>
    <field_positivas xml:lang="es">Respuesta instintiva a acciones percibidas como afirmadoras de vida, cooperacion, cuidado o apertura.</field_positivas>
    <hasDefinition xml:lang="es">Respuestas primarias e instintivas ante acciones, situaciones o sujetos percibidos como afirmadores o amenazantes para la vida, la cooperacion, la integridad o la apertura.</hasDefinition>
    <hasName xml:lang="es">Reacciones basicas</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">psicologia_moral.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">psicologia_moral.reacciones_basicas</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reacciones_basicas</jsonKey>
  </owl:NamedIndividual>

