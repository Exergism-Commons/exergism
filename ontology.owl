    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#psicologia_moral"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#emociones_que_alertan"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#emociones_que_vinculan"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#emociones_que_deforman"/>
