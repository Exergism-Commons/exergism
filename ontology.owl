  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#fundamentos_relacionales_de_la_exergia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Section"/>
    <rdfs:label xml:lang="es">Fundamento y relaciones principales</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#relacion_con_la_verdad_absoluta"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#exergia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#entropia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#exergia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#libertad"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#realidad"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#cambio"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#mundo_humano"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#ser_humano"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#autonomia"/>
    <field_relacion_con_el_cambio xml:lang="es">El cambio es la manifestacion dinamica de la libertad; la exergia es la medida de cuanta capacidad real tiene un sistema para orientar o producir cambio antes de degradarse o quedar fijado.</field_relacion_con_el_cambio>
    <field_relacion_con_el_mundo_humano xml:lang="es">En el dominio humano, la exergia puede expresarse como potencia de transformacion historica, autonomia efectiva, creatividad, organizacion colectiva y capacidad de romper estructuras opresivas.</field_relacion_con_el_mundo_humano>
    <field_relacion_con_la_conciencia xml:lang="es">Una conciencia con mayor exergia posee mayor capacidad de interpretar, reorganizar, decidir y abrir trayectorias nuevas sin quedar completamente sometida a la inercia del ciclo.</field_relacion_con_la_conciencia>
    <field_relacion_con_la_entropia xml:lang="es">La generacion de entropia destruye exergia. Cuanto mas se aproxima un sistema al equilibrio sin capacidad de reorganizacion, menos exergia conserva.</field_relacion_con_la_entropia>
    <field_relacion_con_la_libertad xml:lang="es">La libertad expresa la apertura fundamental de lo real; la exergia expresa el margen concreto y util que un sistema tiene para convertir esa apertura en transformacion efectiva.</field_relacion_con_la_libertad>
    <hasName xml:lang="es">Fundamento y relaciones principales</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.fundamento_y_relaciones_principales</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fundamento_y_relaciones_principales</jsonKey>
  </owl:NamedIndividual>

