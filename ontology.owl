    <hasConcept rdf:resource="https://id.exergism.org/exergism#captura_de_nodos_estrategicos"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#desplazamiento_simbolico"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#normalizacion_interna_de_la_desviacion"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#filosofia_politica_infiltracion_niveles"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#usos_opresivos"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#usos_liberadores"/>
