    <field_definicion xml:lang="es">La sociedad liberada debe tender a formas de democracia directa o cuasi-directa de alta densidad participativa, donde la representacion, si existe, sea limitada, revocable, funcional y permanentemente trazable.</field_definicion>
    <hasDefinition xml:lang="es">La sociedad liberada debe tender a formas de democracia directa o cuasi-directa de alta densidad participativa, donde la representacion, si existe, sea limitada, revocable, funcional y permanentemente trazable.</hasDefinition>
    <hasName xml:lang="es">Organizacion politica</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
