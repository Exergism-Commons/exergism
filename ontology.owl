    <relatedTo rdf:resource="https://id.exergism.org/exergism#universo"/>
    <field_definicion_general xml:lang="es">La ruptura final posee dos planos distintos: uno cosmologico y otro historico-consciente.</field_definicion_general>
    <field_nota xml:lang="es">La ruptura final cosmologica no equivale a redencion sobrenatural. La ruptura final historico-consciente no equivale a garantia de exito, sino a tarea abierta dentro de un universo finito.</field_nota>
    <hasName xml:lang="es">Ruptura final</hasName>
