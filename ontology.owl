  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#encuentro_con_otras_civilizaciones">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Encuentro con otras civilizaciones</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#teoria_de_la_historia"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#escatologia"/>
