    <relatedTo rdf:resource="https://id.exergism.org/exergism#verdad_absoluta"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#autonomia"/>
    <field_criterio_de_legitimidad xml:lang="es">Solo es legitimo cuando aumenta lucidez, autonomia y comunidad no capturada, y no cuando produce supersticion, jerarquia sacralizada o anulacion critica.</field_criterio_de_legitimidad>
    <field_definicion xml:lang="es">Un ritual es un proceso formal entre humanos destinado a conectar con la verdad absoluta. En la mayoría de casos es innecesario para un exergista, aunque puede tener valor como ejercicio simbolico, pedagogico, ascetico o comunitario.</field_definicion>
    <hasDefinition xml:lang="es">Un ritual es un proceso formal entre humanos destinado a conectar con la verdad absoluta. En la mayoría de casos es innecesario para un exergista, aunque puede tener valor como ejercicio simbolico, pedagogico, ascetico o comunitario.</hasDefinition>
    <hasName xml:lang="es">Ritual</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teologia_o_metafisica_religiosa.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teologia_o_metafisica_religiosa.ritual</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ritual</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#rol_de_la_creacion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Rol de la creacion</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#soteriologia_o_teoria_de_la_liberacion"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#liberacion"/>
