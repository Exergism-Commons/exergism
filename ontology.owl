    <partOf rdf:resource="https://id.exergism.org/exergism#institucion_no_demiurgica"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#institucion_no_demiurgica"/>
    <field_definicion xml:lang="es">Una institucion debe evaluarse no solo por sus fines declarados, sino por la forma real en que distribuye conocimiento, decision, visibilidad, correccion y capacidad de intervencion.</field_definicion>
    <hasDefinition xml:lang="es">Una institucion debe evaluarse no solo por sus fines declarados, sino por la forma real en que distribuye conocimiento, decision, visibilidad, correccion y capacidad de intervencion.</hasDefinition>
    <hasName xml:lang="es">Criterios de juicio</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.instituciones.institucion_no_demiurgica.criterios_de_juicio</hasSourcePath>
