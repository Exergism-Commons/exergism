    <relatedTo rdf:resource="https://id.exergism.org/exergism#cambio_social"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#ciclo_del_mal"/>
    <field_definicion xml:lang="es">Ruptura de ciclos culturales, institucionales y afectivos que reproducen obediencia, violencia, humillacion o recaida.</field_definicion>
    <field_funcion_transformadora xml:lang="es">Evitar que el pasado siga gobernando el presente bajo apariencia de normalidad.</field_funcion_transformadora>
    <field_relacion_con_el_ciclo xml:lang="es">Sin interrumpir la repeticion, el cambio visible se vuelve superficial y la estructura profunda del ciclo permanece viva.</field_relacion_con_el_ciclo>
    <hasDefinition xml:lang="es">Ruptura de ciclos culturales, institucionales y afectivos que reproducen obediencia, violencia, humillacion o recaida.</hasDefinition>
    <hasName xml:lang="es">Interrupcion de la repeticion opresiva</hasName>
