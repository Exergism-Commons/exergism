    <partOf rdf:resource="https://id.exergism.org/exergism#filosofia_politica_instituciones_institucion_no_demiurgica_arquitectura_basica"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#institucion_no_demiurgica"/>
    <field_definicion xml:lang="es">Uso de tecnologia para emitir a cada participante una entidad certificadora o credencial verificable que le permita votar, proponer, revisar, deliberar y gestionar de forma legitima, trazable y operativamente anonima.</field_definicion>
    <field_funcion xml:lang="es">Separar validez institucional de identidad expuesta, permitiendo al mismo tiempo integridad procedimental, verificabilidad y participacion segura.</field_funcion>
    <hasDefinition xml:lang="es">Uso de tecnologia para emitir a cada participante una entidad certificadora o credencial verificable que le permita votar, proponer, revisar, deliberar y gestionar de forma legitima, trazable y operativamente anonima.</hasDefinition>
    <hasName xml:lang="es">Certificacion distribuida de participacion</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.instituciones.institucion_no_demiurgica.arquitectura_basica.certificacion_distribuida_de_participacion</hasSourcePath>
