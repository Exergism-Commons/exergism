  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#dios_cristiano">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Dios cristiano</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#teologia_o_metafisica_religiosa"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#teologia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#teologia_o_metafisica_religiosa"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#teologia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#teologia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#ser_humano"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#demiurgo"/>
    <field_definicion xml:lang="es">El dios abramico en gran medida es la ejemplificacion del demiurgo, de los deseos de control humanos. Ningún dios verdadero sería personal, ni tendría crueldad o bondad, eso son dominios humanos.</field_definicion>
    <field_nota_hermeneutica xml:lang="es">Las religiones historicas pueden contener intuiciones parciales de verdad, pero tambien mecanismos de captura, miedo, obediencia y sacralizacion del poder.</field_nota_hermeneutica>
    <field_tipo xml:lang="es">personal y demiurgico segun el sistema actual</field_tipo>
    <hasDefinition xml:lang="es">El dios abramico en gran medida es la ejemplificacion del demiurgo, de los deseos de control humanos. Ningún dios verdadero sería personal, ni tendría crueldad o bondad, eso son dominios humanos.</hasDefinition>
    <hasName xml:lang="es">Dios cristiano</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teologia_o_metafisica_religiosa.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teologia_o_metafisica_religiosa.dios_cristiano</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dios_cristiano</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#dios_verdadero">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Dios verdadero</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#teologia_o_metafisica_religiosa"/>
