    <relatedTo rdf:resource="https://id.exergism.org/exergism#ser_humano"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#vida"/>
    <field_definicion xml:lang="es">Respuesta afectiva y practica ante amenaza, perdida, incertidumbre, vulnerabilidad o riesgo percibido.</field_definicion>
    <field_funcion xml:lang="es">Activa mecanismos de defensa, evitacion, cautela, huida, sumision o anticipacion protectora.</field_funcion>
    <field_limite xml:lang="es">Cuando domina la conciencia, puede reforzar servidumbre, apego, cierre cognitivo y disposicion a someterse o dominar.</field_limite>
    <field_relacion_con_el_ser_humano xml:lang="es">En el ser humano el miedo puede ser biologico, social, simbolico, politico o existencial, y constituye una de las bases mas frecuentes de la reproduccion del ciclo.</field_relacion_con_el_ser_humano>
    <hasDefinition xml:lang="es">Respuesta afectiva y practica ante amenaza, perdida, incertidumbre, vulnerabilidad o riesgo percibido.</hasDefinition>
    <hasName xml:lang="es">Miedo</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antropologia_filosofica.json</hasSourceFile>
