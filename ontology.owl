    <develops rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <develops rdf:resource="https://id.exergism.org/exergism#impulso"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#antropologia_filosofica_procesos_de_elaboracion_consciente_deseo_tipos"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#procesos_de_elaboracion_consciente"/>
