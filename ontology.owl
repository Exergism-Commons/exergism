  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#imaginacion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Imaginacion</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#antropologia_filosofica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#procesos_secundarios_conscientes"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#antropologia_filosofica"/>
    <develops rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <develops rdf:resource="https://id.exergism.org/exergism#realidad"/>
    <develops rdf:resource="https://id.exergism.org/exergism#supervivencia"/>
    <develops rdf:resource="https://id.exergism.org/exergism#abstraccion"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#antropologia_filosofica_procesos_secundarios_conscientes_imaginacion_modalidades"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#procesos_secundarios_conscientes"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#procesos_secundarios_conscientes"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#tiempo"/>
    <field_ambivalencia xml:lang="es">Puede abrir conocimiento, creacion y liberacion, pero tambien generar autoengaño, paranoia, ficciones ideologicas o modelos usados para la dominacion.</field_ambivalencia>
    <field_definicion xml:lang="es">Capacidad de la conciencia para proyectar, simular, recombinar o figurar posibilidades, escenarios, relaciones o cursos de accion no presentes de forma inmediata en la experiencia.</field_definicion>
    <field_funcion xml:lang="es">Permite anticipar, planificar, ensayar mentalmente, crear, interpretar y abrir alternativas frente a la reaccion inmediata, ampliando el campo de accion de la conciencia dentro de una realidad abierta al cambio.</field_funcion>
    <field_relacion_con_el_tiempo xml:lang="es">Esta ligada a la expectativa y a la proyeccion de futuros posibles, conectando pasado, presente y posibilidad.</field_relacion_con_el_tiempo>
    <field_relacion_con_la_abstraccion xml:lang="es">Puede operar sin abstraccion compleja en formas basicas, pero en la conciencia reflexiva se articula con ella para producir modelos, teorias y construcciones simbolicas.</field_relacion_con_la_abstraccion>
    <field_relacion_con_la_conciencia xml:lang="es">Se apoya en la capacidad de la conciencia para integrar memoria, interpretar secuencias temporales y construir modelos parciales de la realidad.</field_relacion_con_la_conciencia>
    <field_relacion_con_la_supervivencia xml:lang="es">En sus formas basicas permite anticipacion adaptativa, evitacion del peligro y preparacion de respuestas; en sus formas complejas hace posible estrategia, innovacion y proyecto historico.</field_relacion_con_la_supervivencia>
    <hasDefinition xml:lang="es">Capacidad de la conciencia para proyectar, simular, recombinar o figurar posibilidades, escenarios, relaciones o cursos de accion no presentes de forma inmediata en la experiencia.</hasDefinition>
    <hasName xml:lang="es">Imaginacion</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antropologia_filosofica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antropologia_filosofica.procesos_secundarios_conscientes.imaginacion</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">imaginacion</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#imperium">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Imperium</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#poder"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <hasSubtype rdf:resource="https://id.exergism.org/exergism#type_subtype"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#filosofia_politica_poder_tipos"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#poder"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#vida"/>
    <field_definicion xml:lang="es">Poder de mando, direccion y decision ejecutiva sobre personas, territorios, instituciones o procesos colectivos.</field_definicion>
    <field_forma xml:lang="es">capacidad de ordenar y hacer ejecutar</field_forma>
    <field_riesgo xml:lang="es">Tiende a concentrarse, endurecerse y autonomizarse con facilidad, transformandose en dominacion estructural.</field_riesgo>
    <field_uso_liberador xml:lang="es">Coordinacion defensiva, organizacion transitoria frente al caos, proteccion de un orden justo y capacidad de respuesta ante amenazas graves.</field_uso_liberador>
    <field_uso_opresivo xml:lang="es">Mando vertical, imposicion arbitraria, militarizacion de la vida colectiva y subordinacion de los demas a una voluntad central.</field_uso_opresivo>
    <hasDefinition xml:lang="es">Poder de mando, direccion y decision ejecutiva sobre personas, territorios, instituciones o procesos colectivos.</hasDefinition>
    <hasName xml:lang="es">Imperium</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.poder.tipos.imperium</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">imperium</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#impulso">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Impulso</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#antropologia_filosofica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#procesos_basales_conscientes"/>
