    <partOf rdf:resource="https://id.exergism.org/exergism#odio"/>
    <field_odio_demiurgico xml:lang="es">Se organiza como voluntad de degradar, perseguir, instrumentalizar o destruir al otro, legitimando dominacion, crueldad y reproduccion del ciclo.</field_odio_demiurgico>
    <field_odio_reactivo xml:lang="es">Nace de daño, miedo, humillacion o agresion percibida y busca respuesta hostil o defensiva.</field_odio_reactivo>
    <field_odio_resentido xml:lang="es">Se alimenta de memoria del agravio, comparacion, impotencia y fijacion prolongada sobre una ofensa real o imaginada.</field_odio_resentido>
    <hasName xml:lang="es">Tipos</hasName>
