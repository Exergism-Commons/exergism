    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#miedo"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#opresion"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <develops rdf:resource="https://id.exergism.org/exergism#opresion"/>
    <develops rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#filosofia_politica_opresion_mecanismos_miedo_formas_collection"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#filosofia_politica_opresion_mecanismos_miedo_efectos_collection"/>
    <hasSubtype rdf:resource="https://id.exergism.org/exergism#mechanism"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#filosofia_politica_opresion_mecanismos"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#opresion"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#autonomia"/>
    <field_criterio_de_juicio xml:lang="es">Debe juzgarse por el grado en que bloquea autonomia, lucidez, organizacion y capacidad de respuesta libre.</field_criterio_de_juicio>
    <field_definicion xml:lang="es">Mecanismo de opresion por el cual una estructura, institucion, elite o entorno mantiene a sujetos o colectivos bajo percepcion persistente de amenaza, daño, castigo o perdida, reduciendo su autonomia, su capacidad de juicio y su disposicion a resistir.</field_definicion>
    <field_estado_ontologico xml:lang="es">mecanismo psico-politico de sujecion dentro del dominio humano</field_estado_ontologico>
    <field_funcion_opresiva xml:lang="es">Desactivar la iniciativa, inducir obediencia defensiva y estrechar el horizonte de accion posible.</field_funcion_opresiva>
    <field_relacion_con_la_opresion xml:lang="es">El miedo es uno de los mecanismos basicos de la opresion porque reduce la apertura practica de la conciencia y la inclina a aceptar servidumbre a cambio de seguridad.</field_relacion_con_la_opresion>
    <hasDefinition xml:lang="es">Mecanismo de opresion por el cual una estructura, institucion, elite o entorno mantiene a sujetos o colectivos bajo percepcion persistente de amenaza, daño, castigo o perdida, reduciendo su autonomia, su capacidad de juicio y su disposicion a resistir.</hasDefinition>
    <hasName xml:lang="es">Miedo</hasName>
    <hasOntologicalStatus xml:lang="es">mecanismo psico-politico de sujecion dentro del dominio humano</hasOntologicalStatus>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.opresion.mecanismos.miedo</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">miedo</jsonKey>
  </owl:NamedIndividual>

