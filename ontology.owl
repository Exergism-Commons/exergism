  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#capitalismo_limitado">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Capitalismo limitado</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#economia_y_autonomia_material"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#filosofia_politica_modelo_de_sociedad_liberada_rasgos_estructurales_economia_y_autonomia_material_capitalismo_limitado_condiciones_de_legitimidad_collection"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#economia_y_autonomia_material"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#economia_y_autonomia_material"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#demiurgo"/>
    <field_definicion xml:lang="es">Las formas de mercado, empresa privada, competencia e inversion pueden subsistir en la medida en que funcionen como instrumentos economicos acotados para innovacion, eficiencia y coordinacion productiva, pero no como principio rector absoluto de la sociedad.</field_definicion>
    <field_riesgo xml:lang="es">Sin limites fuertes, el capitalismo tiende a concentrar riqueza, monopolizar sectores, absorber instituciones y recrear una aristocracia economica compatible con formas nuevas del demiurgo.</field_riesgo>
    <hasDefinition xml:lang="es">Las formas de mercado, empresa privada, competencia e inversion pueden subsistir en la medida en que funcionen como instrumentos economicos acotados para innovacion, eficiencia y coordinacion productiva, pero no como principio rector absoluto de la sociedad.</hasDefinition>
    <hasName xml:lang="es">Capitalismo limitado</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.modelo_de_sociedad_liberada.rasgos_estructurales.economia_y_autonomia_material.capitalismo_limitado</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">capitalismo_limitado</jsonKey>
  </owl:NamedIndividual>

