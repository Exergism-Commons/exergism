    <relatedTo rdf:resource="https://id.exergism.org/exergism#psicologia_moral"/>
    <field_definicion xml:lang="es">Afecto ligado a exposicion, perdida de valor propio o percepcion de fallo moral, capaz tanto de abrir a correccion como de hundir en ocultamiento, servidumbre o agresion defensiva.</field_definicion>
    <hasDefinition xml:lang="es">Afecto ligado a exposicion, perdida de valor propio o percepcion de fallo moral, capaz tanto de abrir a correccion como de hundir en ocultamiento, servidumbre o agresion defensiva.</hasDefinition>
    <hasName xml:lang="es">Vergüenza</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">psicologia_moral.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">psicologia_moral.heridas_morales.verguenza</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">verguenza</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#vida">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Vida</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#ontologia"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#niveles_emergentes"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#ontologia"/>
    <emergesFrom rdf:resource="https://id.exergism.org/exergism#materia"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#preparacion_marcial"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#escala_de_complejidad_vital"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#horizonte_metafisico"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#escala_de_complejidad_vital"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#horizonte_metafisico"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#aclaraciones_sobre_la_vida"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#ontologia_estructura_de_lo_real_niveles_emergentes_vida_tesis_emergentista"/>
    <hasThesis rdf:resource="https://id.exergism.org/exergism#ontologia_estructura_de_lo_real_niveles_emergentes_vida_tesis_emergentista"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#niveles_emergentes"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#niveles_emergentes"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#autonomia"/>
    <field_criterio_general xml:lang="es">Los seres vivos y proto-vivos pueden distinguirse segun su grado de complejidad emergente, autonomia organizativa, capacidad reproductiva, integracion funcional y nivel de composicion supraindividual.</field_criterio_general>
    <field_definicion xml:lang="es">Forma emergente de organizacion material capaz de mantener coherencia interna temporal, metabolizar o parasitar flujos del entorno, reproducir estructura total o parcialmente, adaptarse, evolucionar y generar niveles superiores de complejidad.</field_definicion>
    <hasDefinition xml:lang="es">Forma emergente de organizacion material capaz de mantener coherencia interna temporal, metabolizar o parasitar flujos del entorno, reproducir estructura total o parcialmente, adaptarse, evolucionar y generar niveles superiores de complejidad.</hasDefinition>
    <hasName xml:lang="es">Vida</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia.estructura_de_lo_real.niveles_emergentes.vida</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vida</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#virtudes_psicologicas_de_liberacion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Virtudes psicologicas de liberacion</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#psicologia_moral"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#psicologia_moral"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#psicologia_moral"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#psicologia_moral_virtudes_psicologicas_de_liberacion_rasgos_collection"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#psicologia_moral"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#psicologia_moral"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <field_definicion xml:lang="es">Disposiciones psiquicas que aumentan la capacidad de una conciencia para resistir captura, elaborar daño, reconocer al otro y sostener respuestas que reduzcan dominacion y sufrimiento.</field_definicion>
    <hasDefinition xml:lang="es">Disposiciones psiquicas que aumentan la capacidad de una conciencia para resistir captura, elaborar daño, reconocer al otro y sostener respuestas que reduzcan dominacion y sufrimiento.</hasDefinition>
    <hasName xml:lang="es">Virtudes psicologicas de liberacion</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">psicologia_moral.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">psicologia_moral.virtudes_psicologicas_de_liberacion</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">virtudes_psicologicas_de_liberacion</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#aclaraciones_sobre_la_vida">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Section"/>
    <rdfs:label xml:lang="es">Aclaraciones</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#ontologia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#ontologia"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#vida"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#ser_humano"/>
    <field_sobre_el_ser_humano xml:lang="es">El ser humano pertenece biologicamente al nivel de organismo multicelular, pero participa tambien en niveles supraindividuales ecosistemicos, sociales e historicos.</field_sobre_el_ser_humano>
    <field_sobre_el_valor_ontologico xml:lang="es">Un mayor grado de individuacion no implica por si mismo una superioridad ontologica absoluta, sino una forma distinta de unidad vital dentro de la escala emergente.</field_sobre_el_valor_ontologico>
    <field_sobre_la_conciencia xml:lang="es">La complejidad vital no equivale automaticamente a conciencia compleja, aunque puede ampliar las condiciones de posibilidad para su emergencia.</field_sobre_la_conciencia>
    <field_sobre_la_individuacion xml:lang="es">La relacion entre complejidad vital e individuacion no es lineal, sino aproximadamente curvilinea: la individuacion tiende a crecer en los niveles intermedios de complejidad, alcanza un apogeo relativo en organismos altamente integrados, y se vuelve mas difusa en formas superiores de organizacion supraindividual.</field_sobre_la_individuacion>
    <field_sobre_la_linealidad xml:lang="es">La escala no implica una jerarquia moral simple ni una progresion necesaria, sino una tipologia de niveles de organizacion y emergencia vital.</field_sobre_la_linealidad>
    <hasName xml:lang="es">Aclaraciones</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia.estructura_de_lo_real.niveles_emergentes.vida.aclaraciones</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aclaraciones</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#antropologia_filosofica_autonomia_humana_potencial">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Section"/>
    <rdfs:label xml:lang="es">Potencial</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#antropologia_filosofica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#antropologia_filosofica"/>
    <develops rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#autonomia_humana"/>
    <field_para_el_bien xml:lang="es">Permite usar el poder para proteger, organizar, liberar, distribuir conocimiento y abrir posibilidades de desarrollo comun.</field_para_el_bien>
    <field_para_el_mal xml:lang="es">Tambien permite una dominacion mas refinada cuando alguien posee lucidez suficiente para instrumentalizar a otros de manera consciente.</field_para_el_mal>
    <hasName xml:lang="es">Potencial</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antropologia_filosofica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antropologia_filosofica.autonomia_humana.potencial</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">potencial</jsonKey>
  </owl:NamedIndividual>

