  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#sensibilidad">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Sensibilidad</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#antropologia_filosofica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#procesos_basales_conscientes"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#antropologia_filosofica"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#procesos_basales_conscientes"/>
