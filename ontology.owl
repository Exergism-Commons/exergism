  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#anonimato_politico_operativo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Anonimato politico operativo</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#institucion_no_demiurgica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#filosofia_politica_instituciones_institucion_no_demiurgica_arquitectura_basica"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#institucion_no_demiurgica"/>
    <field_definicion xml:lang="es">La identidad civil o personal del participante no debe ser necesaria para ejercer voto, propuesta, evaluacion o gestion ordinaria, siempre que exista una acreditacion tecnica valida que garantice pertenencia, unicidad y capacidad legitima de intervencion.</field_definicion>
    <field_funcion xml:lang="es">Reducir clientelismo, represalia, culto a la personalidad, presion faccional y acumulacion de auctoritas basada en identidad publica persistente.</field_funcion>
    <field_limite xml:lang="es">El anonimato no debe destruir trazabilidad del proceso ni permitir multiplicacion fraudulenta de intervenciones; debe combinarse con certificacion robusta y control anticlonacion.</field_limite>
    <hasDefinition xml:lang="es">La identidad civil o personal del participante no debe ser necesaria para ejercer voto, propuesta, evaluacion o gestion ordinaria, siempre que exista una acreditacion tecnica valida que garantice pertenencia, unicidad y capacidad legitima de intervencion.</hasDefinition>
    <hasName xml:lang="es">Anonimato politico operativo</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.instituciones.institucion_no_demiurgica.arquitectura_basica.anonimato_politico_operativo</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">anonimato_politico_operativo</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#antimonopolio_y_desconcentracion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Antimonopolio y desconcentracion</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#economia_y_autonomia_material"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#filosofia_politica_modelo_de_sociedad_liberada_rasgos_estructurales_economia_y_autonomia_material_antimonopolio_y_desconcentracion_mecanismos_collection"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#economia_y_autonomia_material"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#economia_y_autonomia_material"/>
    <field_definicion xml:lang="es">La sociedad liberada debe vigilar y limitar activamente la tendencia de los mercados, redes empresariales y plataformas tecnicas a concentrar sectores enteros en pocos agentes.</field_definicion>
    <hasDefinition xml:lang="es">La sociedad liberada debe vigilar y limitar activamente la tendencia de los mercados, redes empresariales y plataformas tecnicas a concentrar sectores enteros en pocos agentes.</hasDefinition>
    <hasName xml:lang="es">Antimonopolio y desconcentracion</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
