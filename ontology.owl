    <hasPart rdf:resource="https://id.exergism.org/exergism#filosofia_politica_etica_de_transicion_dimension_tragica_tesis"/>
    <hasThesis rdf:resource="https://id.exergism.org/exergism#filosofia_politica_etica_de_transicion_dimension_tragica_tesis"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#etica_de_transicion"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#etica_de_transicion"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <field_consecuencia xml:lang="es">La etica de transicion no debe romantizar la dureza, sino asumirla con lucidez, contencion y conciencia de deuda moral.</field_consecuencia>
    <field_definicion xml:lang="es">La transicion puede exigir decisiones moralmente duras en las que toda opcion disponible contenga algun grado de daño, perdida o impureza.</field_definicion>
    <hasDefinition xml:lang="es">La transicion puede exigir decisiones moralmente duras en las que toda opcion disponible contenga algun grado de daño, perdida o impureza.</hasDefinition>
    <hasName xml:lang="es">Dimension tragica</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.etica_de_transicion.dimension_tragica</hasSourcePath>
