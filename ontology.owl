    <hasPart rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia_relacion_con_el_demiurgo_y_la_liberacion_relacion_con_el_demiurgo_mecanismo_collection"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#relacion_con_el_demiurgo_y_la_liberacion"/>
