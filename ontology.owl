    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#ser_humano"/>
    <field_definicion xml:lang="es">Base primaria de las necesidades y tendencias de accion orientadas a conservar estructura, satisfacer carencias, descargar tension o buscar realizacion.</field_definicion>
    <field_funcion xml:lang="es">Expresa la dinamica basal que empuja a un ser o sistema consciente hacia movimiento, satisfaccion, descarga, apropiacion, busqueda o transformacion.</field_funcion>
    <field_relacion_con_el_ser_humano xml:lang="es">En el ser humano adopta formas biologicas, afectivas, simbolicas y espirituales, pudiendo orientarse tanto a la supervivencia como al dominio o a la trascendencia.</field_relacion_con_el_ser_humano>
    <hasDefinition xml:lang="es">Base primaria de las necesidades y tendencias de accion orientadas a conservar estructura, satisfacer carencias, descargar tension o buscar realizacion.</hasDefinition>
    <hasName xml:lang="es">Impulso</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antropologia_filosofica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antropologia_filosofica.procesos_basales_conscientes.impulso</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">impulso</jsonKey>
