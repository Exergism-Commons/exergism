  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#respuesta_frente_a_agentes_demiurgicos_persistentes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Respuesta frente a agentes demiurgicos persistentes</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#justicia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#filosofia_politica_justicia_respuesta_frente_a_agentes_demiurgicos_persistentes_orden_de_prioridad_collection"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#justicia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#justicia"/>
    <field_definicion xml:lang="es">Cuando un individuo o grupo intenta reinstaurar estructuras de dominacion, captura o violencia sistematica, la sociedad liberada debe responder primero con contencion, limitacion de poder, defensa de terceros y esfuerzo serio de rehabilitacion. Solo cuando la reintegracion segura no sea posible, puede justificar medidas de separacion prolongada.</field_definicion>
    <field_limite xml:lang="es">La peligrosidad persistente no autoriza crueldad, tortura, humillacion sistematica ni destruccion arbitraria del sujeto.</field_limite>
    <field_principio_general xml:lang="es">Ni impunidad ingenua ni exterminio vengativo.</field_principio_general>
    <hasDefinition xml:lang="es">Cuando un individuo o grupo intenta reinstaurar estructuras de dominacion, captura o violencia sistematica, la sociedad liberada debe responder primero con contencion, limitacion de poder, defensa de terceros y esfuerzo serio de rehabilitacion. Solo cuando la reintegracion segura no sea posible, puede justificar medidas de separacion prolongada.</hasDefinition>
    <hasName xml:lang="es">Respuesta frente a agentes demiurgicos persistentes</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.justicia.respuesta_frente_a_agentes_demiurgicos_persistentes</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">respuesta_frente_a_agentes_demiurgicos_persistentes</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#respuesta_moral">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
