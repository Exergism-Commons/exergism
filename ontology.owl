  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#mision_exergica_universal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Mision exergica universal</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#soteriologia_o_teoria_de_la_liberacion"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#liberacion"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#soteriologia_o_teoria_de_la_liberacion"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#liberacion"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#liberacion"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#ser_humano"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#exergia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#autonomia"/>
    <field_definicion xml:lang="es">Si la humanidad alcanzara suficiente madurez, podria asumir una funcion exergica universal: no dominar otras civilizaciones, sino contribuir, cuando sea legitimo y posible, a aumentar verdad, autonomia y liberacion en escalas mas amplias que la terrestre.</field_definicion>
    <field_limite xml:lang="es">Esta funcion nunca legitima superioridad absoluta, imposicion, violencia evangelizadora ni paternalismo cosmico.</field_limite>
    <hasDefinition xml:lang="es">Si la humanidad alcanzara suficiente madurez, podria asumir una funcion exergica universal: no dominar otras civilizaciones, sino contribuir, cuando sea legitimo y posible, a aumentar verdad, autonomia y liberacion en escalas mas amplias que la terrestre.</hasDefinition>
    <hasName xml:lang="es">Mision exergica universal</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soteriologia_o_teoria_de_la_liberacion.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soteriologia_o_teoria_de_la_liberacion.mision_exergica_universal</hasSourcePath>
