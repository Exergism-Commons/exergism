    <relatedTo rdf:resource="https://id.exergism.org/exergism#autonomia"/>
    <field_definicion xml:lang="es">Conjunto de mecanismos y estructuras que fijan la conciencia humana en miedo, servidumbre, deseo inducido, desesperacion inducida y repeticion, reduciendo su autonomia y su capacidad de verdad, resistencia y transformacion.</field_definicion>
    <field_valoracion xml:lang="es">mala</field_valoracion>
    <hasDefinition xml:lang="es">Conjunto de mecanismos y estructuras que fijan la conciencia humana en miedo, servidumbre, deseo inducido, desesperacion inducida y repeticion, reduciendo su autonomia y su capacidad de verdad, resistencia y transformacion.</hasDefinition>
    <hasName xml:lang="es">Opresion</hasName>
