    <hasConcept rdf:resource="https://id.exergism.org/exergism#filosofia_politica_modelo_de_sociedad_liberada_rasgos_estructurales_justicia"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#defensa_y_resistencia"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#tecnologia"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#dinamica_interna"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#limites"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#universalidad"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#filosofia_politica_modelo_de_sociedad_liberada_rasgos_estructurales"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#dinamica_interna"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#limites"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#filosofia_politica_modelo_de_sociedad_liberada_principios_collection"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#filosofia_politica_modelo_de_sociedad_liberada_criterios_de_existencia_relativa_collection"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#filosofia_politica_modelo_de_sociedad_liberada_tesis_central"/>
