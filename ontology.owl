    <hasPart rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia_fundamento_y_relaciones_principales_relacion_con_la_verdad_absoluta_tesis_central"/>
    <hasThesis rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia_fundamento_y_relaciones_principales_relacion_con_la_verdad_absoluta_tesis_central"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#fundamentos_relacionales_de_la_exergia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#exergia"/>
    <field_definicion xml:lang="es">La verdad absoluta es el horizonte total de lo real; la exergia es la capacidad parcial y efectiva de una conciencia o una estructura para orientarse hacia ella y abrir transformaciones coherentes con esa orientacion.</field_definicion>
    <field_limite xml:lang="es">Ninguna cantidad de exergia agota la verdad absoluta; solo permite aperturas parciales, revisables y situadas.</field_limite>
    <hasDefinition xml:lang="es">La verdad absoluta es el horizonte total de lo real; la exergia es la capacidad parcial y efectiva de una conciencia o una estructura para orientarse hacia ella y abrir transformaciones coherentes con esa orientacion.</hasDefinition>
    <hasName xml:lang="es">Relacion con la verdad absoluta</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.fundamento_y_relaciones_principales.relacion_con_la_verdad_absoluta</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relacion_con_la_verdad_absoluta</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#relacion_con_los_dominios_del_conocimiento_humano">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Relacion con los dominios del conocimiento humano</rdfs:label>
