    <field_definicion xml:lang="es">Fin de la vida individual y de la conciencia personal humana.</field_definicion>
    <field_efecto_sobre_el_cuerpo xml:lang="es">El cuerpo entra en descomposicion y pasa a formar parte del ciclo trofico.</field_efecto_sobre_el_cuerpo>
    <field_efecto_sobre_la_conciencia xml:lang="es">La conciencia cesa con la muerte al depender del cerebro como fenomeno emergente.</field_efecto_sobre_la_conciencia>
    <field_significado_ontologico xml:lang="es">La muerte marca el fin del individuo consciente y el reinicio de la participacion material en la red de la vida.</field_significado_ontologico>
    <hasDefinition xml:lang="es">Fin de la vida individual y de la conciencia personal humana.</hasDefinition>
    <hasName xml:lang="es">Muerte</hasName>
