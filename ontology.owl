    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relacion_con_la_exergia</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#relacion_con_la_justicia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Relacion con la justicia</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#etica_de_transicion"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#etica_de_transicion"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#etica_de_transicion"/>
    <field_definicion xml:lang="es">La justicia en transicion no puede ser plenamente identica a la justicia de una sociedad liberada, pero debe conservar ya desde el principio orientacion a rehabilitacion, proteccion de derechos minimos y rechazo de la crueldad como forma de gobierno.</field_definicion>
    <field_riesgo xml:lang="es">Si la transicion destruye todo nucleo de justicia, prepara desde su interior la recaida en una nueva prision.</field_riesgo>
    <hasDefinition xml:lang="es">La justicia en transicion no puede ser plenamente identica a la justicia de una sociedad liberada, pero debe conservar ya desde el principio orientacion a rehabilitacion, proteccion de derechos minimos y rechazo de la crueldad como forma de gobierno.</hasDefinition>
    <hasName xml:lang="es">Relacion con la justicia</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.etica_de_transicion.relacion_con_la_justicia</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relacion_con_la_justicia</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#relacion_con_la_moral_intrahumana">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
