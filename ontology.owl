    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#potencia_capturada"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#autonomia"/>
    <field_potencia_demiurgizada xml:lang="es">Potencia que no solo se pierde para la liberacion, sino que es reconvertida activamente en dominacion, control, captura o reproduccion inteligente del ciclo.</field_potencia_demiurgizada>
    <field_potencia_disipada xml:lang="es">Potencia perdida, agotada o esterilizada sin generar apertura liberadora ni consolidacion autonoma.</field_potencia_disipada>
    <hasName xml:lang="es">Distincion clave</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.lectura_negativa_del_exergismo.potencia_capturada.distincion_clave</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">distincion_clave</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#teoria_de_la_exergia_tipos_de_exergia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Section"/>
    <rdfs:label xml:lang="es">Tipos de exergia</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#exergia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#materia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#vida"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#realidad"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#verdad_absoluta"/>
    <field_exergia_biologica xml:lang="es">Capacidad de un ser vivo para mantener organizacion, adaptarse y actuar antes de degradarse o morir.</field_exergia_biologica>
    <field_exergia_consciente xml:lang="es">Capacidad de una conciencia para interpretar la realidad, orientar su accion y resistir captura por impulso, miedo o estructura.</field_exergia_consciente>
    <field_exergia_espiritual xml:lang="es">Capacidad de una conciencia o una colectividad para sostener orientacion hacia la verdad absoluta sin quedar absorbida por la repeticion del ciclo.</field_exergia_espiritual>
    <field_exergia_fisica xml:lang="es">Capacidad de un sistema material para producir trabajo util en relacion con su entorno.</field_exergia_fisica>
    <field_exergia_historica xml:lang="es">Margen de transformacion efectiva disponible en una epoca o situacion historica determinada.</field_exergia_historica>
    <field_exergia_social xml:lang="es">Capacidad de una sociedad para reorganizarse, corregirse, redistribuir poder y abrir posibilidades reales de liberacion.</field_exergia_social>
    <hasName xml:lang="es">Tipos de exergia</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.tipos_de_exergia</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tipos_de_exergia</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#antropologia_filosofica_conciencia_tesis_general">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis general</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#antropologia_filosofica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#antropologia_filosofica"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <hasName xml:lang="es">Tesis general</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antropologia_filosofica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antropologia_filosofica.conciencia.tesis_general</hasSourcePath>
    <hasText xml:lang="es">La conciencia no es exclusiva del ser humano, de los animales ni necesariamente de la vida conocida en la Tierra. Puede existir en multiples grados, formas y arquitecturas materiales dentro del universo.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_general</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#antropologia_filosofica_procesos_basales_conscientes_tesis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#antropologia_filosofica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#antropologia_filosofica"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#procesos_basales_conscientes"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#procesos_basales_conscientes"/>
    <hasName xml:lang="es">Tesis</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antropologia_filosofica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antropologia_filosofica.procesos_basales_conscientes.tesis</hasSourcePath>
    <hasText xml:lang="es">Los estimulos positivos y negativos, la evitacion del daño y la busqueda de conservacion o apertura constituyen un nucleo axiologico minimo inherente al fenomeno emergente de la vida</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#antropologia_filosofica_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#antropologia_filosofica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#antropologia_filosofica"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#ser_humano"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#ser_humano"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antropologia_filosofica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antropologia_filosofica.tesis_central</hasSourcePath>
    <hasText xml:lang="es">El ser humano es una forma de conciencia reflexiva atravesada por la tension entre su base animal-instintiva y su capacidad de orientarse hacia la verdad, la autonomia y la trascendencia.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#epistemologia_conjetura_de_traduccion_moral_interconsciente_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#epistemologia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#epistemologia"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#conjetura_de_traduccion_moral_interconsciente"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#conjetura_de_traduccion_moral_interconsciente"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">epistemologia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">epistemologia.conjetura_de_traduccion_moral_interconsciente.tesis_central</hasSourcePath>
    <hasText xml:lang="es">Es posible construir sistemas de traduccion moral entre conciencias distintas si existen estructuras compartidas minimas de estimulo, daño, apertura, evitacion, cooperacion o preservacion.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#epistemologia_discernimiento_de_orientacion_hacia_la_verdad_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#epistemologia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#epistemologia"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#discernimiento_de_orientacion_hacia_la_verdad"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#discernimiento_de_orientacion_hacia_la_verdad"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">epistemologia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">epistemologia.discernimiento_de_orientacion_hacia_la_verdad.tesis_central</hasSourcePath>
    <hasText xml:lang="es">La verdad absoluta no puede ser poseida por una conciencia finita, pero si pueden distinguirse orientaciones mas reales o mas falsas hacia ella segun su relacion con la moral intrahumana, la coherencia, la realidad, la exergia y la persistencia historica de sus efectos.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#epistemologia_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#epistemologia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#epistemologia"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#epistemologia"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#epistemologia"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">epistemologia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">epistemologia.tesis_central</hasSourcePath>
    <hasText xml:lang="es">Conocer no equivale necesariamente a liberarse. Existe un conocimiento que abre capas de verdad y otro que solo perfecciona la dominacion.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#etica_dano_tragico_y_residuo_moral_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#etica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#etica"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#dano_tragico_y_residuo_moral"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#dano_tragico_y_residuo_moral"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">etica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">etica.dano_tragico_y_residuo_moral.tesis_central</hasSourcePath>
    <hasText xml:lang="es">Todo daño directo deliberado deja una mancha o residuo moral incluso cuando resulta tragicamente necesario; su permisibilidad depende de que reduzca una captura mayor sin consolidar el mismo patron que combate.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#etica_etica_organizativa_exergista_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#etica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#etica"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#etica_organizativa_exergista"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#etica_organizativa_exergista"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">etica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">etica.etica_organizativa_exergista.tesis_central</hasSourcePath>
    <hasText xml:lang="es">La preservacion exergica de una organizacion no depende solo de sus fines declarados, sino de su capacidad institucional para revisar, rotar, transparentar, deliberar y corregirse sin perder eficacia estrategica ni convertir el desacuerdo en enemistad automatica.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#etica_poder_liberador_y_demiurgico_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#etica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#etica"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#poder_liberador_y_demiurgico"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#poder_liberador_y_demiurgico"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">etica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">etica.poder_liberador_y_demiurgico.tesis_central</hasSourcePath>
    <hasText xml:lang="es">La fuerza, el secreto, la disciplina, la estrategia y la organizacion pueden aparecer en ambos tipos de poder; la frontera real esta en si esas herramientas se subordinan a la liberacion o a la captura.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#etica_primacia_axiologica_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#etica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#etica"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#primacia_axiologica"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#primacia_axiologica"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">etica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">etica.primacia_axiologica.tesis_central</hasSourcePath>
    <hasText xml:lang="es">La verdad tiene primacia estructural porque funda la liberacion real; la ruptura del ciclo tiene primacia estrategica cuando preserva condiciones de verdad futura; la reduccion del sufrimiento opera como limite modulador y criterio de minimizacion, pero no como principio supremo absoluto.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#etica_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#etica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#etica"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#etica"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#etica"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">etica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">etica.tesis_central</hasSourcePath>
    <hasText xml:lang="es">El bien y el mal no son absolutos cosmicos, pero si categorias objetivas dentro del dominio humano; su juicio exige integrar verdad, ruptura del ciclo, sufrimiento, responsabilidad, exergia y riesgo de captura.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#etica_verdad_y_comunicacion_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#etica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#etica"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#verdad_y_comunicacion"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#verdad_y_comunicacion"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">etica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">etica.verdad_y_comunicacion.tesis_central</hasSourcePath>
    <hasText xml:lang="es">Una verdad dicha sin tacto puede seguir siendo verdadera y en ciertos casos moralmente necesaria, pero la forma de comunicarla debe orientarse a minimizar sufrimiento evitable sin caer en mentira protectora o manipulacion compasiva.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#filosofia_politica_aceleracionismo_anti_demiurgico_estructura_durante_la_sociedad_liberada_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#durante_la_sociedad_liberada"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#durante_la_sociedad_liberada"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.aceleracionismo_anti_demiurgico.estructura.durante_la_sociedad_liberada.tesis_central</hasSourcePath>
    <hasText xml:lang="es">En una sociedad liberada la aceleracion solo es legitima cuando amplifica capacidades emancipadoras sin degradar autonomia, sin concentrar poder y sin abrir nuevas formas de dominacion.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#filosofia_politica_aceleracionismo_anti_demiurgico_estructura_durante_la_transicion_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#durante_la_transicion"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#durante_la_transicion"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.aceleracionismo_anti_demiurgico.estructura.durante_la_transicion.tesis_central</hasSourcePath>
    <hasText xml:lang="es">Escapar del demiurgo con el conjunto de la humanidad puede exigir atravesar procesos duros, tragicos y desordenados que no serian admisibles como norma en una sociedad ya emancipada.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#filosofia_politica_etica_de_transicion_dimension_tragica_tesis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#dimension_tragica"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#dimension_tragica"/>
    <hasName xml:lang="es">Tesis</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.etica_de_transicion.dimension_tragica.tesis</hasSourcePath>
    <hasText xml:lang="es">La tragedia historica no purifica las acciones ni las vuelve buenas por si mismas; solo describe el hecho de que, en ciertos contextos, no existe salida sin costes severos.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#filosofia_politica_etica_de_transicion_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#etica_de_transicion"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#etica_de_transicion"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.etica_de_transicion.tesis_central</hasSourcePath>
    <hasText xml:lang="es">La etica de transicion no coincide plenamente con la etica de una sociedad liberada, porque romper una estructura de captura puede exigir atravesar procesos tragicos, duros y desordenados que no serian admisibles como norma estable en un orden ya emancipado.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#filosofia_politica_instituciones_grados_de_demiurgicidad_tesis_general">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis general</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#grados_de_demiurgicidad"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#grados_de_demiurgicidad"/>
    <hasName xml:lang="es">Tesis general</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.instituciones.grados_de_demiurgicidad.tesis_general</hasSourcePath>
    <hasText xml:lang="es">La mayor parte de las instituciones hoy existentes son demiurgicas en algun grado, debido a su origen historico en estructuras estatales, imperiales, oligárquicas, burocraticas o transnacionales marcadas por concentracion, representacion sustitutiva, razon de Estado, interes geopolitico o captura tecnocratica.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_general</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#filosofia_politica_justicia_derechos_minimos_de_toda_conciencia_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#derechos_minimos_de_toda_conciencia"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#derechos_minimos_de_toda_conciencia"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.justicia.derechos_minimos_de_toda_conciencia.tesis_central</hasSourcePath>
    <hasText xml:lang="es">Los derechos minimos no proceden solo de pertenecer a una especie o a un orden juridico, sino del hecho de ser conciencia en algun grado moralmente relevante.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#filosofia_politica_modelo_de_sociedad_liberada_rasgos_estructurales_economia_y_autonomia_material_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#economia_y_autonomia_material"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#economia_y_autonomia_material"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.modelo_de_sociedad_liberada.rasgos_estructurales.economia_y_autonomia_material.tesis_central</hasSourcePath>
    <hasText xml:lang="es">La economia debe servir a la vida liberada y no convertirse en soberana de la sociedad. El capitalismo, si subsiste, solo puede hacerlo reducido a instrumento economico limitado, subordinado a justicia, universalidad, autonomia material y no captura.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#filosofia_politica_modelo_de_sociedad_liberada_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#modelo_de_sociedad_liberada"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#modelo_de_sociedad_liberada"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.modelo_de_sociedad_liberada.tesis_central</hasSourcePath>
    <hasText xml:lang="es">La liberacion colectiva no consiste solo en destruir instituciones opresivas, sino en construir una forma de vida comun donde la exergia social se oriente de manera estable hacia verdad, autonomia, justicia, creacion, universalidad y cooperacion no capturada.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#filosofia_politica_relacion_con_los_sistemas_politicos_existentes_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#relacion_con_los_sistemas_politicos_existentes"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#relacion_con_los_sistemas_politicos_existentes"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.relacion_con_los_sistemas_politicos_existentes.tesis_central</hasSourcePath>
    <hasText xml:lang="es">Todo sistema que dependa de concentracion de poder, opacidad decisional, mediacion oligárquica, captura economica, monopolio simbolico o administracion de la participacion como simulacro tendera a percibir al exergismo como amenaza.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#filosofia_politica_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.tesis_central</hasSourcePath>
    <hasText xml:lang="es">La sociedad humana tiende a reproducir estructuras demiurgicas de dominacion por la fuerza de los instintos y la capacidad de ciertas personas de instrumentalizar el conocimiento social.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#metodo_filosofico_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#metodo_filosofico"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#metodo_filosofico"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#metodo_filosofico"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#metodo_filosofico"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metodo_filosofico.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metodo_filosofico.tesis_central</hasSourcePath>
    <hasText xml:lang="es">El pensamiento filosofico valido no debe limitarse a interpretar conceptos ni a producir sistemas internamente bellos, sino que debe aumentar verdad parcial, reducir error, resistir captura, integrar niveles de realidad y orientar transformacion real sin confundir intuicion, poder o intensidad con verdad.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#ontologia_estructura_de_lo_real_niveles_emergentes_vida_tesis_emergentista">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis emergentista</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#ontologia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#ontologia"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#vida"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#vida"/>
    <hasName xml:lang="es">Tesis emergentista</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia.estructura_de_lo_real.niveles_emergentes.vida.tesis_emergentista</hasSourcePath>
    <hasText xml:lang="es">La vida no constituye una sustancia separada de la materia, sino una configuracion emergente de esta cuando alcanza formas de organizacion capaces de sostener orden relativo, transformacion interna, reproduccion diferencial y apertura evolutiva.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_emergentista</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#ontologia_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#ontologia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#ontologia"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#realidad"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#realidad"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia.tesis_central</hasSourcePath>
    <hasText xml:lang="es">La realidad total existe como verdad absoluta. El ser humano, como caso particular de conciencia reflexiva, solo puede acceder a capas parciales de ella.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#psicologia_moral_ciclo_del_mal_tesis_psicologica">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis psicologica</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#psicologia_moral"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#psicologia_moral"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#ciclo_del_mal"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#ciclo_del_mal"/>
    <hasName xml:lang="es">Tesis psicologica</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">psicologia_moral.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">psicologia_moral.ciclo_del_mal.tesis_psicologica</hasSourcePath>
    <hasText xml:lang="es">El ciclo del mal no es solo una serie externa de actos dañinos, sino tambien una mecanica psiquica compuesta por heridas no elaboradas, emociones enquistadas, narrativas legitimadoras y habitos de respuesta que transmiten el daño entre sujetos y generaciones.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_psicologica</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#psicologia_moral_instrumentalizacion_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#psicologia_moral"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#psicologia_moral"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#instrumentalizacion"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#instrumentalizacion"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">psicologia_moral.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">psicologia_moral.instrumentalizacion.tesis_central</hasSourcePath>
    <hasText xml:lang="es">No hace falta deshumanizar completamente a alguien para dañarlo de forma grave; basta con subordinarlo practicamente a fines ajenos y tratarlo como instrumento.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#psicologia_moral_interpretacion_moral_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#psicologia_moral"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#psicologia_moral"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#interpretacion_moral"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#interpretacion_moral"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">psicologia_moral.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">psicologia_moral.interpretacion_moral.tesis_central</hasSourcePath>
    <hasText xml:lang="es">La emocion moral nunca opera sola: siempre esta mediada por una lectura de la situacion que puede acercar a una comprension lucida o degradarse en simplificacion, demonizacion y captura.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#psicologia_moral_ruptura_del_ciclo_tesis_psicologica">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis psicologica</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#psicologia_moral"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#psicologia_moral"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#ruptura_del_ciclo"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#ruptura_del_ciclo"/>
    <hasName xml:lang="es">Tesis psicologica</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">psicologia_moral.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">psicologia_moral.ruptura_del_ciclo.tesis_psicologica</hasSourcePath>
    <hasText xml:lang="es">Romper el ciclo exige transformar afectos, relatos, impulsos y habitos de respuesta, no solo condenar intelectualmente el daño.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_psicologica</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#psicologia_moral_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#psicologia_moral"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#psicologia_moral"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#psicologia_moral"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#psicologia_moral"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">psicologia_moral.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">psicologia_moral.tesis_central</hasSourcePath>
    <hasText xml:lang="es">La psicologia moral estudia como las reacciones instintivas, las emociones, las interpretaciones y los mecanismos de autojustificacion configuran la percepcion humana del bien y del mal, y como esas dinamicas pueden tanto reproducir como interrumpir ciclos de daño, dominacion y sufrimiento.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#soteriologia_o_teoria_de_la_liberacion_liberacion_de_la_humanidad_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#soteriologia_o_teoria_de_la_liberacion"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#soteriologia_o_teoria_de_la_liberacion"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#liberacion_de_la_humanidad"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#liberacion_de_la_humanidad"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soteriologia_o_teoria_de_la_liberacion.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soteriologia_o_teoria_de_la_liberacion.liberacion_de_la_humanidad.tesis_central</hasSourcePath>
    <hasText xml:lang="es">Una liberacion parcial que deje a la mayor parte de la humanidad atrapada en el ciclo sigue siendo incompleta desde el punto de vista exergico y espiritual.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#soteriologia_o_teoria_de_la_liberacion_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#soteriologia_o_teoria_de_la_liberacion"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#soteriologia_o_teoria_de_la_liberacion"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#liberacion"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#liberacion"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soteriologia_o_teoria_de_la_liberacion.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soteriologia_o_teoria_de_la_liberacion.tesis_central</hasSourcePath>
    <hasText xml:lang="es">Trascender no es alcanzar la verdad absoluta, sino abrir capas hacia ella y ayudar a otros a hacer lo mismo.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#teologia_o_metafisica_religiosa_escatologia_exergica_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#teologia_o_metafisica_religiosa"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#teologia_o_metafisica_religiosa"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#escatologia_exergica"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#escatologia_exergica"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teologia_o_metafisica_religiosa.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teologia_o_metafisica_religiosa.escatologia_exergica.tesis_central</hasSourcePath>
    <hasText xml:lang="es">La liberacion autentica no debe detenerse en individuos aislados ni en comunidades parciales, sino tender a la liberacion progresiva del conjunto de la humanidad como sujeto historico capaz de verdad, autonomia y cooperacion no capturada.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#teoria_de_la_exergia_fundamento_y_relaciones_principales_relacion_con_la_verdad_absoluta_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#relacion_con_la_verdad_absoluta"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#relacion_con_la_verdad_absoluta"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.fundamento_y_relaciones_principales.relacion_con_la_verdad_absoluta.tesis_central</hasSourcePath>
    <hasText xml:lang="es">La exergia no sustituye a la verdad absoluta, sino que mide el margen real que un sistema tiene para aproximarse a ella, expresarla o encarnarla historicamente.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#teoria_de_la_exergia_integraciones_sistemicas_integracion_con_el_aceleracionismo_anti_demiurgico_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#integracion_con_el_aceleracionismo_anti_demiurgico"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#integracion_con_el_aceleracionismo_anti_demiurgico"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.integraciones_sistemicas.integracion_con_el_aceleracionismo_anti_demiurgico.tesis_central</hasSourcePath>
    <hasText xml:lang="es">El aceleracionismo anti-demiurgico no consiste solo en intensificar el cambio, sino en aumentar o liberar exergia historica, social, institucional y consciente para que la ruptura del ciclo sea realmente posible y quede orientada hacia la verdad.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#teoria_de_la_exergia_integraciones_sistemicas_integracion_con_el_cambio_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#integracion_con_el_cambio"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#integracion_con_el_cambio"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.integraciones_sistemicas.integracion_con_el_cambio.tesis_central</hasSourcePath>
    <hasText xml:lang="es">El cambio necesita exergia para ser historicamente efectivo. Sin exergia, el cambio puede existir como ruido, destruccion o desplazamiento superficial, pero no como transformacion liberadora duradera.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#teoria_de_la_exergia_integraciones_sistemicas_integracion_con_el_escape_del_demiurgo_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#integracion_con_el_escape_del_demiurgo"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#integracion_con_el_escape_del_demiurgo"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.integraciones_sistemicas.integracion_con_el_escape_del_demiurgo.tesis_central</hasSourcePath>
    <hasText xml:lang="es">El escape del demiurgo es un proceso exergico: consiste en recuperar, proteger y reorientar la potencia capturada por el ciclo hacia una vida mas verdadera, libre y autoconsciente.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#teoria_de_la_exergia_integraciones_sistemicas_integracion_con_la_verdad_absoluta_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#integracion_con_la_verdad_absoluta"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#integracion_con_la_verdad_absoluta"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.integraciones_sistemicas.integracion_con_la_verdad_absoluta.tesis_central</hasSourcePath>
    <hasText xml:lang="es">La verdad absoluta es el horizonte total de lo real; la exergia es la capacidad finita de una conciencia o una sociedad para orientarse activamente hacia ese horizonte sin quedar fijada por el ciclo.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#teoria_de_la_exergia_lectura_negativa_del_exergismo_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#lectura_negativa_del_exergismo"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#lectura_negativa_del_exergismo"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.lectura_negativa_del_exergismo.tesis_central</hasSourcePath>
    <hasText xml:lang="es">Todo conocimiento exergico puede ser leido en clave liberadora o en clave demiurgica. En la segunda, el problema no es como liberar potencia capturada, sino como capturar mas potencia, protegerla de la disidencia y dirigirla hacia una dominacion mas eficiente, profunda y durable.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#teoria_de_la_exergia_relacion_con_el_demiurgo_y_la_liberacion_motivo_del_escape_del_demiurgo_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#motivo_del_escape_del_demiurgo"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#motivo_del_escape_del_demiurgo"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.relacion_con_el_demiurgo_y_la_liberacion.motivo_del_escape_del_demiurgo.tesis_central</hasSourcePath>
    <hasText xml:lang="es">El motivo ultimo del escape no es solo huir del sufrimiento o del control, sino liberar la potencia humana secuestrada por el ciclo y volver a ponerla al servicio de la verdad.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#teoria_de_la_historia_escatologia_ruptura_final_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#teoria_de_la_historia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#teoria_de_la_historia"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#ruptura_final"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#ruptura_final"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_historia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_historia.escatologia.ruptura_final.tesis_central</hasSourcePath>
    <hasText xml:lang="es">El fin del universo es compatible con una tarea historica de liberacion. La finitud cosmica no anula el valor de la lucha consciente; al contrario, vuelve mas urgente la orientacion exergica de la vida, la historia y la civilizacion.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#teoria_de_la_historia_escatologia_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#teoria_de_la_historia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#teoria_de_la_historia"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#escatologia"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#escatologia"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_historia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_historia.escatologia.tesis_central</hasSourcePath>
    <hasText xml:lang="es">La historia no debe pensarse solo como repeticion indefinida del ciclo, sino tambien como posibilidad real de ruptura creciente, ampliacion de conciencia y reorganizacion no demiurgica, aunque todo ello permanezca inscrito en un universo material destinado a agotarse.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#teoria_de_la_historia_tesis_central">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Thesis"/>
    <rdfs:label xml:lang="es">Tesis central</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#teoria_de_la_historia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#teoria_de_la_historia"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#historia"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#historia"/>
    <hasName xml:lang="es">Tesis central</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_historia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_historia.tesis_central</hasSourcePath>
    <hasText xml:lang="es">El ciclo demiurgico acompaña a la humanidad desde mucho antes que se formalizaran las primeras religiones con deidades absolutistas y atraviesa toda su historia.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tesis_central</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#axioma_provisional_01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Axiom"/>
    <rdfs:label xml:lang="es">Axioma provisional 01</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <hasName xml:lang="es">Axioma provisional 01</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales[0]</hasSourcePath>
    <hasText xml:lang="es">Existe una verdad absoluta que excede toda comprension humana total.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales</jsonKey>
    <orderIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</orderIndex>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#axioma_provisional_02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Axiom"/>
    <rdfs:label xml:lang="es">Axioma provisional 02</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <hasName xml:lang="es">Axioma provisional 02</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales[1]</hasSourcePath>
    <hasText xml:lang="es">El ser humano esta orientado hacia esa verdad aunque nunca pueda poseerla plenamente.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales</jsonKey>
    <orderIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</orderIndex>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#axioma_provisional_03">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Axiom"/>
    <rdfs:label xml:lang="es">Axioma provisional 03</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <hasName xml:lang="es">Axioma provisional 03</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales[2]</hasSourcePath>
    <hasText xml:lang="es">La libertad es la apertura fundamental de la realidad, y el cambio es una de sus expresiones esenciales.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales</jsonKey>
    <orderIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</orderIndex>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#axioma_provisional_04">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Axiom"/>
    <rdfs:label xml:lang="es">Axioma provisional 04</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <hasName xml:lang="es">Axioma provisional 04</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales[3]</hasSourcePath>
    <hasText xml:lang="es">La exergia mide el margen efectivo de una conciencia o una sociedad para orientarse hacia la verdad y convertir apertura en transformacion real.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales</jsonKey>
    <orderIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</orderIndex>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#axioma_provisional_05">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Axiom"/>
    <rdfs:label xml:lang="es">Axioma provisional 05</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <hasName xml:lang="es">Axioma provisional 05</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales[4]</hasSourcePath>
    <hasText xml:lang="es">Una orientacion real hacia la verdad absoluta se distingue de una proyeccion refinada de preferencias cuando supera filtros morales intrahumanos, epistemicos, exergicos e historico-temporales.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales</jsonKey>
    <orderIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</orderIndex>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#axioma_provisional_06">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Axiom"/>
    <rdfs:label xml:lang="es">Axioma provisional 06</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <hasName xml:lang="es">Axioma provisional 06</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales[5]</hasSourcePath>
    <hasText xml:lang="es">Conocer el mecanismo del mundo no implica liberarse; puede servir tambien para dominar.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales</jsonKey>
    <orderIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</orderIndex>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#axioma_provisional_07">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Axiom"/>
    <rdfs:label xml:lang="es">Axioma provisional 07</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <hasName xml:lang="es">Axioma provisional 07</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales[6]</hasSourcePath>
    <hasText xml:lang="es">El mundo humano genera estructuras de alienacion, poder y repeticion que constituyen la carcel del mundo.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales</jsonKey>
    <orderIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</orderIndex>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#axioma_provisional_08">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Axiom"/>
    <rdfs:label xml:lang="es">Axioma provisional 08</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <hasName xml:lang="es">Axioma provisional 08</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales[7]</hasSourcePath>
    <hasText xml:lang="es">El demiurgo no es un absoluto cosmico sino una abstraccion estructural de la naturaleza animal humana socializada.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales</jsonKey>
    <orderIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</orderIndex>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#axioma_provisional_09">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Axiom"/>
    <rdfs:label xml:lang="es">Axioma provisional 09</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <hasName xml:lang="es">Axioma provisional 09</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales[8]</hasSourcePath>
    <hasText xml:lang="es">El bien y el mal no son absolutos cosmicos, pero si categorias objetivas dentro del dominio humano.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales</jsonKey>
    <orderIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</orderIndex>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#axioma_provisional_10">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Axiom"/>
    <rdfs:label xml:lang="es">Axioma provisional 10</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <hasName xml:lang="es">Axioma provisional 10</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales[9]</hasSourcePath>
    <hasText xml:lang="es">Es malo lo que perpetua conscientemente o estructuralmente el ciclo de ignorancia, dominacion y sufrimiento.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales</jsonKey>
    <orderIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</orderIndex>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#axioma_provisional_11">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Axiom"/>
    <rdfs:label xml:lang="es">Axioma provisional 11</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <hasName xml:lang="es">Axioma provisional 11</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales[10]</hasSourcePath>
    <hasText xml:lang="es">Es bueno lo que abre capas de verdad, reduce dominacion, protege exergia y favorece trascendencia.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales</jsonKey>
    <orderIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</orderIndex>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#axioma_provisional_12">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Axiom"/>
    <rdfs:label xml:lang="es">Axioma provisional 12</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <hasName xml:lang="es">Axioma provisional 12</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales[11]</hasSourcePath>
    <hasText xml:lang="es">La autonomia humana no garantiza bondad, pero hace posible una responsabilidad mas real en el uso del poder.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales</jsonKey>
    <orderIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</orderIndex>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#axioma_provisional_13">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Axiom"/>
    <rdfs:label xml:lang="es">Axioma provisional 13</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <hasName xml:lang="es">Axioma provisional 13</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales[12]</hasSourcePath>
    <hasText xml:lang="es">El poder no es malo en si mismo; se vuelve demiurgico cuando se autonomiza, concentra y deja de estar subordinado a la verdad, la justicia y la autonomia compartida.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales</jsonKey>
    <orderIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</orderIndex>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#axioma_provisional_14">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Axiom"/>
    <rdfs:label xml:lang="es">Axioma provisional 14</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#axiomas_provisionales"/>
