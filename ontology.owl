    <relatedTo rdf:resource="https://id.exergism.org/exergism#exergia"/>
    <field_definicion xml:lang="es">Fase historica en la que la humanidad, habiendo reducido significativamente sus fracturas internas, orienta parte de su exergia colectiva hacia la exploracion cosmica, la ampliacion del conocimiento y la comunicacion con otras posibles inteligencias.</field_definicion>
    <field_nombre xml:lang="es">era de la humanidad cosmica</field_nombre>
    <hasDefinition xml:lang="es">Fase historica en la que la humanidad, habiendo reducido significativamente sus fracturas internas, orienta parte de su exergia colectiva hacia la exploracion cosmica, la ampliacion del conocimiento y la comunicacion con otras posibles inteligencias.</hasDefinition>
    <hasName xml:lang="es">Segunda etapa</hasName>
    <hasName xml:lang="es">era de la humanidad cosmica</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_historia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_historia.escatologia.segunda_etapa</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">segunda_etapa</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#segunda_fase">
