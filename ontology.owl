  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#justicia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Justicia</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <develops rdf:resource="https://id.exergism.org/exergism#modelo_de_sociedad_liberada"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#derechos_minimos_de_toda_conciencia"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#dignidad"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#derechos_humanos"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#proteccion"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#reparacion"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#rehabilitacion"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#integracion"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#contencion"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#tratamiento_del_conflicto"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#respuesta_frente_a_agentes_demiurgicos_persistentes"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#condena_perpetua"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#filosofia_politica_modelo_de_sociedad_liberada_rasgos_estructurales_justicia"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#derechos_minimos_de_toda_conciencia"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#dignidad"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#derechos_humanos"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#filosofia_politica_justicia_funciones"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#tratamiento_del_conflicto"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#respuesta_frente_a_agentes_demiurgicos_persistentes"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#condena_perpetua"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#filosofia_politica_justicia_principios_collection"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#filosofia_politica_justicia_riesgos_collection"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <field_criterio_de_juicio xml:lang="es">La justicia debe evaluarse por el grado en que protege a los vulnerables, reduce dano y dominacion, abre posibilidad real de rehabilitacion, evita recaidas y contiene con el minimo daño necesario a quienes sigan impulsando captura o violencia sistematica.</field_criterio_de_juicio>
    <field_definicion xml:lang="es">Ordenacion de las relaciones humanas de forma que reduzcan dominacion, contengan la captura del poder y favorezcan apertura de conciencia, acceso al conocimiento, resolucion no destructiva del conflicto, rehabilitacion e integracion, sin renunciar a la defensa de la sociedad frente a intentos persistentes de reinstaurar el ciclo.</field_definicion>
    <field_direccion_general xml:lang="es">En este sistema, la justicia es por principio rehabilitadora e integradora, porque una sociedad liberada debe intentar recuperar a la conciencia desviada antes que destruirla, humillarla o abandonarla definitivamente al papel de enemiga.</field_direccion_general>
    <field_estado_ontologico xml:lang="es">principio politico-moral de organizacion del conflicto, del dano, de la responsabilidad y de la reparacion dentro del dominio humano</field_estado_ontologico>
    <field_fundamento xml:lang="es">La justicia no debe orientarse primariamente a la venganza ni a la administracion fria del castigo, sino a interrumpir ciclos de dano, proteger a los seres conscientes, limitar la dominacion y crear condiciones de rehabilitacion e integracion siempre que estas sigan siendo realmente posibles.</field_fundamento>
    <field_injusticia xml:lang="es">Toda estructura, entidad o acto que cronifica ignorancia, opresion y uso instrumental de otros seres conscientes.</field_injusticia>
    <field_relacion_con_la_sociedad_liberada xml:lang="es">Una sociedad liberada no puede basar su justicia en terror, venganza o castigo ejemplarizante ilimitado. Debe ser mas fuerte precisamente porque puede defenderse sin renunciar a limites morales.</field_relacion_con_la_sociedad_liberada>
    <hasDefinition xml:lang="es">Ordenacion de las relaciones humanas de forma que reduzcan dominacion, contengan la captura del poder y favorezcan apertura de conciencia, acceso al conocimiento, resolucion no destructiva del conflicto, rehabilitacion e integracion, sin renunciar a la defensa de la sociedad frente a intentos persistentes de reinstaurar el ciclo.</hasDefinition>
    <hasName xml:lang="es">Justicia</hasName>
    <hasOntologicalStatus xml:lang="es">principio politico-moral de organizacion del conflicto, del dano, de la responsabilidad y de la reparacion dentro del dominio humano</hasOntologicalStatus>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.justicia</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">justicia</jsonKey>
  </owl:NamedIndividual>

