    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#autodefensa_frente_a_la_recaptura"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#criterios_de_legitimidad"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#dimension_tragica"/>
