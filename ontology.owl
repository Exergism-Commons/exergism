  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#revelacion_demiurgica">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Revelacion demiurgica</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#epistemologia"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#tipos_de_conocimiento"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#epistemologia"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#tipos_de_conocimiento"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#tipos_de_conocimiento"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#ser_humano"/>
    <field_definicion xml:lang="es">Comprension del funcionamiento del mundo humano, sus estructuras y su psicologia, usada para manipular y dominar.</field_definicion>
    <field_efecto xml:lang="es">Aumenta el poder dentro de la carcel, pero no libera de ella.</field_efecto>
    <hasDefinition xml:lang="es">Comprension del funcionamiento del mundo humano, sus estructuras y su psicologia, usada para manipular y dominar.</hasDefinition>
    <hasName xml:lang="es">Revelacion demiurgica</hasName>
