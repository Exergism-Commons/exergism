    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#autonomia"/>
    <field_definicion xml:lang="es">El encuentro con otras formas de inteligencia deberia orientarse a conocimiento reciproco, cooperacion libre y ampliacion comun de comprension, no a conquista, absorcion o imposicion doctrinal.</field_definicion>
    <field_principio_de_traduccion_moral xml:lang="es">El encuentro con otras formas de inteligencia exigiria construir sistemas de traduccion moral entre conciencias distintas, partiendo de minimos compartidos de daño, apertura, evitacion, cooperacion y autonomia, sin imponer sin mas la moral humana como universal cerrada.</field_principio_de_traduccion_moral>
    <hasDefinition xml:lang="es">El encuentro con otras formas de inteligencia deberia orientarse a conocimiento reciproco, cooperacion libre y ampliacion comun de comprension, no a conquista, absorcion o imposicion doctrinal.</hasDefinition>
    <hasName xml:lang="es">Relacion con otras inteligencias</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soteriologia_o_teoria_de_la_liberacion.json</hasSourceFile>
