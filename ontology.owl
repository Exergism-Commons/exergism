  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#transformacion_institucional">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Transformacion institucional</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#cambio_social"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#filosofia_politica_cambio_social_mecanismos_transformacion_institucional_formas_collection"/>
    <hasSubtype rdf:resource="https://id.exergism.org/exergism#mechanism"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#filosofia_politica_cambio_social_mecanismos"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#cambio_social"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#instituciones"/>
    <field_definicion xml:lang="es">Reorganizacion de normas, procedimientos, incentivos y estructuras estables para que dejen de reproducir servidumbre y aumenten autocorreccion, transparencia y responsabilidad compartida.</field_definicion>
    <field_funcion_transformadora xml:lang="es">Convertir la ruptura inicial en forma durable sin cristalizar una nueva dominacion.</field_funcion_transformadora>
    <field_relacion_con_las_instituciones xml:lang="es">Sin transformacion institucional, el cambio social queda expuesto a disipacion, recaida o apropiacion por nuevas elites.</field_relacion_con_las_instituciones>
    <hasDefinition xml:lang="es">Reorganizacion de normas, procedimientos, incentivos y estructuras estables para que dejen de reproducir servidumbre y aumenten autocorreccion, transparencia y responsabilidad compartida.</hasDefinition>
    <hasName xml:lang="es">Transformacion institucional</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.cambio_social.mecanismos.transformacion_institucional</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">transformacion_institucional</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#transparencia_total">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Transparencia total</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#institucion_no_demiurgica"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#filosofia_politica_instituciones_institucion_no_demiurgica_arquitectura_basica"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#institucion_no_demiurgica"/>
    <field_definicion xml:lang="es">Toda decision, procedimiento, revision, flujo de propuesta, criterio de priorizacion, uso de recursos y cadena de deliberacion debe ser visible, auditable y comprensible para el conjunto de la institucion, salvo excepciones defensivas muy restringidas y justificadas.</field_definicion>
    <field_funcion xml:lang="es">Impedir opacidad estructural, limitar captura de informacion y hacer criticable toda forma de poder interno.</field_funcion>
    <hasDefinition xml:lang="es">Toda decision, procedimiento, revision, flujo de propuesta, criterio de priorizacion, uso de recursos y cadena de deliberacion debe ser visible, auditable y comprensible para el conjunto de la institucion, salvo excepciones defensivas muy restringidas y justificadas.</hasDefinition>
    <hasName xml:lang="es">Transparencia total</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.instituciones.institucion_no_demiurgica.arquitectura_basica.transparencia_total</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">transparencia_total</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#trascendencia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Trascendencia</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#soteriologia_o_teoria_de_la_liberacion"/>
