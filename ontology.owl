    <hasConcept rdf:resource="https://id.exergism.org/exergism#relacion_con_los_dominios_del_conocimiento_humano"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#relacion_con_la_ciencia"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#relacion_con_la_espiritualidad"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#relacion_con_la_exergia"/>
    <hasConcept rdf:resource="https://id.exergism.org/exergism#relacion_con_la_moral_intrahumana"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#capas_del_metodo"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#protocolo_de_discernimiento_de_verdad_parcial"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#criterios_de_validez"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#relacion_con_los_dominios_del_conocimiento_humano"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#relacion_con_la_ciencia"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#relacion_con_la_espiritualidad"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#relacion_con_la_exergia"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#relacion_con_la_moral_intrahumana"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#metodo_filosofico_fuentes_collection"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#metodo_filosofico_principios_metodologicos_collection"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#metodo_filosofico_procedimiento_general_collection"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#metodo_filosofico_vicios_metodologicos_a_evitar_collection"/>
    <hasPart rdf:resource="https://id.exergism.org/exergism#metodo_filosofico_tesis_central"/>
    <hasThesis rdf:resource="https://id.exergism.org/exergism#metodo_filosofico_tesis_central"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#exergia"/>
    <field_definicion xml:lang="es">Metodo de construccion, evaluacion y correccion filosofica que integra introspeccion, analisis conceptual, observacion historica, contraste empirico, discernimiento moral, evaluacion exergica y dialogo critico con cualquier dominio del conocimiento humano.</field_definicion>
    <field_funcion_general xml:lang="es">Actuar como metodo de segundo orden capaz de examinar, articular, criticar e integrar conocimientos, practicas, simbolos, instituciones y experiencias procedentes de dominios distintos, evaluando su orientacion hacia verdad, su riesgo de captura y su potencia exergica real.</field_funcion_general>
    <field_limite xml:lang="es">El metodo no garantiza acceso total a la verdad absoluta, solo aperturas parciales, revisables y situadas. Su validez depende de su capacidad de autocorreccion, de su resistencia a captura y de su dialogo honesto con la realidad y con otros dominios del saber.</field_limite>
    <hasDefinition xml:lang="es">Metodo de construccion, evaluacion y correccion filosofica que integra introspeccion, analisis conceptual, observacion historica, contraste empirico, discernimiento moral, evaluacion exergica y dialogo critico con cualquier dominio del conocimiento humano.</hasDefinition>
    <hasName xml:lang="es">Metodo filosofico</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metodo_filosofico.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metodo_filosofico</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metodo_filosofico</jsonKey>
  </owl:NamedIndividual>

