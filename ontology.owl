    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">epistemologia.tipos_de_conocimiento.revelacion_demiurgica</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">revelacion_demiurgica</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#riqueza_y_recompensa">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Riqueza y recompensa</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#economia_y_autonomia_material"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#economia_y_autonomia_material"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#economia_y_autonomia_material"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#materia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#ser_humano"/>
    <field_criterio xml:lang="es">La riqueza es legitima mientras no erosione universalidad, no capture instituciones y no convierta diferencia economica en dominacion estructural.</field_criterio>
    <field_definicion xml:lang="es">Los individuos pueden acceder a riqueza y ser premiados por creacion, trabajo, invencion, responsabilidad o aportacion, pero esa riqueza no debe adquirir escala capaz de separarles radicalmente del resto del cuerpo social ni de convertirles en centros de poder cuasi soberano.</field_definicion>
    <field_limite xml:lang="es">Ningun humano debe acumular niveles de riqueza maximalistas capaces de producir captura de sectores enteros, influencia desproporcionada sobre decision politica o dependencia material masiva de otros respecto a su posicion.</field_limite>
    <hasDefinition xml:lang="es">Los individuos pueden acceder a riqueza y ser premiados por creacion, trabajo, invencion, responsabilidad o aportacion, pero esa riqueza no debe adquirir escala capaz de separarles radicalmente del resto del cuerpo social ni de convertirles en centros de poder cuasi soberano.</hasDefinition>
    <hasName xml:lang="es">Riqueza y recompensa</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.modelo_de_sociedad_liberada.rasgos_estructurales.economia_y_autonomia_material.riqueza_y_recompensa</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">riqueza_y_recompensa</jsonKey>
  </owl:NamedIndividual>

