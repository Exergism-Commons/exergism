    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <field_definicion xml:lang="es">Modo practico en que una conciencia traduce su reaccion, su emocion y su interpretacion moral en conducta, decision, omision o forma de relacion con otros.</field_definicion>
    <field_importancia xml:lang="es">La diferencia decisiva entre reproduccion y ruptura del ciclo no se juega solo en lo que se siente o se piensa, sino en la forma concreta de responder.</field_importancia>
    <hasDefinition xml:lang="es">Modo practico en que una conciencia traduce su reaccion, su emocion y su interpretacion moral en conducta, decision, omision o forma de relacion con otros.</hasDefinition>
    <hasName xml:lang="es">Respuesta moral</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">psicologia_moral.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">psicologia_moral.respuesta_moral</hasSourcePath>
