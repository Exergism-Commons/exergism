    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales[13]</hasSourcePath>
    <hasText xml:lang="es">Cualquier persona puede reproducir el ciclo demiurgico si accede a poder y no lo trasciende.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales</jsonKey>
    <orderIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</orderIndex>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#axioma_provisional_15">
