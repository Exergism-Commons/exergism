    <relatedTo rdf:resource="https://id.exergism.org/exergism#materia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#autonomia"/>
    <field_definicion xml:lang="es">La tecnologia debe emplearse para aumentar participacion, memoria colectiva, autonomia material, proteccion de la privacidad, auditabilidad institucional y distribucion del conocimiento.</field_definicion>
    <field_limite xml:lang="es">No debe convertirse en nueva forma de captura tecnica, vigilancia total o monopolio cognitivo de especialistas.</field_limite>
    <hasDefinition xml:lang="es">La tecnologia debe emplearse para aumentar participacion, memoria colectiva, autonomia material, proteccion de la privacidad, auditabilidad institucional y distribucion del conocimiento.</hasDefinition>
    <hasName xml:lang="es">Tecnologia</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
