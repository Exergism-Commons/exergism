  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#dignidad">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Dignidad</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#justicia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#filosofia_politica"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#derechos_minimos_de_toda_conciencia"/>
    <grounds rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#justicia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#justicia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#autonomia"/>
    <field_definicion xml:lang="es">Condicion por la cual una conciencia no puede ser reducida legitimamente a simple instrumento, recurso o objeto administrable, porque constituye un foco real de experiencia, vulnerabilidad y posible apertura.</field_definicion>
    <field_relacion_con_la_autonomia xml:lang="es">La dignidad exige no solo evitar daño extremo, sino preservar las condiciones desde las que una conciencia puede ejercer o recuperar algun grado de autonomia real.</field_relacion_con_la_autonomia>
    <field_relacion_con_los_derechos_minimos xml:lang="es">La dignidad da fundamento practico al reconocimiento de derechos minimos, porque expresa la improcedencia moral de tratar a una conciencia como mera cosa disponible.</field_relacion_con_los_derechos_minimos>
    <hasDefinition xml:lang="es">Condicion por la cual una conciencia no puede ser reducida legitimamente a simple instrumento, recurso o objeto administrable, porque constituye un foco real de experiencia, vulnerabilidad y posible apertura.</hasDefinition>
    <hasName xml:lang="es">Dignidad</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.justicia.dignidad</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dignidad</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#dimension_tragica">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
