    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales[15]</hasSourcePath>
    <hasText xml:lang="es">Toda practica espiritual, politica o intelectual debe juzgarse tambien por sus efectos exergicos reales y por su riesgo de captura.</hasText>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">axiomas_provisionales</jsonKey>
