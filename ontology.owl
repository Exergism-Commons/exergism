    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#realidad"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#ser_humano"/>
    <field_definicion xml:lang="es">Base primaria de la experiencia afectiva por la cual un ser consciente registra valor, amenaza, atraccion, rechazo, perdida, vinculacion o apertura en su relacion con la realidad.</field_definicion>
    <field_funcion xml:lang="es">Hace posible la emergencia de emociones como modulaciones de la experiencia vivida, orientando la atencion, la memoria, la valoracion y la respuesta.</field_funcion>
    <field_relacion_con_el_ser_humano xml:lang="es">En el ser humano esta sensibilidad adquiere especial complejidad simbolica, reflexiva y moral, pero no se reduce exclusivamente a la experiencia humana.</field_relacion_con_el_ser_humano>
    <hasDefinition xml:lang="es">Base primaria de la experiencia afectiva por la cual un ser consciente registra valor, amenaza, atraccion, rechazo, perdida, vinculacion o apertura en su relacion con la realidad.</hasDefinition>
    <hasName xml:lang="es">Sensibilidad</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antropologia_filosofica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antropologia_filosofica.procesos_basales_conscientes.sensibilidad</hasSourcePath>
