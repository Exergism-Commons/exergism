    <partOf rdf:resource="https://id.exergism.org/exergism#liberacion"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#liberacion"/>
    <field_definicion xml:lang="es">Crear cosas abstractas o fisicas que, al ser divulgadas, desbloqueen capas de verdad para otras personas.</field_definicion>
    <hasDefinition xml:lang="es">Crear cosas abstractas o fisicas que, al ser divulgadas, desbloqueen capas de verdad para otras personas.</hasDefinition>
    <hasName xml:lang="es">Rol de la creacion</hasName>
