    <rdfs:label xml:lang="es">Distincion clave</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#teoria_de_la_exergia"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#integracion_con_el_cambio"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#autonomia"/>
    <field_cambio_con_exergia xml:lang="es">Transformacion que conserva o produce margen efectivo para nuevas formas de organizacion, verdad y liberacion.</field_cambio_con_exergia>
    <field_cambio_sin_exergia xml:lang="es">Movimiento, crisis o alteracion que no abre capacidad real de reorganizacion, conciencia o autonomia.</field_cambio_sin_exergia>
    <hasName xml:lang="es">Distincion clave</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teoria_de_la_exergia.integraciones_sistemicas.integracion_con_el_cambio.distincion_clave</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">distincion_clave</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#teoria_de_la_exergia_integraciones_sistemicas_integracion_con_el_cambio_ejemplos">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Section"/>
