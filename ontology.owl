    <relatedTo rdf:resource="https://id.exergism.org/exergism#vida"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#ser_humano"/>
    <field_libertad_biologica xml:lang="es">Capacidad temporal de los seres vivos para sostener su organizacion, actuar y adaptarse dentro de un medio cambiante.</field_libertad_biologica>
    <field_libertad_consciente xml:lang="es">Capacidad de un sistema consciente para no quedar totalmente fijado por su estructura inmediata y generar respuestas, interpretaciones y trayectorias nuevas.</field_libertad_consciente>
    <field_libertad_fisica xml:lang="es">Apertura basal del universo a transformacion, variacion y despliegue de estados posibles.</field_libertad_fisica>
    <field_libertad_humana xml:lang="es">Capacidad de un ser humano o de una sociedad para reducir servidumbre, superar estructuras opresivas y vivir segun reglas asumidas con inteligencia y no solo impuestas desde fuera.</field_libertad_humana>
    <hasName xml:lang="es">Dimensiones</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia.estructura_de_lo_real.realidad_manifestada.libertad.dimensiones</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dimensiones</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#psicologia_moral_reacciones_basicas">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Section"/>
