    <hasPart rdf:resource="https://id.exergism.org/exergism#filosofia_politica_modelo_de_sociedad_liberada_dinamica_interna_mecanismos_collection"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#modelo_de_sociedad_liberada"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#modelo_de_sociedad_liberada"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#vida"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#exergia"/>
    <field_definicion xml:lang="es">Una sociedad liberada no es un estado inmovil, sino una forma de vida colectiva de alta exergia social, capaz de revisarse, corregirse y transformarse sin recaer facilmente en opacidad y concentracion.</field_definicion>
    <hasDefinition xml:lang="es">Una sociedad liberada no es un estado inmovil, sino una forma de vida colectiva de alta exergia social, capaz de revisarse, corregirse y transformarse sin recaer facilmente en opacidad y concentracion.</hasDefinition>
    <hasName xml:lang="es">Dinamica interna</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filosofia_politica.json</hasSourceFile>
