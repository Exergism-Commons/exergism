  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#entropia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Entropia</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#ontologia"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#realidad_manifestada"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#ontologia"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#realidad_manifestada"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#realidad_manifestada"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#materia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#tiempo"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#universo"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#cambio"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#vida"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#exergia"/>
    <field_definicion xml:lang="es">Tendencia fisica de los sistemas materiales a la dispersion de energia util, a la degradacion de configuraciones localmente ordenadas y al aumento de estados posibles accesibles.</field_definicion>
    <field_estado_ontologico xml:lang="es">condicion termodinamica y cosmologica de la realidad manifestada, inseparable del tiempo y del cambio</field_estado_ontologico>
    <field_relacion_con_el_cambio xml:lang="es">El cambio material aparece en un universo entropico donde ninguna configuracion compleja permanece inmovil indefinidamente.</field_relacion_con_el_cambio>
    <field_relacion_con_el_tiempo xml:lang="es">La entropia da al tiempo una direccion fisica observable en el universo conocido, haciendo temporales y finitas las estructuras organizadas.</field_relacion_con_el_tiempo>
    <field_relacion_con_la_exergia xml:lang="es">La exergia nombra la fraccion de capacidad transformadora util disponible en sistemas finitos; la entropia expresa su degradacion o perdida progresiva.</field_relacion_con_la_exergia>
    <field_relacion_con_la_vida xml:lang="es">La vida solo puede sostener orden local durante un tiempo porque intercambia materia y energia con un entorno mas amplio en el que aumenta la entropia exterior.</field_relacion_con_la_vida>
    <hasDefinition xml:lang="es">Tendencia fisica de los sistemas materiales a la dispersion de energia util, a la degradacion de configuraciones localmente ordenadas y al aumento de estados posibles accesibles.</hasDefinition>
    <hasName xml:lang="es">Entropia</hasName>
    <hasOntologicalStatus xml:lang="es">condicion termodinamica y cosmologica de la realidad manifestada, inseparable del tiempo y del cambio</hasOntologicalStatus>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia.estructura_de_lo_real.realidad_manifestada.entropia</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entropia</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#epistemologia_discernimiento_de_orientacion_hacia_la_verdad_relacion_con_la_verdad_absoluta">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Relacion con la verdad absoluta</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#epistemologia"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#discernimiento_de_orientacion_hacia_la_verdad"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#epistemologia"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#discernimiento_de_orientacion_hacia_la_verdad"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#discernimiento_de_orientacion_hacia_la_verdad"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#verdad_absoluta"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <field_definicion xml:lang="es">La verdad absoluta es la verdad de todas las verdades y el supramedio envolvente de todos los medios envolventes y de todas las subverdades contenidas en ellos.</field_definicion>
    <field_limite xml:lang="es">Al ser infinita, la verdad absoluta no puede alcanzarse plenamente por ninguna conciencia finita.</field_limite>
    <field_nota_formal xml:lang="es">Puede pensarse de manera analogica como horizonte de totalidad que contiene todos los niveles parciales de verdad sin agotarse en ninguno de ellos.</field_nota_formal>
    <hasDefinition xml:lang="es">La verdad absoluta es la verdad de todas las verdades y el supramedio envolvente de todos los medios envolventes y de todas las subverdades contenidas en ellos.</hasDefinition>
    <hasName xml:lang="es">Relacion con la verdad absoluta</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">epistemologia.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">epistemologia.discernimiento_de_orientacion_hacia_la_verdad.relacion_con_la_verdad_absoluta</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relacion_con_la_verdad_absoluta</jsonKey>
  </owl:NamedIndividual>

