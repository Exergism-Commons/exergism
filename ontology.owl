    <relatedTo rdf:resource="https://id.exergism.org/exergism#exergia"/>
    <field_principio_general xml:lang="es">El metodo filosofico no sustituye los dominios especializados del conocimiento humano, pero puede dialogar con todos ellos, integrarlos criticamente, examinar sus limites y evaluar su orientacion epistemica, moral, historica y exergica.</field_principio_general>
    <hasName xml:lang="es">Relacion con los dominios del conocimiento humano</hasName>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metodo_filosofico.json</hasSourceFile>
