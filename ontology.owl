  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#supervivencia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
    <rdfs:label xml:lang="es">Supervivencia</rdfs:label>
    <appearsIn rdf:resource="https://id.exergism.org/exergism#antropologia_filosofica"/>
    <belongsToConcept rdf:resource="https://id.exergism.org/exergism#ser_humano"/>
    <belongsToDomain rdf:resource="https://id.exergism.org/exergism#antropologia_filosofica"/>
    <partOf rdf:resource="https://id.exergism.org/exergism#ser_humano"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#ser_humano"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#conciencia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#vida"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#materia"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#universo"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#impulso"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#imaginacion"/>
    <relatedTo rdf:resource="https://id.exergism.org/exergism#autonomia"/>
    <field_definicion xml:lang="es">Orientacion basal de un ser o una conciencia a conservar su integridad funcional, evitar la destruccion inmediata y sostener las condiciones minimas de continuidad vital o historica.</field_definicion>
    <field_estado_ontologico xml:lang="es">funcion basal de conservacion y continuidad relativa, no fin ultimo del sistema</field_estado_ontologico>
    <field_limite xml:lang="es">Cuando se absolutiza, la supervivencia subordina verdad, autonomia y apertura a la mera conservacion, y puede volverse soporte de dominio, miedo o repeticion.</field_limite>
    <field_relacion_con_el_impulso xml:lang="es">En su nivel mas basal, la supervivencia se expresa como impulso de conservacion, evitacion del daño y busqueda de condiciones minimas de continuidad.</field_relacion_con_el_impulso>
    <field_relacion_con_la_imaginacion xml:lang="es">En formas complejas, la imaginacion amplifica la supervivencia al permitir anticipacion, estrategia, innovacion y proyecto historico, no solo reaccion inmediata.</field_relacion_con_la_imaginacion>
    <field_relacion_con_la_vida xml:lang="es">La supervivencia protege la persistencia inmediata de formas vivas y conscientes dentro de un universo material finito, pero no agota por si misma el sentido de la vida.</field_relacion_con_la_vida>
    <hasDefinition xml:lang="es">Orientacion basal de un ser o una conciencia a conservar su integridad funcional, evitar la destruccion inmediata y sostener las condiciones minimas de continuidad vital o historica.</hasDefinition>
    <hasName xml:lang="es">Supervivencia</hasName>
    <hasOntologicalStatus xml:lang="es">funcion basal de conservacion y continuidad relativa, no fin ultimo del sistema</hasOntologicalStatus>
    <hasSourceFile rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antropologia_filosofica.json</hasSourceFile>
    <hasSourcePath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antropologia_filosofica.supervivencia</hasSourcePath>
    <jsonKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">supervivencia</jsonKey>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://id.exergism.org/exergism#tecnologia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://id.exergism.org/exergism#Concept"/>
