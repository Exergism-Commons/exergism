    "fields": [
      {
        "key": "tesis_central",
        "label": "Tesis central",
        "role": "thesis",
        "value_type": "text",
        "value": "La psicologia moral estudia como las reacciones instintivas, las emociones, las interpretaciones y los mecanismos de autojustificacion configuran la percepcion humana del bien y del mal, y como esas dinamicas pueden tanto reproducir como interrumpir ciclos de daño, dominacion y sufrimiento.",
        "source_path": "psicologia_moral.tesis_central"
      }
    ],
    "collections": [],
    "children": [
      {
        "id": "psicologia_moral_reacciones_basicas",
        "key": "reacciones_basicas",
        "label": "Reacciones basicas",
        "kind": "section",
        "source_path": "psicologia_moral.reacciones_basicas",
        "fields": [
          {
            "key": "definicion",
            "label": "Definicion",
            "role": "core",
            "value_type": "text",
            "value": "Respuestas primarias e instintivas ante acciones, situaciones o sujetos percibidos como afirmadores o amenazantes para la vida, la cooperacion, la integridad o la apertura.",
            "source_path": "psicologia_moral.reacciones_basicas.definicion"
          },
          {
            "key": "positivas",
            "label": "Positivas",
            "role": "attribute",
            "value_type": "text",
            "value": "Respuesta instintiva a acciones percibidas como afirmadoras de vida, cooperacion, cuidado o apertura.",
            "source_path": "psicologia_moral.reacciones_basicas.positivas"
          },
          {
            "key": "negativas",
            "label": "Negativas",
            "role": "attribute",
            "value_type": "text",
            "value": "Respuesta instintiva a acciones percibidas como dañinas, opresivas, degradantes o amenazantes.",
            "source_path": "psicologia_moral.reacciones_basicas.negativas"
          },
          {
            "key": "limite",
            "label": "Limite",
            "role": "attribute",
            "value_type": "text",
            "value": "Las reacciones basicas pueden señalar un nucleo moral inicial, pero no bastan por si solas para producir juicio verdadero, justicia ni ruptura del ciclo.",
            "source_path": "psicologia_moral.reacciones_basicas.limite"
          }
        ],
        "collections": [
          {
            "id": "psicologia_moral_reacciones_basicas_componentes_collection",
