              }
            ]
          }
        ],
        "children": [],
        "canonical_id": "psicologia_moral_reacciones_basicas"
      },
      {
        "id": "psicologia_moral_emociones_morales",
        "key": "emociones_morales",
        "label": "Emociones morales",
        "kind": "concept",
        "source_path": "psicologia_moral.emociones_morales",
        "fields": [
          {
            "key": "definicion",
            "label": "Definicion",
            "role": "core",
            "value_type": "text",
            "value": "Respuestas afectivas de la conciencia ante daño, valor, amenaza, injusticia, vinculacion o apertura, fundamentales para la orientacion practica y moral, pero ambiguas si no son integradas por conciencia y criterio.",
            "source_path": "psicologia_moral.emociones_morales.definicion"
          },
          {
            "key": "funcion",
            "label": "Funcion",
            "role": "core",
            "value_type": "text",
            "value": "Pueden alertar sobre daño, revelar valor, activar cuidado o impulsar resistencia, pero tambien pueden alimentar la reproduccion del ciclo si quedan sometidas al miedo, al resentimiento, a la humillacion o al impulso de dominacion.",
            "source_path": "psicologia_moral.emociones_morales.funcion"
          },
          {
            "key": "ambivalencia",
            "label": "Ambivalencia",
            "role": "attribute",
            "value_type": "text",
            "value": "Una misma emocion puede cumplir funcion protectora o degradarse en mecanismo de captura segun su elaboracion, contexto y orientacion.",
            "source_path": "psicologia_moral.emociones_morales.ambivalencia"
          }
        ],
        "collections": [
