      {
        "id": "psicologia_moral_relacion_con_la_etica",
        "key": "relacion_con_la_etica",
        "label": "Relacion con la etica",
        "kind": "concept",
        "source_path": "psicologia_moral.relacion_con_la_etica",
        "fields": [
          {
            "key": "definicion",
            "label": "Definicion",
            "role": "core",
            "value_type": "text",
            "value": "La psicologia moral no determina por si sola que es el bien o el mal, pero explica como los sujetos perciben, deforman, racionalizan o encarnan en la practica esas categorias dentro del dominio humano.",
            "source_path": "psicologia_moral.relacion_con_la_etica.definicion"
          },
          {
            "key": "relacion_con_el_bien",
            "label": "Relacion con el bien",
            "role": "relation",
            "value_type": "text",
            "value": "Ayuda a explicar por que algunas conciencias se orientan hacia apertura, reparacion, verdad y ruptura del ciclo.",
