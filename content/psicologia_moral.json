      {
        "id": "psicologia_moral_heridas_morales",
        "key": "heridas_morales",
        "label": "Heridas morales",
        "kind": "section",
        "source_path": "psicologia_moral.heridas_morales",
        "fields": [
          {
            "key": "definicion",
            "label": "Definicion",
            "role": "core",
            "value_type": "text",
            "value": "Estados afectivos y existenciales que resultan de daño vivido, degradacion sufrida, impotencia acumulada o conflicto moral no resuelto, y que pueden volverse focos de reproduccion del ciclo.",
            "source_path": "psicologia_moral.heridas_morales.definicion"
          }
        ],
        "collections": [],
        "children": [
          {
            "id": "psicologia_moral_heridas_morales_resentimiento",
            "key": "resentimiento",
            "label": "Resentimiento",
            "kind": "concept",
            "source_path": "psicologia_moral.heridas_morales.resentimiento",
            "fields": [
              {
                "key": "definicion",
                "label": "Definicion",
                "role": "core",
                "value_type": "text",
                "value": "Memoria afectiva del daño que, en lugar de abrir a comprension, reparacion o transformacion, busca compensacion imaginaria, inversion simbolica del poder o legitimacion de represalia.",
                "source_path": "psicologia_moral.heridas_morales.resentimiento.definicion"
              }
            ],
            "collections": [],
            "children": [],
            "canonical_id": "resentimiento"
          },
          {
