        "key": "instrumentalizacion",
        "label": "Instrumentalizacion",
        "kind": "concept",
        "source_path": "psicologia_moral.instrumentalizacion",
        "fields": [
          {
            "key": "definicion",
            "label": "Definicion",
            "role": "core",
            "value_type": "text",
            "value": "Proceso psiquico, moral y social por el cual otro ser, sujeto o conciencia deja de ser tratado como centro de experiencia y valor propio, y pasa a ser usado como medio, recurso, obstaculo o soporte funcional para fines ajenos.",
            "source_path": "psicologia_moral.instrumentalizacion.definicion"
          },
          {
            "key": "funcion_opresiva",
            "label": "Funcion opresiva",
            "role": "attribute",
            "value_type": "text",
            "value": "Facilita daño, explotacion, manipulacion y reproduccion del ciclo al debilitar el reconocimiento reciproco y convertir al otro en objeto gestionable.",
            "source_path": "psicologia_moral.instrumentalizacion.funcion_opresiva"
          },
          {
            "key": "tesis_central",
            "label": "Tesis central",
            "role": "thesis",
            "value_type": "text",
            "value": "No hace falta deshumanizar completamente a alguien para dañarlo de forma grave; basta con subordinarlo practicamente a fines ajenos y tratarlo como instrumento.",
            "source_path": "psicologia_moral.instrumentalizacion.tesis_central"
          }
        ],
        "collections": [
          {
            "id": "psicologia_moral_instrumentalizacion_formas_collection",
            "key": "formas",
            "label": "Formas",
            "source_path": "psicologia_moral.instrumentalizacion.formas",
            "item_kind_hint": "collection_item",
            "items": [
              {
                "order_index": 1,
                "value_type": "text",
                "value": "cosificacion"
              },
              {
                "order_index": 2,
                "value_type": "text",
                "value": "deshumanizacion"
              },
              {
                "order_index": 3,
                "value_type": "text",
                "value": "manipulacion simbolica"
              },
              {
                "order_index": 4,
                "value_type": "text",
                "value": "explotacion afectiva"
              },
              {
                "order_index": 5,
                "value_type": "text",
                "value": "subordinacion utilitaria"
              }
            ]
          }
        ],
        "children": [],
        "canonical_id": "instrumentalizacion"
      },
      {
        "id": "psicologia_moral_insensibilizacion_moral",
        "key": "insensibilizacion_moral",
        "label": "Insensibilizacion moral",
        "kind": "concept",
        "source_path": "psicologia_moral.insensibilizacion_moral",
        "fields": [
          {
            "key": "definicion",
            "label": "Definicion",
            "role": "core",
            "value_type": "text",
            "value": "Disminucion progresiva de la reaccion afectiva negativa ante daño repetido, normalizado o institucionalizado.",
            "source_path": "psicologia_moral.insensibilizacion_moral.definicion"
          },
          {
            "key": "efecto",
            "label": "Efecto",
            "role": "attribute",
            "value_type": "text",
            "value": "Convierte sufrimiento ajeno, subordinacion o injusticia en paisaje de fondo tolerable y facilita la continuidad del ciclo sin necesidad de crueldad intensa consciente en cada acto.",
            "source_path": "psicologia_moral.insensibilizacion_moral.efecto"
          }
        ],
        "collections": [],
        "children": [],
        "canonical_id": "insensibilizacion_moral"
      },
      {
        "id": "psicologia_moral_ciclo_del_mal",
        "key": "ciclo_del_mal",
