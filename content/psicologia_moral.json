            "fields": [
              {
                "key": "definicion",
                "label": "Definicion",
                "role": "core",
                "value_type": "text",
                "value": "Experiencia de degradacion del propio valor ante otros que puede producir sumision, odio, deseo de revancha o necesidad obsesiva de restauracion del yo.",
                "source_path": "psicologia_moral.heridas_morales.humillacion.definicion"
              }
            ],
            "collections": [],
            "children": [],
            "canonical_id": "humillacion"
          },
          {
