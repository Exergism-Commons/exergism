                "role": "core",
                "value_type": "text",
                "value": "Miedo ligado a amenaza de daño, castigo, perdida de pertenencia, destruccion del orden conocido o colapso del yo, capaz de estrechar la interpretacion moral y facilitar obediencia o agresion preventiva.",
                "source_path": "psicologia_moral.heridas_morales.miedo_moral.definicion"
              }
