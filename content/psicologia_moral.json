      {
        "id": "psicologia_moral_autojustificacion",
        "key": "autojustificacion",
        "label": "Autojustificacion",
        "kind": "concept",
        "source_path": "psicologia_moral.autojustificacion",
        "fields": [
          {
            "key": "definicion",
            "label": "Definicion",
            "role": "core",
            "value_type": "text",
            "value": "Mecanismo por el cual una conciencia reorganiza sus interpretaciones, recuerdos, valores o narrativas para seguir viendose como legitima mientras participa en daño, dominacion o reproduccion del ciclo.",
            "source_path": "psicologia_moral.autojustificacion.definicion"
          },
          {
            "key": "funcion",
            "label": "Funcion",
            "role": "core",
            "value_type": "text",
            "value": "Reducir disonancia moral, preservar una imagen aceptable de si mismo y permitir cooperacion subjetiva con acciones o estructuras dañinas.",
            "source_path": "psicologia_moral.autojustificacion.funcion"
          }
        ],
        "collections": [
          {
