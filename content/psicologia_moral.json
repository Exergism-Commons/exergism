      {
        "id": "psicologia_moral_interpretacion_moral",
        "key": "interpretacion_moral",
        "label": "Interpretacion moral",
        "kind": "concept",
        "source_path": "psicologia_moral.interpretacion_moral",
        "fields": [
          {
            "key": "definicion",
            "label": "Definicion",
            "role": "core",
            "value_type": "text",
            "value": "Proceso por el cual una conciencia organiza perceptivamente un hecho, le atribuye sentido, identifica agentes, evalua daño, juzga intenciones y decide si corresponde castigo, comprension, contencion, reparacion o transformacion.",
            "source_path": "psicologia_moral.interpretacion_moral.definicion"
          },
          {
            "key": "tesis_central",
            "label": "Tesis central",
            "role": "thesis",
            "value_type": "text",
            "value": "La emocion moral nunca opera sola: siempre esta mediada por una lectura de la situacion que puede acercar a una comprension lucida o degradarse en simplificacion, demonizacion y captura.",
            "source_path": "psicologia_moral.interpretacion_moral.tesis_central"
          }
        ],
        "collections": [
          {
            "id": "psicologia_moral_interpretacion_moral_preguntas_clave_collection",
            "key": "preguntas_clave",
            "label": "Preguntas clave",
            "source_path": "psicologia_moral.interpretacion_moral.preguntas_clave",
            "item_kind_hint": "collection_item",
            "items": [
              {
                "order_index": 1,
                "value_type": "text",
                "value": "quien hizo daño"
              },
              {
                "order_index": 2,
                "value_type": "text",
                "value": "a quien se hizo daño"
              },
              {
                "order_index": 3,
                "value_type": "text",
                "value": "si el daño podia evitarse"
              },
              {
                "order_index": 4,
                "value_type": "text",
                "value": "si hubo lucidez o ignorancia"
              },
              {
                "order_index": 5,
                "value_type": "text",
                "value": "si el hecho es aislado o estructural"
              },
              {
                "order_index": 6,
                "value_type": "text",
                "value": "que respuesta rompe mejor el ciclo"
              }
            ]
          }
        ],
        "children": [
          {
            "id": "psicologia_moral_interpretacion_moral_lectura_lucida",
            "key": "lectura_lucida",
            "label": "Lectura lucida",
            "kind": "concept",
            "source_path": "psicologia_moral.interpretacion_moral.lectura_lucida",
            "fields": [
              {
                "key": "definicion",
                "label": "Definicion",
                "role": "core",
                "value_type": "text",
                "value": "Interpretacion que reconoce daño real, contexto, grados de agencia, posibilidad de reparacion y riesgo de reproduccion del ciclo sin reducir la realidad a una dicotomia simplista entre inocentes puros y culpables absolutos.",
                "source_path": "psicologia_moral.interpretacion_moral.lectura_lucida.definicion"
              }
            ],
            "collections": [],
            "children": [],
            "canonical_id": "lectura_lucida"
          },
          {
            "id": "psicologia_moral_interpretacion_moral_lectura_capturada",
            "key": "lectura_capturada",
            "label": "Lectura capturada",
            "kind": "concept",
            "source_path": "psicologia_moral.interpretacion_moral.lectura_capturada",
            "fields": [
              {
                "key": "definicion",
                "label": "Definicion",
                "role": "core",
                "value_type": "text",
                "value": "Interpretacion estrechada por miedo, odio, interes, humillacion o deseo de dominio que simplifica los hechos, absolutiza al enemigo, manipula el relato y facilita la continuidad del daño.",
                "source_path": "psicologia_moral.interpretacion_moral.lectura_capturada.definicion"
              }
            ],
            "collections": [],
