      {
        "id": "psicologia_moral_respuesta_moral",
        "key": "respuesta_moral",
        "label": "Respuesta moral",
        "kind": "concept",
        "source_path": "psicologia_moral.respuesta_moral",
        "fields": [
          {
            "key": "definicion",
            "label": "Definicion",
            "role": "core",
            "value_type": "text",
            "value": "Modo practico en que una conciencia traduce su reaccion, su emocion y su interpretacion moral en conducta, decision, omision o forma de relacion con otros.",
            "source_path": "psicologia_moral.respuesta_moral.definicion"
          },
          {
            "key": "importancia",
            "label": "Importancia",
            "role": "attribute",
            "value_type": "text",
            "value": "La diferencia decisiva entre reproduccion y ruptura del ciclo no se juega solo en lo que se siente o se piensa, sino en la forma concreta de responder.",
            "source_path": "psicologia_moral.respuesta_moral.importancia"
          }
        ],
