            "kind": "concept",
            "source_path": "psicologia_moral.heridas_morales.verguenza",
            "fields": [
              {
                "key": "definicion",
                "label": "Definicion",
                "role": "core",
                "value_type": "text",
                "value": "Afecto ligado a exposicion, perdida de valor propio o percepcion de fallo moral, capaz tanto de abrir a correccion como de hundir en ocultamiento, servidumbre o agresion defensiva.",
                "source_path": "psicologia_moral.heridas_morales.verguenza.definicion"
              }
            ],
            "collections": [],
            "children": [],
            "canonical_id": "verguenza"
