            "items": [
              {
                "order_index": 1,
                "value_type": "text",
                "value": "veracidad del contenido"
              },
              {
                "order_index": 2,
                "value_type": "text",
                "value": "minimizacion del sufrimiento evitable"
              },
              {
                "order_index": 3,
                "value_type": "text",
                "value": "adecuacion del modo de comunicacion"
              },
              {
                "order_index": 4,
                "value_type": "text",
                "value": "rechazo de la mentira compasiva cuando prolonga ignorancia estructural"
              }
            ]
          }
        ],
        "children": [],
        "canonical_id": "verdad_y_comunicacion"
      },
      {
        "id": "etica_dano_tragico_y_residuo_moral",
