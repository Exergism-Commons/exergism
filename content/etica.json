        "kind": "concept",
        "source_path": "etica.etica_organizativa_exergista",
        "fields": [
          {
            "key": "definicion",
            "label": "Definicion",
            "role": "core",
            "value_type": "text",
            "value": "Una organizacion liberadora debe impedir que los medios excepcionales o duros deriven en captura mediante practicas continuas de formacion, autocorreccion, distribucion del poder y juicio compartido.",
            "source_path": "etica.etica_organizativa_exergista.definicion"
          },
          {
            "key": "tesis_central",
            "label": "Tesis central",
            "role": "thesis",
            "value_type": "text",
            "value": "La preservacion exergica de una organizacion no depende solo de sus fines declarados, sino de su capacidad institucional para revisar, rotar, transparentar, deliberar y corregirse sin perder eficacia estrategica ni convertir el desacuerdo en enemistad automatica.",
            "source_path": "etica.etica_organizativa_exergista.tesis_central"
          }
        ],
