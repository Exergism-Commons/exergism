  "root": {
    "id": "teoria_de_la_historia",
    "canonical_id": "historia",
    "key": "teoria_de_la_historia",
    "label": "Teoria de la historia",
    "kind": "concept",
    "source_path": "teoria_de_la_historia",
    "fields": [
      {
        "key": "tesis_central",
        "label": "Tesis central",
        "role": "thesis",
        "value_type": "text",
        "value": "El ciclo demiurgico acompaña a la humanidad desde mucho antes que se formalizaran las primeras religiones con deidades absolutistas y atraviesa toda su historia.",
        "source_path": "teoria_de_la_historia.tesis_central"
      },
      {
        "key": "motor_historico",
        "label": "Motor historico",
        "role": "attribute",
        "value_type": "text",
        "value": "Reproduccion de estructuras de poder derivadas de la naturaleza animal humana y de la instrumentalizacion del conocimiento.",
        "source_path": "teoria_de_la_historia.motor_historico"
      }
    ],
    "collections": [
      {
        "id": "teoria_de_la_historia_patron_historico_collection",
        "key": "patron_historico",
        "label": "Patron historico",
        "source_path": "teoria_de_la_historia.patron_historico",
        "item_kind_hint": "collection_item",
        "items": [
          {
            "order_index": 1,
            "value_type": "text",
            "value": "aparicion de estructuras de dominacion"
          },
          {
            "order_index": 2,
            "value_type": "text",
            "value": "comprension parcial de mecanismos humanos por minorias"
          },
          {
            "order_index": 3,
            "value_type": "text",
            "value": "uso de esa comprension para control"
          },
          {
            "order_index": 4,
            "value_type": "text",
            "value": "reproduccion de ignorancia y sufrimiento"
          },
          {
            "order_index": 5,
            "value_type": "text",
            "value": "posibilidad parcial de ruptura"
          }
        ]
      }
    ],
    "children": [
      {
        "id": "teoria_de_la_historia_progreso",
        "key": "progreso",
        "label": "Progreso",
        "kind": "concept",
        "source_path": "teoria_de_la_historia.progreso",
        "fields": [
          {
            "key": "definicion",
            "label": "Definicion",
            "role": "core",
            "value_type": "text",
            "value": "Aumento historico de la capacidad humana para comprender la realidad, reducir formas de dominacion y ampliar condiciones de libertad consciente.",
            "source_path": "teoria_de_la_historia.progreso.definicion"
          },
          {
            "key": "limite",
            "label": "Limite",
            "role": "attribute",
            "value_type": "text",
            "value": "No es lineal ni irreversible; puede coexistir con nuevas formas de captura y retroceso.",
            "source_path": "teoria_de_la_historia.progreso.limite"
          },
          {
            "key": "criterio",
            "label": "Criterio",
            "role": "attribute",
            "value_type": "text",
            "value": "Hay progreso cuando se abren posibilidades reales de verdad, autonomia y menor servidumbre.",
            "source_path": "teoria_de_la_historia.progreso.criterio"
          }
        ],
        "collections": [],
        "children": [],
        "canonical_id": "progreso"
      },
      {
        "id": "teoria_de_la_historia_escatologia",
        "key": "escatologia",
        "label": "Escatologia",
        "kind": "concept",
        "source_path": "teoria_de_la_historia.escatologia",
        "fields": [
          {
            "key": "definicion",
            "label": "Definicion",
            "role": "core",
            "value_type": "text",
            "value": "Horizonte historico y cosmologico en el que la humanidad y otras posibles conciencias buscan aumentar su exergia colectiva, reducir divisiones, resistir la captura y abrir una fase superior de desarrollo consciente orientada hacia la verdad absoluta dentro de un universo finito.",
            "source_path": "teoria_de_la_historia.escatologia.definicion"
          },
          {
            "key": "tesis_central",
            "label": "Tesis central",
            "role": "thesis",
            "value_type": "text",
            "value": "La historia no debe pensarse solo como repeticion indefinida del ciclo, sino tambien como posibilidad real de ruptura creciente, ampliacion de conciencia y reorganizacion no demiurgica, aunque todo ello permanezca inscrito en un universo material destinado a agotarse.",
            "source_path": "teoria_de_la_historia.escatologia.tesis_central"
          },
          {
            "key": "limite",
            "label": "Limite",
            "role": "attribute",
            "value_type": "text",
            "value": "Ni siquiera una humanidad cosmica agotaria la verdad absoluta. Toda civilizacion seguiria siendo finita, expuesta a error, captura y recaida.",
            "source_path": "teoria_de_la_historia.escatologia.limite"
          }
        ],
        "collections": [],
        "children": [
          {
            "id": "teoria_de_la_historia_escatologia_primera_etapa",
            "key": "primera_etapa",
            "label": "Primera etapa",
            "kind": "concept",
            "source_path": "teoria_de_la_historia.escatologia.primera_etapa",
            "fields": [
              {
                "key": "nombre",
                "label": "Nombre",
                "role": "core",
                "value_type": "text",
                "value": "liberacion de la humanidad terrestre",
                "source_path": "teoria_de_la_historia.escatologia.primera_etapa.nombre"
              },
              {
                "key": "definicion",
                "label": "Definicion",
                "role": "core",
                "value_type": "text",
                "value": "Proceso por el cual la humanidad reduce estructuras de dominacion, ignorancia organizada, guerra intrahumana y divisiones ficticias que impiden su desarrollo como comunidad historica mas amplia.",
                "source_path": "teoria_de_la_historia.escatologia.primera_etapa.definicion"
              }
            ],
            "collections": [
              {
                "id": "teoria_de_la_historia_escatologia_primera_etapa_criterios_collection",
                "key": "criterios",
                "label": "Criterios",
                "source_path": "teoria_de_la_historia.escatologia.primera_etapa.criterios",
                "item_kind_hint": "collection_item",
                "items": [
                  {
                    "order_index": 1,
                    "value_type": "text",
                    "value": "reduccion de dominacion estructural"
                  },
                  {
                    "order_index": 2,
                    "value_type": "text",
                    "value": "disminucion de guerra intrahumana"
                  },
                  {
                    "order_index": 3,
                    "value_type": "text",
                    "value": "aumento de verdad compartida"
                  },
                  {
                    "order_index": 4,
                    "value_type": "text",
                    "value": "distribucion del conocimiento"
                  },
                  {
                    "order_index": 5,
                    "value_type": "text",
                    "value": "autonomia material suficiente"
                  },
                  {
                    "order_index": 6,
                    "value_type": "text",
                    "value": "capacidad comun de autocorreccion"
                  }
                ]
              }
            ],
            "children": [],
            "canonical_id": "primera_etapa"
          },
          {
            "id": "teoria_de_la_historia_escatologia_segunda_etapa",
            "key": "segunda_etapa",
            "label": "Segunda etapa",
            "kind": "concept",
            "source_path": "teoria_de_la_historia.escatologia.segunda_etapa",
            "fields": [
              {
                "key": "nombre",
                "label": "Nombre",
                "role": "core",
                "value_type": "text",
                "value": "era de la humanidad cosmica",
                "source_path": "teoria_de_la_historia.escatologia.segunda_etapa.nombre"
              },
              {
                "key": "definicion",
                "label": "Definicion",
                "role": "core",
                "value_type": "text",
                "value": "Fase historica en la que la humanidad, habiendo reducido significativamente sus fracturas internas, orienta parte de su exergia colectiva hacia la exploracion cosmica, la ampliacion del conocimiento y la comunicacion con otras posibles inteligencias.",
                "source_path": "teoria_de_la_historia.escatologia.segunda_etapa.definicion"
              }
            ],
            "collections": [],
            "children": [],
            "canonical_id": "segunda_etapa"
          },
          {
            "id": "teoria_de_la_historia_escatologia_encuentro_con_otras_civilizaciones",
            "key": "encuentro_con_otras_civilizaciones",
            "label": "Encuentro con otras civilizaciones",
            "kind": "concept",
            "source_path": "teoria_de_la_historia.escatologia.encuentro_con_otras_civilizaciones",
            "fields": [
              {
                "key": "definicion",
                "label": "Definicion",
                "role": "core",
                "value_type": "text",
                "value": "Si la humanidad encontrara otras inteligencias, ese hecho deberia entenderse como oportunidad de conocimiento reciproco, contraste de modos de conciencia y ampliacion del horizonte de verdad.",
                "source_path": "teoria_de_la_historia.escatologia.encuentro_con_otras_civilizaciones.definicion"
              },
              {
                "key": "riesgo",
                "label": "Riesgo",
                "role": "attribute",
                "value_type": "text",
                "value": "La expansion cosmica podria reproducir el demiurgo en escala superior si la humanidad convierte su apertura historica en conquista, evangelizacion, control o captura de otras formas de vida inteligente.",
                "source_path": "teoria_de_la_historia.escatologia.encuentro_con_otras_civilizaciones.riesgo"
              }
            ],
            "collections": [
              {
                "id": "teoria_de_la_historia_escatologia_encuentro_con_otras_civilizaciones_principios_collection",
                "key": "principios",
                "label": "Principios",
                "source_path": "teoria_de_la_historia.escatologia.encuentro_con_otras_civilizaciones.principios",
                "item_kind_hint": "collection_item",
                "items": [
                  {
                    "order_index": 1,
                    "value_type": "text",
                    "value": "reciprocidad"
                  },
                  {
                    "order_index": 2,
                    "value_type": "text",
                    "value": "prudencia"
                  },
                  {
                    "order_index": 3,
                    "value_type": "text",
                    "value": "no dominacion"
                  },
                  {
                    "order_index": 4,
                    "value_type": "text",
                    "value": "intercambio altruista de conocimiento"
                  },
                  {
                    "order_index": 5,
                    "value_type": "text",
                    "value": "respeto a la autonomia de otras conciencias"
                  },
                  {
                    "order_index": 6,
                    "value_type": "text",
                    "value": "apertura al aprendizaje mutuo"
                  }
                ]
              }
            ],
            "children": [],
            "canonical_id": "encuentro_con_otras_civilizaciones"
          },
          {
            "id": "teoria_de_la_historia_escatologia_guia_intercivilizatoria",
            "key": "guia_intercivilizatoria",
            "label": "Guia intercivilizatoria",
            "kind": "concept",
            "source_path": "teoria_de_la_historia.escatologia.guia_intercivilizatoria",
            "fields": [
              {
                "key": "definicion",
                "label": "Definicion",
                "role": "core",
                "value_type": "text",
                "value": "Solo seria legitimo intentar orientar a otras civilizaciones si ello fuera compatible con su autonomia, si no implicara subordinacion y si pudiera aumentar verdad, libertad y exergia sin captura.",
                "source_path": "teoria_de_la_historia.escatologia.guia_intercivilizatoria.definicion"
              },
              {
                "key": "criterio_de_legitimidad",
                "label": "Criterio de legitimidad",
                "role": "attribute",
                "value_type": "text",
                "value": "Ninguna civilizacion puede presentarse como poseedora total de la verdad absoluta. Toda ayuda o guia debe ofrecerse como cooperacion parcial y revisable.",
                "source_path": "teoria_de_la_historia.escatologia.guia_intercivilizatoria.criterio_de_legitimidad"
              }
            ],
            "collections": [],
            "children": [],
            "canonical_id": "guia_intercivilizatoria"
          },
          {
            "id": "teoria_de_la_historia_escatologia_ruptura_final",
            "key": "ruptura_final",
            "label": "Ruptura final",
            "kind": "concept",
            "source_path": "teoria_de_la_historia.escatologia.ruptura_final",
            "fields": [
              {
                "key": "definicion_general",
                "label": "Definicion general",
                "role": "attribute",
                "value_type": "text",
                "value": "La ruptura final posee dos planos distintos: uno cosmologico y otro historico-consciente.",
                "source_path": "teoria_de_la_historia.escatologia.ruptura_final.definicion_general"
              },
              {
                "key": "tesis_central",
                "label": "Tesis central",
                "role": "thesis",
                "value_type": "text",
                "value": "El fin del universo es compatible con una tarea historica de liberacion. La finitud cosmica no anula el valor de la lucha consciente; al contrario, vuelve mas urgente la orientacion exergica de la vida, la historia y la civilizacion.",
                "source_path": "teoria_de_la_historia.escatologia.ruptura_final.tesis_central"
              },
              {
                "key": "nota",
                "label": "Nota",
                "role": "attribute",
                "value_type": "text",
                "value": "La ruptura final cosmologica no equivale a redencion sobrenatural. La ruptura final historico-consciente no equivale a garantia de exito, sino a tarea abierta dentro de un universo finito.",
                "source_path": "teoria_de_la_historia.escatologia.ruptura_final.nota"
              }
            ],
            "collections": [],
            "children": [
              {
                "id": "teoria_de_la_historia_escatologia_ruptura_final_plano_cosmologico",
                "key": "plano_cosmologico",
                "label": "Plano cosmologico",
                "kind": "concept",
                "source_path": "teoria_de_la_historia.escatologia.ruptura_final.plano_cosmologico",
                "fields": [
                  {
                    "key": "definicion",
                    "label": "Definicion",
                    "role": "core",
                    "value_type": "text",
                    "value": "Nuestro universo material, del cual somos parte, tendra un final natural ligado a su propia dinamica fisica. Si la tendencia entropica domina a escala total, la historia cosmologica desembocara en una fase de agotamiento estructural, disipacion extrema y muerte termica.",
                    "source_path": "teoria_de_la_historia.escatologia.ruptura_final.plano_cosmologico.definicion"
                  },
                  {
                    "key": "caracter",
                    "label": "Caracter",
                    "role": "attribute",
                    "value_type": "text",
                    "value": "natural y practicamente inevitable dentro del universo conocido",
                    "source_path": "teoria_de_la_historia.escatologia.ruptura_final.plano_cosmologico.caracter"
                  },
                  {
                    "key": "relacion_con_la_exergia",
                    "label": "Relacion con la exergia",
                    "role": "relation",
                    "value_type": "text",
                    "value": "La muerte termica representa el horizonte limite de destruccion de exergia: el punto en que la capacidad de producir transformacion util tiende a extinguirse a escala cosmica.",
                    "source_path": "teoria_de_la_historia.escatologia.ruptura_final.plano_cosmologico.relacion_con_la_exergia",
                    "target_hints": [
                      "exergia"
                    ],
                    "target_ids": [
                      "exergia"
                    ]
                  }
                ],
                "collections": [],
                "children": [],
                "canonical_id": "plano_cosmologico"
              },
              {
                "id": "teoria_de_la_historia_escatologia_ruptura_final_plano_historico_consciente",
                "key": "plano_historico_consciente",
                "label": "Plano historico consciente",
                "kind": "concept",
                "source_path": "teoria_de_la_historia.escatologia.ruptura_final.plano_historico_consciente",
                "fields": [
                  {
                    "key": "definicion",
                    "label": "Definicion",
                    "role": "core",
                    "value_type": "text",
                    "value": "Antes de ese final cosmologico, la historia de los seres conscientes permanece abierta. En ese plano, la ruptura final no debe entenderse como evento sobrenatural garantizado, sino como horizonte regulativo de liberacion creciente en el que la humanidad y otras posibles conciencias reduzcan progresivamente captura, ignorancia, servidumbre y recaida.",
                    "source_path": "teoria_de_la_historia.escatologia.ruptura_final.plano_historico_consciente.definicion"
                  },
                  {
                    "key": "caracter",
                    "label": "Caracter",
                    "role": "attribute",
                    "value_type": "text",
                    "value": "abierto, no garantizado, historico y exergico",
                    "source_path": "teoria_de_la_historia.escatologia.ruptura_final.plano_historico_consciente.caracter"
                  },
                  {
                    "key": "criterio",
                    "label": "Criterio",
                    "role": "attribute",
                    "value_type": "text",
                    "value": "Su medida no es la supervivencia infinita, sino el aumento real de verdad, autonomia, cooperacion no capturada y capacidad de orientacion lucida hacia la verdad absoluta mientras exista margen exergico.",
                    "source_path": "teoria_de_la_historia.escatologia.ruptura_final.plano_historico_consciente.criterio"
                  }
                ],
                "collections": [],
                "children": [],
                "canonical_id": "plano_historico_consciente"
              }
            ],
            "canonical_id": "ruptura_final"
          }
        ],
        "canonical_id": "escatologia"
      }
    ],
    "aliases": [
      "teoria_de_la_historia"
    ]
  }
}
