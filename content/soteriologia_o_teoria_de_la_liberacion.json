          {
            "key": "definicion",
            "label": "Definicion",
            "role": "core",
            "value_type": "text",
            "value": "El encuentro con otras formas de inteligencia deberia orientarse a conocimiento reciproco, cooperacion libre y ampliacion comun de comprension, no a conquista, absorcion o imposicion doctrinal.",
