          {
            "key": "definicion",
            "label": "Definicion",
            "role": "core",
            "value_type": "text",
            "value": "Una sociedad puede trascender si profundiza en conocimiento verdadero de la naturaleza humana y de sus estructuras, aumenta su exergia colectiva y reduce las formas de captura que impiden una orientacion historica compartida hacia la verdad.",
            "source_path": "soteriologia_o_teoria_de_la_liberacion.rol_de_la_sociedad.definicion"
          },
          {
            "key": "horizonte_ampliado",
            "label": "Horizonte ampliado",
