      {
        "id": "teologia_o_metafisica_religiosa_sacralidad",
        "key": "sacralidad",
        "label": "Sacralidad",
        "kind": "concept",
        "source_path": "teologia_o_metafisica_religiosa.sacralidad",
        "fields": [
          {
            "key": "definicion",
            "label": "Definicion",
            "role": "core",
            "value_type": "text",
            "value": "Lo sagrado no designa un objeto magico o una autoridad intocable, sino aquello que pone a la conciencia ante el misterio de lo real, la gravedad del bien y el mal, y la exigencia de no reducir la verdad a posesion instrumental.",
            "source_path": "teologia_o_metafisica_religiosa.sacralidad.definicion"
          },
          {
            "key": "nota",
            "label": "Nota",
            "role": "attribute",
            "value_type": "text",
            "value": "Puede haber sacralidad sin sobrenaturalismo personalista.",
            "source_path": "teologia_o_metafisica_religiosa.sacralidad.nota"
          }
        ],
        "collections": [],
        "children": [],
        "canonical_id": "sacralidad"
      },
      {
        "id": "teologia_o_metafisica_religiosa_mal_metafisico_y_mal_religioso",
        "key": "mal_metafisico_y_mal_religioso",
        "label": "Mal metafisico y mal religioso",
        "kind": "concept",
        "source_path": "teologia_o_metafisica_religiosa.mal_metafisico_y_mal_religioso",
        "fields": [
          {
            "key": "definicion",
            "label": "Definicion",
            "role": "core",
            "value_type": "text",
            "value": "El mal no es una fuerza cosmica absoluta equiparable a la verdad absoluta. En el dominio religioso humano aparece como captura, falseamiento, idolatria del poder, sacralizacion de la dominacion y desviacion de la exergia hacia el ciclo.",
            "source_path": "teologia_o_metafisica_religiosa.mal_metafisico_y_mal_religioso.definicion"
          },
          {
            "key": "forma_religiosa_del_demiurgo",
            "label": "Forma religiosa del demiurgo",
            "role": "attribute",
            "value_type": "text",
            "value": "Toda religion que absolutiza obediencia, miedo, pureza identitaria o dominio institucional puede convertirse en forma religiosa del demiurgo.",
            "source_path": "teologia_o_metafisica_religiosa.mal_metafisico_y_mal_religioso.forma_religiosa_del_demiurgo"
          }
        ],
        "collections": [],
        "children": [],
        "canonical_id": "mal_metafisico_y_mal_religioso"
      },
      {
        "id": "teologia_o_metafisica_religiosa_escatologia_exergica",
        "key": "escatologia_exergica",
        "label": "Escatologia exergica",
        "kind": "concept",
        "source_path": "teologia_o_metafisica_religiosa.escatologia_exergica",
        "fields": [
          {
            "key": "definicion",
            "label": "Definicion",
            "role": "core",
            "value_type": "text",
            "value": "La escatologia exergica es el horizonte historico y transhistorico en el que la humanidad busca aumentar su exergia colectiva hasta romper formas mayores de captura, superar divisiones ficticias internas y abrir una fase de desarrollo consciente orientada hacia la verdad absoluta.",
            "source_path": "teologia_o_metafisica_religiosa.escatologia_exergica.definicion"
          },
          {
            "key": "tesis_central",
            "label": "Tesis central",
            "role": "thesis",
            "value_type": "text",
            "value": "La liberacion autentica no debe detenerse en individuos aislados ni en comunidades parciales, sino tender a la liberacion progresiva del conjunto de la humanidad como sujeto historico capaz de verdad, autonomia y cooperacion no capturada.",
            "source_path": "teologia_o_metafisica_religiosa.escatologia_exergica.tesis_central"
          },
          {
            "key": "limite_final",
            "label": "Limite final",
            "role": "attribute",
            "value_type": "text",
            "value": "La humanidad cosmica no agotaria la verdad absoluta. Incluso una civilizacion expandida entre estrellas seguiria siendo finita, revisable y expuesta a recaida, captura o error.",
            "source_path": "teologia_o_metafisica_religiosa.escatologia_exergica.limite_final"
          },
          {
            "key": "pregunta_escatologica_central",
            "label": "Pregunta escatologica central",
            "role": "question",
            "value_type": "text",
            "value": "Puede la humanidad aumentar suficiente exergia consciente y colectiva como para dejar de ser una especie atrapada en ciclos locales de dominacion y convertirse en agente cosmico de verdad, libertad y cooperacion no demiurgica.",
            "source_path": "teologia_o_metafisica_religiosa.escatologia_exergica.pregunta_escatologica_central"
          }
        ],
        "collections": [],
        "children": [
          {
            "id": "teologia_o_metafisica_religiosa_escatologia_exergica_primera_fase",
            "key": "primera_fase",
            "label": "Primera fase",
            "kind": "concept",
            "source_path": "teologia_o_metafisica_religiosa.escatologia_exergica.primera_fase",
            "fields": [
              {
                "key": "nombre",
                "label": "Nombre",
                "role": "core",
                "value_type": "text",
                "value": "liberacion de la humanidad terrestre",
                "source_path": "teologia_o_metafisica_religiosa.escatologia_exergica.primera_fase.nombre"
              },
              {
                "key": "definicion",
                "label": "Definicion",
                "role": "core",
                "value_type": "text",
                "value": "Superacion progresiva de divisiones ficticias, estructuras de dominacion, ignorancia organizada y formas historicas de captura que impiden a la humanidad actuar como comunidad consciente mas amplia.",
                "source_path": "teologia_o_metafisica_religiosa.escatologia_exergica.primera_fase.definicion"
              }
            ],
            "collections": [
              {
