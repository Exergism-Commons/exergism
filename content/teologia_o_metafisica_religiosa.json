          {
            "id": "teologia_o_metafisica_religiosa_escatologia_exergica_segunda_fase",
            "key": "segunda_fase",
            "label": "Segunda fase",
            "kind": "concept",
            "source_path": "teologia_o_metafisica_religiosa.escatologia_exergica.segunda_fase",
            "fields": [
              {
                "key": "nombre",
                "label": "Nombre",
                "role": "core",
                "value_type": "text",
                "value": "era de la humanidad cosmica",
                "source_path": "teologia_o_metafisica_religiosa.escatologia_exergica.segunda_fase.nombre"
              },
              {
                "key": "definicion",
                "label": "Definicion",
                "role": "core",
                "value_type": "text",
                "value": "Etapa en la que la humanidad, habiendo reducido significativamente sus divisiones internas ficticias, orienta parte de su exergia historica hacia la exploracion cosmica, la comunicacion interestelar y la ampliacion de su horizonte de verdad mas alla de la Tierra.",
                "source_path": "teologia_o_metafisica_religiosa.escatologia_exergica.segunda_fase.definicion"
              }
            ],
            "collections": [],
            "children": [],
            "canonical_id": "segunda_fase"
          },
          {
            "id": "teologia_o_metafisica_religiosa_escatologia_exergica_encuentro_con_otras_inteligencias",
            "key": "encuentro_con_otras_inteligencias",
            "label": "Encuentro con otras inteligencias",
            "kind": "concept",
            "source_path": "teologia_o_metafisica_religiosa.escatologia_exergica.encuentro_con_otras_inteligencias",
            "fields": [
              {
                "key": "definicion",
                "label": "Definicion",
                "role": "core",
                "value_type": "text",
                "value": "Si la humanidad entrara en contacto con seres inteligentes no terrestres, ese encuentro deberia entenderse como una oportunidad de conocimiento reciproco, ampliacion de conciencia y contraste de formas distintas de acceso parcial a la realidad.",
                "source_path": "teologia_o_metafisica_religiosa.escatologia_exergica.encuentro_con_otras_inteligencias.definicion"
              },
              {
                "key": "riesgo",
                "label": "Riesgo",
                "role": "attribute",
                "value_type": "text",
                "value": "La expansion cosmica podria reproducir el demiurgo en escala superior si la humanidad convierte su desarrollo exergico en voluntad de control, conquista, evangelizacion o captura de otras inteligencias.",
                "source_path": "teologia_o_metafisica_religiosa.escatologia_exergica.encuentro_con_otras_inteligencias.riesgo"
              }
            ],
            "collections": [
