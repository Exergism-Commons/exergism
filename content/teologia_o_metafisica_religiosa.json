          },
          {
            "id": "teologia_o_metafisica_religiosa_escatologia_exergica_guia_intercivilizatoria",
            "key": "guia_intercivilizatoria",
            "label": "Guia intercivilizatoria",
            "kind": "concept",
            "source_path": "teologia_o_metafisica_religiosa.escatologia_exergica.guia_intercivilizatoria",
            "fields": [
              {
                "key": "definicion",
                "label": "Definicion",
                "role": "core",
                "value_type": "text",
                "value": "Solo seria legitimo intentar orientar o ayudar a otras civilizaciones si ello fuera solicitado, compatible con su autonomia, y realmente dirigido a ampliar verdad, libertad y exergia sin imponer dependencia o subordinacion.",
                "source_path": "teologia_o_metafisica_religiosa.escatologia_exergica.guia_intercivilizatoria.definicion"
              },
              {
                "key": "criterio_de_legitimidad",
                "label": "Criterio de legitimidad",
                "role": "attribute",
                "value_type": "text",
                "value": "Ninguna civilizacion tiene derecho a presentarse como poseedora de la verdad absoluta. Toda orientacion debe ser ofrecida como apertura parcial, nunca como dominio sagrado o superioridad ontologica.",
                "source_path": "teologia_o_metafisica_religiosa.escatologia_exergica.guia_intercivilizatoria.criterio_de_legitimidad"
              }
            ],
