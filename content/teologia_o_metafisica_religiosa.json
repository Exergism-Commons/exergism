      {
        "id": "teologia_o_metafisica_religiosa_dios_verdadero",
        "key": "dios_verdadero",
        "label": "Dios verdadero",
        "kind": "concept",
        "source_path": "teologia_o_metafisica_religiosa.dios_verdadero",
        "fields": [
          {
            "key": "definicion",
            "label": "Definicion",
            "role": "core",
            "value_type": "text",
            "value": "Nombre simbolico para la verdad absoluta o para el fundamento ultimo de todo lo real, del cual el universo conocido podria ser una manifestacion parcial.",
            "source_path": "teologia_o_metafisica_religiosa.dios_verdadero.definicion"
          },
          {
            "key": "tipo",
            "label": "Tipo",
            "role": "core",
            "value_type": "text",
            "value": "no personal segun el estado actual del sistema",
            "source_path": "teologia_o_metafisica_religiosa.dios_verdadero.tipo"
          },
          {
            "key": "relacion_con_la_exergia",
            "label": "Relacion con la exergia",
            "role": "relation",
            "value_type": "text",
            "value": "La verdad absoluta no es exergia ni una magnitud operable. La exergia es el margen finito que una conciencia, una estructura o una sociedad posee para orientarse hacia ella y encarnarla parcialmente en la historia.",
            "source_path": "teologia_o_metafisica_religiosa.dios_verdadero.relacion_con_la_exergia",
            "target_hints": [
              "exergia"
            ],
            "target_ids": [
              "exergia"
            ]
          }
        ],
        "collections": [],
        "children": [],
        "canonical_id": "dios_verdadero"
      },
      {
        "id": "teologia_o_metafisica_religiosa_dios_cristiano",
        "key": "dios_cristiano",
        "label": "Dios cristiano",
        "kind": "concept",
        "source_path": "teologia_o_metafisica_religiosa.dios_cristiano",
        "fields": [
          {
            "key": "definicion",
            "label": "Definicion",
            "role": "core",
            "value_type": "text",
            "value": "El dios abramico en gran medida es la ejemplificacion del demiurgo, de los deseos de control humanos. Ningún dios verdadero sería personal, ni tendría crueldad o bondad, eso son dominios humanos.",
            "source_path": "teologia_o_metafisica_religiosa.dios_cristiano.definicion"
          },
          {
            "key": "tipo",
            "label": "Tipo",
            "role": "core",
            "value_type": "text",
            "value": "personal y demiurgico segun el sistema actual",
            "source_path": "teologia_o_metafisica_religiosa.dios_cristiano.tipo"
          },
          {
            "key": "nota_hermeneutica",
            "label": "Nota hermeneutica",
            "role": "attribute",
            "value_type": "text",
            "value": "Las religiones historicas pueden contener intuiciones parciales de verdad, pero tambien mecanismos de captura, miedo, obediencia y sacralizacion del poder.",
            "source_path": "teologia_o_metafisica_religiosa.dios_cristiano.nota_hermeneutica"
          }
        ],
        "collections": [],
        "children": [],
        "canonical_id": "dios_cristiano"
      },
      {
        "id": "teologia_o_metafisica_religiosa_teologia_negativa",
        "key": "teologia_negativa",
        "label": "Teologia negativa",
        "kind": "concept",
        "source_path": "teologia_o_metafisica_religiosa.teologia_negativa",
        "fields": [
          {
            "key": "definicion",
            "label": "Definicion",
            "role": "core",
            "value_type": "text",
            "value": "La verdad absoluta solo puede pensarse de forma limitada, indirecta y apofatica. Todo lenguaje positivo sobre el fundamento ultimo es parcial, simbolico y revisable.",
            "source_path": "teologia_o_metafisica_religiosa.teologia_negativa.definicion"
          },
          {
            "key": "funcion",
            "label": "Funcion",
            "role": "core",
            "value_type": "text",
            "value": "Evitar que el pensamiento religioso convierta la verdad absoluta en idolo conceptual o en proyeccion del ego humano.",
            "source_path": "teologia_o_metafisica_religiosa.teologia_negativa.funcion"
          }
        ],
        "collections": [],
        "children": [],
        "canonical_id": "teologia_negativa"
      },
      {
